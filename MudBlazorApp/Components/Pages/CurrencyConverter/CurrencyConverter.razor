@page "/currency"

@using MudBlazorApp.Components.Pages.CurrencyConverter.DTOs

<MudGrid Style="height:90vh;">
	<MudItem Class="d-flex align-center justify-center mud-width-full" xs="12">
		<MudPaper Class="pa-6 ma-2" Elevation="5" Width="360px">
			<EditForm Model="@State" OnValidSubmit="OnValidSubmit">
				<DataAnnotationsValidator />
				<MudStack Spacing="5">
					<MudStack Row Spacing="2">
						<MudText Typo="Typo.h5" Align="Align.Left">Currency Conversion</MudText>
						<MudIcon Icon="@Icons.Material.Outlined.Info" Color="Color.Primary" @onclick="OnInformationClicked" Class="cursor-pointer" Style="position:relative; top:2px" />
					</MudStack>
					<MudAutocomplete T="CurrencyType" Label="From Currency" @bind-Value="State.FromCurrency" For="(() => State.FromCurrency)"
						SearchFunc="@SearchCurrencyDropDown" ToStringFunc="@(x => x?.iso_code)" Variant="Variant.Text" Placeholder="ISO 4217 currency code or name" HelperText="@(State.FromCurrency?.name)" ResetValueOnEmptyText SelectValueOnTab ShrinkLabel AdornmentColor="Color.Primary" />
					<MudAutocomplete T="CurrencyType" Label="To Currency" @bind-Value="State.ToCurrency" For="(() => State.ToCurrency)"
						SearchFunc="@SearchCurrencyDropDown" ToStringFunc="@(x => x?.iso_code)" Variant="Variant.Text" Placeholder="ISO 4217 currency code or name" HelperText="@(State.ToCurrency?.name)" ResetValueOnEmptyText SelectValueOnTab ShrinkLabel AdornmentColor="Color.Primary" />
					<MudDatePicker Label="Exchange Rate Date" Editable="true" @bind-Date="State.ExchangeRateDate" For="(() => State.ExchangeRateDate)"
						Mask="@(new DateMask("0000-00-00"))" DateFormat="yyyy-MM-dd" Placeholder="Date in format yyyy-mm-dd" Variant="Variant.Text" Disabled="State.AreCurrenciesEqual" MaxDate="@DateTime.Today" AdornmentColor="Color.Primary" />
					<MudNumericField T="decimal?" HideSpinButtons="true" @bind-Value="State.FromAmount" @oninput="OnFromAmountInput" For="(() => State.FromAmount)"
						Label="From Amount" Variant="Variant.Text" Placeholder="Amount to be converted" Min="0" Max="999999999" FullWidth Format="N2" />
					<MudProgressButton Variant="Variant.Filled" ButtonType="ButtonType.Submit" Size="Size.Large" Color="Color.Primary" IsProcessing="@isProcessing">Convert</MudProgressButton>
					@if (State.ToAmount.HasValue)
					{
						<MudDivider />
						<MudText Inline>
							As of @State.ExchangeRateDate?.ToString("MMMM d, yyyy"), converting 
							<MudTooltip Text="Click to copy" Color="Color.Success" Arrow Placement="Placement.Top" Style="font-style: italic; font-weight: normal !important;">
								<MudText Inline Class="cursor-pointer" @onclick="@(x => CopyToClipboard(State.FromAmount))"><b>@State.FromAmount?.ToString("N2")</b></MudText>
							</MudTooltip>
							@Pluralize(State.FromCurrency?.name, State.FromAmount) results in 
							<MudTooltip Text="Click to copy" Color="Color.Success" Arrow Placement="Placement.Top" Style="font-style: italic; font-weight: normal !important;">
								<MudText Inline Class="cursor-pointer" @onclick="@(x => CopyToClipboard(State.ToAmount))"><b>@State.ToAmount?.ToString("N2")</b></MudText>
							</MudTooltip>
							@Pluralize(State.ToCurrency?.name, State.ToAmount)
						</MudText>
					}
				</MudStack>
			</EditForm>
		</MudPaper>
	</MudItem>
</MudGrid>



<MudMessageBox @ref="messageBox" Title="Information" YesText="Close">
	<MessageContent>
		<MudStack>
			<MudText>This component demonstrates fetching currency codes and exchange rates from <MudLink Href="https://frankfurter.dev" Target="_blank">public API</MudLink> and performs currency conversion. There is some caching in place so the exchange rate is never fetched twice and the state of the search form is preserved across this web application.</MudText>
			<MudText>The component can also receive parameters from query string to pre-fill initial form values, e.g.: <MudLink Href="@exampleUri" Target="_blank">@exampleUri</MudLink>.</MudText>
		</MudStack>
	</MessageContent>
</MudMessageBox>
