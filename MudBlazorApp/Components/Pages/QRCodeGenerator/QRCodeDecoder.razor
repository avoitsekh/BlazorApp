@using SkiaSharp

<MudStack Spacing="2">
	<MudFileUpload T="IBrowserFile" @ref="mudFileUpload" @bind-Files="uploadedFile" DragAndDrop="true" MaxFileSize="@maxFileSize" Accept=".jpg,.png,.gif,.webp" OnFilesChanged="OnFilesChanged">
		<SelectedTemplate />
	</MudFileUpload>

	@if (errorMessage != null)
	{
		<MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@errorMessage</MudAlert>
	}
	else if (successMessage != null)
	{
		<MudAlert Severity="Severity.Success" Variant="Variant.Outlined">@successMessage</MudAlert>
	}
	
	@if (inProgress)
	{
		<MudProgressLinear Color="Color.Success" Indeterminate="true" Class="my-3" Rounded />
	}

</MudStack>

@code {

	IBrowserFile? uploadedFile
	{
		get;
		set
		{
			field = value;
			Decode();
		}
	}

	MudFileUpload<IBrowserFile>? mudFileUpload;
	string? errorMessage;
	string? successMessage;
	int maxFileSize = 5 * 1024 * 1024;  // 5 MB
	bool inProgress;

	async void Decode()
	{
		try
		{
			inProgress = true;

			if (uploadedFile != null)
			{
				await mudFileUpload!.ResetValidationAsync();
				errorMessage = successMessage = null;

				using var stream = new MemoryStream();
				await uploadedFile.OpenReadStream(maxAllowedSize: maxFileSize).CopyToAsync(stream);
				stream.Position = 0;
				var bitmap = SKBitmap.Decode(stream);

				if (bitmap != null)
				{
					string content;

					if (SkiaSharp.QrCode.QRCodeDecoder.TryDecode(bitmap, out content))
					{
						successMessage = $"Decoded content: '{content}'";
					}
					else if (SkiaSharp.QrCode.MicroQRCodeDecoder.TryDecode(bitmap, out content))
					{
						successMessage = $"Decoded content: '{content}'";
					}
					else
					{
						errorMessage = $"No QR code was found in '{uploadedFile.Name}'. The built-in decoder targets clean, screen-rendered images.";
					}
				}
				else
				{
					errorMessage = $"Could not process '{uploadedFile.Name}'. The image format is invalid or not supported.";
				}
				StateHasChanged();
			}
		}
		catch (Exception ex)
		{
			errorMessage = ex.GetBaseException().Message;
		}
		finally
		{
			inProgress = false;
			StateHasChanged();
		}
	}

	void OnFilesChanged()
	{
		errorMessage = successMessage = null;
	}
}
