@typeparam T

@* <MudStack Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Row Wrap="Wrap.NoWrap" Class="pl-13 pr-13">
	<MudText Style="font-weight: 500;">@Name</MudText>
	<MudText>@Value</MudText>
</MudStack> *@

<MudField Label="@Name" Underline="false" Margin="Margin.Dense">
	@* @Value *@
	@* @ChildContent.ToString() *@
	@string.Format("{0:" + Format + "}", Value)
</MudField>

@code {

	[Parameter]
	public string? Name { get; set; }

	[Parameter]
	public T? Value { get; set; }

	[Parameter]
	public string? Format { get; set; }

	// [Parameter]
	// public RenderFragment<T>? ChildContent { get; set; }

}
