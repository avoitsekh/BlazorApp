<div style="position: relative;">
	<MudOverlay Visible="true" Absolute="true" />
	<MudChart T="double" ChartType="ChartType.Donut" ChartSeries="@([data])" ChartLabels="@labels" LegendPosition="@legendPosition" ChartOptions="@options" Width="180px" Height="100%" Class="adjust-this-donut-chart pointer-events-none" />
</div>

@code {

	[CascadingParameter]
	PaymentStatistics? Statistics { get; set; }

	[CascadingParameter]
	Breakpoint? CurrentBreakpoint { get; set; }

	[CascadingParameter(Name = "&IsDarkMode")]
	bool IsDarkMode { get; set; }

	string[] labels = ["Principal Paid", "Extra Paid", "Interest Paid", "Remaining Balance"];
	double[] data = [];
	Position legendPosition = Position.Right;

	Breakpoint? _currentBreakpoint = null;


	DonutChartOptions options = new()
	{
		ShowToolTips = false,
		ChartPalette = [Colors.Blue.Default, Colors.Cyan.Default, Colors.Red.Lighten1, Colors.Gray.Lighten2]
	};

	protected override void OnParametersSet()
	{
		var hasChanges = _currentBreakpoint != CurrentBreakpoint;
		if (hasChanges && CurrentBreakpoint != null)
		{
			var isExtraSmallScreen = CurrentBreakpoint == Breakpoint.Xs;
			legendPosition = isExtraSmallScreen ? Position.Bottom : Position.Right;
			_currentBreakpoint = CurrentBreakpoint;
		}

		if (Statistics != null)
		{
			data = [Statistics.PrincipalPaid, Statistics.ExtraPaid, Statistics.InterestPaid, Statistics.RemainingBalance];
		}

		options.ChartPalette[3] = IsDarkMode ? Colors.Gray.Darken3 : Colors.Gray.Lighten2;
	}
}
