<div style="position: relative;">
	<MudOverlay Visible="true" Absolute="true" />
	<MudChart T="double" ChartType="ChartType.Donut" ChartSeries="@([data])" ChartLabels="@labels" LegendPosition="@legendPosition" ChartOptions="@options" Width="180px" Height="100%" Class="adjust-this-donut-chart pointer-events-none" />
</div>

@code {

	[CascadingParameter]
	PaymentStatistics? Statistics { get; set; }

	[CascadingParameter]
	Breakpoint? CurrentBreakpoint { get; set; }

	[CascadingParameter(Name = "isDarkMode")]
	bool isDarkMode { get; set; }

	string[] labels = [];
	double[] data = [];
	Position legendPosition = Position.Right;

	string PrincipalPaidColor => Colors.Blue.Default;
	string ExtraPaidColor => Colors.Cyan.Default;
	string InterestPaidColor => Colors.Red.Lighten1;
	string RemainingBalanceColor => isDarkMode ? Colors.Gray.Darken3 : Colors.Gray.Lighten2;

	DonutChartOptions options = new()
	{
		ShowToolTips = false,
	};

	protected override void OnParametersSet()
	{
		base.OnParametersSet();

		if (CurrentBreakpoint != null)
		{
			bool isExtraSmallScreen = CurrentBreakpoint == Breakpoint.Xs;
			legendPosition = isExtraSmallScreen ? Position.Bottom : Position.Right;
			options.ChartPalette = [PrincipalPaidColor, ExtraPaidColor, InterestPaidColor, RemainingBalanceColor];
		}

		if (Statistics != null)
		{
			labels = ["Principal Paid", "Extra Paid", "Interest Paid", "Remaining Balance"];
			data = [Statistics.PrincipalPaid, Statistics.ExtraPaid, Statistics.InterestPaid, Statistics.RemainingBalance];
		}
	}
}
