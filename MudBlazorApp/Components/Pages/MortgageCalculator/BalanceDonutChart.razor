@implements IBrowserViewportObserver
@implements IAsyncDisposable

@inject IBrowserViewportService BrowserViewportService

<div style="position: relative;">
	<MudOverlay Visible="true" Absolute="true" />
	<MudChart T="double" ChartType="ChartType.Donut" ChartSeries="@([data])" ChartLabels="@labels" LegendPosition="@legendPosition" ChartOptions="@options" Width="180px" Height="100%" Class="adjust-this-donut-chart pointer-events-none" />
</div>

<style>
	.adjust-this-donut-chart .mud-chart-legend-marker {
		padding-left: 10px !important;
		position: relative !important;
		top: 2px !important;
		right: 2px !important;
	}
</style>

@code {

	[Parameter]
	public PaymentStatistics? Statistics { get; set; }

	string[] labels = [];
	double[] data = [];
	Position legendPosition = Position.Right;

	DonutChartOptions options = new()
	{
		// FillOpacity = .75D,
		// ChartPalette = [Colors.Blue.Default, Colors.Cyan.Default, Colors.Red.Accent3, Colors.Gray.Lighten1],
		ChartPalette = [Colors.Blue.Default, Colors.Cyan.Default, Colors.Red.Lighten1, Colors.Gray.Lighten1],
		ShowToolTips = false,
	};

	protected override void OnParametersSet()
	{
		base.OnParametersSet();

		if (Statistics != null)
		{
			labels = ["Principal Paid", "Extra Paid", "Interest Paid", "Remaining Balance"];
			data = [Statistics.PrincipalPaid, Statistics.ExtraPaid, Statistics.InterestPaid, Statistics.RemainingBalance];
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await BrowserViewportService.SubscribeAsync(this, fireImmediately: true);
		}

		await base.OnAfterRenderAsync(firstRender);
	}

	Guid IBrowserViewportObserver.Id => Guid.NewGuid();

	Task IBrowserViewportObserver.NotifyBrowserViewportChangeAsync(BrowserViewportEventArgs browserViewportEventArgs)
	{
		bool isExtraSmallScreen = browserViewportEventArgs.Breakpoint == Breakpoint.Xs;
		legendPosition = isExtraSmallScreen ? Position.Bottom : Position.Right;
		return InvokeAsync(StateHasChanged);
	}

	async ValueTask IAsyncDisposable.DisposeAsync()
	{
		await BrowserViewportService.UnsubscribeAsync(this);
	}
}
