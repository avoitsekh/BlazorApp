<MudDialog>
	<TitleContent>
		<MudText Typo="Typo.h5" Class="pt-3">Extra Payments</MudText>
	</TitleContent>
	<DialogContent>

		<MudTable Items="Details.ExtraPayments" FixedHeader Height="230px" Dense Hover Elevation="0" Breakpoint="Breakpoint.None">
			<HeaderContent>
				<MudTh>Payment From</MudTh>
				<MudTh>Payment To</MudTh>
				<MudTh>Amount</MudTh>
				<MudTh Style="width: 60px" />
			</HeaderContent>
			<RowTemplate>
				<MudTd><MudText>@context.FromPayment</MudText></MudTd>
				<MudTd><MudText>@context.ToPayment</MudText></MudTd>
				<MudTd><MudText>@context.Amount</MudText></MudTd>
				<MudTd Style="text-align: right;">
					<MudIcon Icon="@Icons.Material.Outlined.RemoveCircleOutline" Color="Color.Primary" Class="cursor-pointer" @onclick="@(() => DeleteClicked(context))" Style="position: relative; top: 2px" />
				</MudTd>
			</RowTemplate>
		</MudTable>

		<MudButton Variant="Variant.Text" StartIcon="@(addLumpSumExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Color="Color.Primary" Class="mt-3" OnClick="AddLumpSumClicked">Add Lump Sum</MudButton>

		<MudCollapse Expanded="addLumpSumExpanded">
			<MudForm @ref="form" Style="padding: 20px 20px 5px 20px">
				<MudStack Row>
					<MudNumericField T="int?" HideSpinButtons="true" Immediate @bind-Value="payment.FromPayment" Label="Payment From" Variant="Variant.Text" Min="1" Max="9999" Margin="Margin.Dense" />
					<MudNumericField T="int?" HideSpinButtons="true" Immediate @bind-Value="payment.ToPayment" Label="Payment To" Variant="Variant.Text" Min="1" Max="9999" Margin="Margin.Dense" />
					<MudNumericField T="double" HideSpinButtons="true" Immediate @bind-Value="payment.Amount" Label="Amount" Variant="Variant.Text" Min="1" Max="99999999" Margin="Margin.Dense" />
					<MudIcon Icon="@Icons.Material.Outlined.AddCircleOutline" Color="Color.Primary" Class="cursor-pointer" @onclick="AddClicked" Style="position: relative; top: 20px" />
				</MudStack>
			</MudForm>
		</MudCollapse>

	</DialogContent>
	<DialogActions>
		<MudButton Color="Color.Primary" OnClick="CloseClicked">Close</MudButton>
	</DialogActions>
</MudDialog>



@code {

	[Parameter]
	public MortgageDetails Details { get; set; }

	[CascadingParameter]
	IMudDialogInstance MudDialog { get; set; }

	DateTime MinDate => Details.AdvanceDate.HasValue ? Details.AdvanceDate.Value.AddDays(1) : DateTime.MinValue;

	MudForm form;
	ExtraPayment payment;
	bool addLumpSumExpanded;

	protected async override Task OnInitializedAsync()
	{
		payment = new() { FromPayment = 1, ToPayment = 1 };
	}

	void AddLumpSumClicked()
	{
		addLumpSumExpanded = !addLumpSumExpanded;
	}

	async Task AddClicked()
	{
		await form.ValidateAsync();

		if (form.IsValid)
		{
			Details.ExtraPayments.Add(payment.FromPayment, payment.ToPayment, payment.Amount);
		}
	}

	void DeleteClicked(ExtraPayment payment)
	{
		Details.ExtraPayments.Remove(payment);
		form.ResetValidationAsync();
	}

	void CloseClicked()
	{
		MudDialog.Close();
	}


}
