@inject IJSRuntime JS

<script>

	window.downloadFile = (fileName, contentType, bytes) => {
		const blob = new Blob([bytes], { type: contentType });
		const url = URL.createObjectURL(blob);
		const anchor = document.createElement('a');
		anchor.href = url;
		anchor.download = fileName;
		anchor.click();
		URL.revokeObjectURL(url);
	};

</script>

@code {

	[Parameter]
	public EventCallback<string> OnDownloadSuccess { get; set; }

	[Parameter]
	public EventCallback<(Exception Exception, string Filename)> OnDownloadError { get; set; }

	public async Task Download(string filename, string contentType, byte[] bytes)
	{
		try
		{
			await JS.InvokeVoidAsync("downloadFile", filename, contentType, bytes);
			await OnDownloadSuccess.InvokeAsync(filename);
		}
		catch (Exception ex)
		{
			await OnDownloadError.InvokeAsync((ex, filename));
		}
	}

}
