@page "/mortgage"

@using System.Text

@implements IBrowserViewportObserver
@implements IAsyncDisposable

@inject IBrowserViewportService BrowserViewportService
@inject IDialogService DialogService
@inject ISnackbar Snackbar


<PageTitle>Mortgage Calculator</PageTitle>
<BrowserDownload @ref="browserDownload" OnDownloadError="OnDownloadError" OnDownloadSuccess="OnDownloadSuccess" />

<MudContainer Gutters="false" Class="d-flex justify-center mud-width-full pt-4">
	<MudPaper id="main-container" MaxWidth="1000px" Width="1000px" Class="pa-0" Elevation="0" Style="@($"background:{Colors.Shades.Transparent};")">
		<MudStack id="main-stack">

			<CascadingValue Value="@payments" Name="&Payments">
			<CascadingValue Value="@paymentsNoExtras" Name="&PaymentsNoExtras">
			<CascadingValue Value="@stats">
			<CascadingValue Value="@currentBreakpoint">

			<MudGrid Spacing="3"> <!-- Grid for Mortgage Details and Summary panels -->
				<MudItem xs="12" md="4">
					<Panel Title="Mortgage Details">
						<HeaderContent>
							<MudFileUpload T="IBrowserFile" Accept=".json,.*" OnFilesChanged="OnDetailsLoadClicked">
								<CustomContent>
									<MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" AnchorOrigin="Origin.TopLeft" TransformOrigin="Origin.TopRight">
										<MudMenu Label="Presets" StartIcon="@Icons.Material.Filled.Tune">
											@foreach (var keyValuePair in presets)
											{
												<MudMenuItem Label="@keyValuePair.Key" Icon="@Icons.Material.Outlined.CheckCircle" IconColor="Color.Info" OnClick="@(() => OnPresetChanged(keyValuePair.Key, keyValuePair.Value))" />
											}
										</MudMenu>
										<MudDivider />
										<MudMenuItem Label="Load..." OnClick="@context.OpenFilePickerAsync" Icon="@Icons.Material.Filled.OpenInBrowser" />
										<MudMenuItem Label="Save..." OnClick="OnDetailsSaveClicked" Icon="@Icons.Material.Filled.Save" />
									</MudMenu>
								</CustomContent>
								<SelectedTemplate />
							</MudFileUpload>
						</HeaderContent>
						<MainContent>
							<MudForm @ref="form" Spacing="4">
								<MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Stretch" StretchItems="StretchItems.All">
									<MudGrid Spacing="6">
										<MudItem xs="6" sm="3" md="6">
											<MudNumericField T="double" HideSpinButtons="true" @bind-Value="details.LoanAmount" Label="Loan Amount" Variant="Variant.Text" Min="0" Max="1000000000" FullWidth Format="@(details.LoanAmount % 1D == 0D ? "N0" : "N2")"
											Validation="MortgageDetailsValidation.ValidateLoanAmount" Margin="Margin.Dense" />
										</MudItem>

										<MudItem xs="6" sm="3" md="6">
											<MudNumericField T="double" HideSpinButtons="true" @bind-Value="details.InterestRates.InitialRate" Label="Annual %" Variant="Variant.Text" Min="0" Max="100" FullWidth Format="0.##" Margin="Margin.Dense"
												Adornment="@(details.IsVariableRateMortgage ? Adornment.End : Adornment.None)" AdornmentIcon="@Icons.Material.Filled.Percent" AdornmentColor="@(details.InterestRates.HasAdditionalInterestRates ? Color.Error : Color.Default)" OnAdornmentClick="OpenVariableInterestRatesDialogAsync" />
												@* @Icons.Material.Filled.Menu *@
										</MudItem>

										<MudItem xs="6" sm="3" md="6">
											<MudNumericField T="int" HideSpinButtons="true" @bind-Value="details.AmortizationPeriodInYears" Label="Amortization Period" Variant="Variant.Text" Min="0" Max="100" FullWidth Margin="Margin.Dense" />
										</MudItem>

										<MudItem xs="6" sm="3" md="6">
											<MudDatePicker Label="Advance Date" Editable="true" @bind-Date="AdvanceDateNullable" DateFormat="yyyy-MM-dd" Placeholder="yyyy-mm-dd" Variant="Variant.Text" OpenTo="OpenTo.Month" ShowToolbar="false" MinDate="new DateTime(1900, 01, 01)" Margin="Margin.Dense" />
										</MudItem>

										<MudItem xs="6" sm="3" md="6">
											<MudSelect T="int" Label="Compound Period" @bind-Value="details.CompoundPeriod" Variant="Variant.Text" Margin="Margin.Dense">
												@foreach (var keyValuePair in Constants.CompoundPeriod)
												{
													<MudSelectItem T="int" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
												}
											</MudSelect>
										</MudItem>

										<MudItem xs="6" sm="3" md="6">
											<MudSelect T="int" Label="Payment Frequency" @bind-Value="details.PaymentFrequency" Variant="Variant.Text" Margin="Margin.Dense">
												@foreach (var keyValuePair in Constants.PaymentFrequency)
												{
													<MudSelectItem T="int" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
												}
											</MudSelect>
										</MudItem>

										<MudItem xs="6" sm="3" md="6">
											<MudSelect T="MortgageDetails.InterestAccrualMethods" Label="Interest Accrual Method" @bind-Value="details.InterestAccrualMethod" Variant="Variant.Text" Margin="Margin.Dense">
												@foreach (var keyValuePair in Constants.InterestRateAccrualMethod)
												{
													<MudSelectItem T="MortgageDetails.InterestAccrualMethods" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
												}
											</MudSelect>
										</MudItem>

										<MudItem xs="6" sm="3" md="6">
											<MudSelect T="MortgageDetails.FinancialYears" Label="Financial Year" @bind-Value="details.FinancialYear" Variant="Variant.Text" Margin="Margin.Dense" 
												Disabled="@(details.InterestAccrualMethod != MortgageDetails.InterestAccrualMethods.PerDay)">
												@foreach (var keyValuePair in Constants.FinancialYear)
												{
													<MudSelectItem T="MortgageDetails.FinancialYears" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
												}
											</MudSelect>
										</MudItem>

										<MudItem xs="6" sm="3" md="6">
											<MudSelect T="MortgageDetails.InterestRateTypes" Label="Rate Type" @bind-Value="details.InterestRateType" @bind-Value:after="OnInterestRateTypeChange" Variant="Variant.Text" Margin="Margin.Dense">
												@foreach (var keyValuePair in Constants.InterestRateType)
												{
													<MudSelectItem T="MortgageDetails.InterestRateTypes" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
												}
											</MudSelect>
										</MudItem>

										<MudItem xs="6" sm="3" md="6">
											<MudTextField T="string" Label="Extra Payments" Variant="Variant.Text" Margin="Margin.Dense" ReadOnly Value="@extraPaymentsDescription"
												AdornmentIcon="@Icons.Material.Outlined.AttachMoney" Adornment="Adornment.End" OnAdornmentClick="OpenExtraPaymentsDialogAsync" />
										</MudItem>

									</MudGrid>
								</MudStack>
								<MudButton Variant="Variant.Filled" OnClick="Calculate" Size="Size.Large" Color="Color.Dark">Calculate</MudButton>
							</MudForm>
						</MainContent>
					</Panel>
				</MudItem>

				<MudItem xs="12" md="8">
					<Panel Title="Summary">
						<HeaderContent>
							<MudStack Row Wrap="Wrap.NoWrap" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
								<MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowLeft" Disabled="@(summaryPage == 0)" OnClick="@(() => summaryPage--)" />
								<MudText Typo="Typo.body2">@(summaryPage + 1) / 2</MudText>
								<MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowRight" Disabled="@(summaryPage == 1)" OnClick="@(() => summaryPage++)" />
							</MudStack>
						</HeaderContent>
						<MainContent>
							<MudCarousel Style="@($"min-height: {summaryPageHeight};")" @bind-SelectedIndex="summaryPage" ShowArrows="false" ShowBullets="false" AutoCycle="false" TData="object">
								<MudCarouselItem Transition="Transition.Slide" Class="animation-duration">
									<MudGrid Spacing="0">
										<MudItem xs="6" sm="4">
											<DataField T="double" Label="Payment Amount" Value="@stats.PaymentAmount" Format="N2" />
										</MudItem>
										<MudItem xs="6" sm="4">
											<DataField T="double" Label="Interest Amount" Value="@stats.InterestAmount" Format="N2" />
										</MudItem>
										<MudItem xs="6" sm="4">
											<DataField T="double" Label="Amortization Reduction" Value="@stats.AmortizationOffset" Format="+#'%';-#'%';0'%'" />
										</MudItem>
										<MudItem xs="6" sm="4">
											<DataField T="double" Label="Effective Annual Rate" Value="@stats.EffectiveAnnualRate" Format="0.##'%'" />
										</MudItem>
										<MudItem xs="6" sm="4">
											<DataField T="double" Label="Principal Amount" Value="@stats.PrincipalAmount" Format="N2" />
										</MudItem>
										<MudItem xs="6" sm="4">
											<DataField T="double" Label="Years to pay-off" Value="@stats.YearsToPayOff" />
										</MudItem>
									</MudGrid>
									<BalanceLineChart DebounceInterval="60" />
								</MudCarouselItem>
								<MudCarouselItem Transition="Transition.Slide" Class="animation-duration">
									<MudStack Spacing="8">
										<MudGrid Spacing="0">
											<MudItem xs="6" sm="4" md="3">
												<DataField T="DateTime" Label="Last Payment Date" Value="@stats.LastPaymentDate" Format="yyyy-MM-dd" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="Interest Paid" Value="@stats.InterestPaid" Format="N2" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="Extra Paid" Value="@stats.ExtraPaid" Format="N2" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="Interest Savings" Value="@stats.InterestSavings" Format="N2" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="Number Of Payments" Value="@stats.NumberOfPayments" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="Principal Paid" Value="@stats.PrincipalPaid" Format="N2" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="Total Paid" Value="@stats.TotalPaid" Format="N2" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="Remaining Balance" Value="@stats.RemainingBalance" Format="N2" />
											</MudItem>
										</MudGrid>
										<MudStack Row Spacing="6" Justify="Justify.Center" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
											<div style="width: 45px">
												<MudNumericField FullWidth="false" T="int?" @bind-Value="balanceAtYear" @bind-Value:after="OnSummaryYearChanged" Immediate Label="Year" Variant="Variant.Text" Min="1" Max="@balanceMaxYear" ShrinkLabel />
											</div>
											<div>
												<BalanceDonutChart />
											</div>
										</MudStack>
									</MudStack>
								</MudCarouselItem>
							</MudCarousel>
						</MainContent>
					</Panel>
				</MudItem>
			</MudGrid>

			<Panel Title="Amortization Schedule">
				<HeaderContent>
					<MudStack Row Spacing="0">
						<MudIconButton Icon="@Icons.Material.Filled.ArrowDropUp" Color="Color.Inherit" OnClick="OnScrollToTopClicked" Disabled="@(!payments.HasData())" />
						<MudIconButton Icon="@Icons.Material.Filled.ArrowDropDown" Color="Color.Inherit" OnClick="OnScrollToBottomClicked" Disabled="@(!payments.HasData())" />
						<MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" AnchorOrigin="Origin.TopLeft" TransformOrigin="Origin.TopRight" Disabled="@(!payments.HasData())">
							<MudMenuItem Label="@(paymentsTableExpanded ? "Contract" : "Expand")" OnClick="OnExpandOrContractClicked" Icon="@(paymentsTableExpanded ? Icons.Material.Filled.Compress : Icons.Material.Filled.Expand)" Class="pe-6" />
							<MudDivider />
							<MudMenuItem Label="Download as Excel" OnClick="OnDownloadAsExcelClicked" Icon="@Icons.Custom.FileFormats.FileExcel" Class="pe-6" />
						</MudMenu>
					</MudStack>
				</HeaderContent>
				<MainContent>
					<PaymentsTable @ref="paymentsTable" Expanded="paymentsTableExpanded"></PaymentsTable>
				</MainContent>
			</Panel>

			</CascadingValue>
			</CascadingValue>
			</CascadingValue>
			</CascadingValue>

		</MudStack>
	</MudPaper>

</MudContainer>

<style>
	.animation-duration {
		animation-duration: .3s;
	}

	.mud-swipearea {
		touch-action: pan-y;
	}
</style>
	


@code {

	MudForm? form = null;
	BrowserDownload? browserDownload = null;

	PaymentsTable? paymentsTable;
	PaymentCollection? payments;
	PaymentCollection? paymentsNoExtras;
	MortgageDetails details = new();
	PaymentStatistics stats = new();
	PresetCollection presets = new();

	const int maxUploadFileSize = 4 * 1024;  // 4 KB

	// Workaround for MudDatePicker requiring DateTime? instead of DateTime
	DateTime? AdvanceDateNullable
	{
		get => details.AdvanceDate != DateTime.MinValue ? details.AdvanceDate : null;
		set => details.AdvanceDate = value.HasValue ? value.Value : DateTime.MinValue;
	}

	int summaryPage = 0;
	string summaryPageHeight = "400px";
	int balanceMaxYear = 1;
	int? balanceAtYear = 5;
	bool paymentsTableExpanded = false;
	string extraPaymentsDescription = "None";

	async Task Calculate()
	{
		await form!.ValidateAsync();

		if (form.IsValid)
		{
			paymentsTableExpanded = false;
			payments = PaymentCollection.Create(details);
			paymentsNoExtras = payments.HasExtraPayments ? PaymentCollection.Create(details, countExtraPayments: false) : null;

			balanceMaxYear = payments?.Max(x => x.Year) ?? 1;
			if (!balanceAtYear.HasValue)
			{
				balanceAtYear = 1;
			}
			else if (balanceAtYear > balanceMaxYear)
			{
				balanceAtYear = balanceMaxYear;
			}

			stats.Payments = payments;
			stats.PaymentsNoExtras = paymentsNoExtras;
			stats.CalculateSummary();
			stats.CalculateForYear(balanceAtYear.Value);
		}
	}

	async Task OnInterestRateTypeChange()
	{
		if (details.InterestRateType == MortgageDetails.InterestRateTypes.Fixed)
		{
			details.InterestRates.Clear();
			StateHasChanged();
		}
	}

	async Task OnDetailsLoadClicked(InputFileChangeEventArgs arg)
	{
		var file = arg.File;

		if (file != null)
		{
			try
			{
				if (file.Size > maxUploadFileSize)
				{
					throw new Exception($"File exceeds the maximum allowed size of {maxUploadFileSize} bytes.");
				}

				using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: maxUploadFileSize));
				string jsonText = await reader.ReadToEndAsync();
				details = MortgageDetails.FromJsonString(jsonText);
				Snackbar.Add($"Successfully loaded from '{file.Name}'", Severity.Success);
				SetExtraPaymentsFieldDescription();

				await Calculate();
			}
			catch (Exception ex)
			{
				Snackbar.Add($"Error loading from '{file.Name}'. {ex.GetBaseException().Message}", Severity.Error);
			}
		}
	}

	async Task OnDetailsSaveClicked()
	{
		var filename = Constants.MortgageDetailsSettingsFilename;

		try
		{
			var jsonText = MortgageDetails.ToJsonString(details);
			await browserDownload!.Download(filename, "text/json", Encoding.UTF8.GetBytes(jsonText));
		}
		catch (Exception ex)
		{
			await OnDownloadError((ex, filename));
		}
	}

	async Task OnDownloadAsExcelClicked()
	{
		var filename = Constants.AmortizationScheduleExcelFilename;

		try
		{
			var bytes = ExportToExcel.GetByteArray(payments);
			await browserDownload!.Download(filename, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", bytes);
		}
		catch (Exception ex)
		{
			await OnDownloadError((ex, filename));
		}
	}

	async Task OnDownloadSuccess(string filename)
	{
		Snackbar.Add($"Saved to '{filename}'", Severity.Info);
	}

	async Task OnDownloadError((Exception Exception, string Filename) args)
	{
		Snackbar.Add($"Error saving to '{args.Filename}'. {args.Exception.GetBaseException().Message}", Severity.Error);
	}

	async Task OnExpandOrContractClicked()
	{
		paymentsTableExpanded = !paymentsTableExpanded;
	}

	async Task OnScrollToBottomClicked()
	{
		paymentsTable?.ScrollToBottom();
	}

	async Task OnScrollToTopClicked()
	{
		paymentsTable?.ScrollToTop();
	}

	async Task OpenVariableInterestRatesDialogAsync()
	{
		var options = new DialogOptions()
		{
			MaxWidth = MaxWidth.ExtraSmall,
			BackdropClick = false,
			CloseOnEscapeKey = true
		};

		var parameters = new DialogParameters<VariableInterestRatesDialog>
		{
			{ x => x.Details, details }
		};

		var dialogReference = await DialogService.ShowAsync<VariableInterestRatesDialog>(parameters, options);
		await dialogReference.Result;
		StateHasChanged();
	}

	async Task OpenExtraPaymentsDialogAsync()
	{
		var options = new DialogOptions()
		{
			MaxWidth = MaxWidth.Medium,
			BackdropClick = false,
			CloseOnEscapeKey = true
		};

		var parameters = new DialogParameters<ExtraPaymentsDialog>
		{
			{ x => x.Details, details }
		};

		var dialogReference = await DialogService.ShowAsync<ExtraPaymentsDialog>(parameters, options);
		await dialogReference.Result;

		SetExtraPaymentsFieldDescription();
		StateHasChanged();
	}

	void SetExtraPaymentsFieldDescription()
	{
		if (details.ExtraPayments.Count == 0)
		{
			extraPaymentsDescription = "None";
		}
		else
		{
			extraPaymentsDescription = string.Empty;
			extraPaymentsDescription += string.Join(string.Empty, details.ExtraPayments.GetLumpSums().Select(x => x.Amount.ToString("N2") + "; "));
			extraPaymentsDescription += string.Join(string.Empty, details.ExtraPayments.GetRecurring().Select(x => x.Amount.ToString("N2") + "+; "));
		}
	}

	async Task OnPresetChanged(string presetName, Func<MortgageDetails> preset)
	{
		details = preset();
		SetExtraPaymentsFieldDescription();
		Snackbar.Add($"Loaded preset '{presetName}'", Severity.Success);

		await Calculate();
	}

	void OnSummaryYearChanged()
	{
		if (payments.HasData() && balanceAtYear.HasValue)
		{
			stats.CalculateForYear(balanceAtYear.Value);
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await BrowserViewportService.SubscribeAsync(this, fireImmediately: true);
		}

		await base.OnAfterRenderAsync(firstRender);
	}

	Guid IBrowserViewportObserver.Id => Guid.NewGuid();
	Breakpoint? currentBreakpoint;

	Task IBrowserViewportObserver.NotifyBrowserViewportChangeAsync(BrowserViewportEventArgs browserViewportEventArgs)
	{
		currentBreakpoint = browserViewportEventArgs.Breakpoint;
		var isExtraSmallScreen = currentBreakpoint == Breakpoint.Xs;
		summaryPageHeight = isExtraSmallScreen ? "580px" : "400px";
		summaryPageHeight = isExtraSmallScreen ? "580px" : "400px";
		return InvokeAsync(StateHasChanged);
	}

	async ValueTask IAsyncDisposable.DisposeAsync()
	{
		await BrowserViewportService.UnsubscribeAsync(this);
	}

}
