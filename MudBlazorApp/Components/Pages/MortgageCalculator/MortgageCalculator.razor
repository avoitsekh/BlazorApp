@page "/mortgage"

@using System

@inject IDialogService DialogService

@* <MudThemeProvider @ref="themeProvider" /> *@

<PageHeader Title="Mortgage Calculator" />
 
<MudGrid Spacing="0">
	<MudItem xs="12" sm="12" md="3">
		@* <MudPaper Class="pa-6 ma-2" Height="@mortgageInfoHeight"> *@
		<MudPaper Class="pa-6 ma-2">
			<MudForm @ref="form" Spacing="2">
				<MudStack Row Wrap="Wrap.NoWrap" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
					<MudText Typo="Typo.h5">Mortgage Details</MudText>
					<MudFileUpload T="IBrowserFile" FilesChanged="LoadClicked" MaxFileSize="@(5 * 1024 * 1024)" Accept=".json,.*">
							<CustomContent>
								<MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Class="ma-n3">
									<MudMenuItem Label="Save" OnClick="MortgageDetailsSaveToFileClicked" />
									<MudMenuItem Label="Load" OnClick="@context.OpenFilePickerAsync" />
								</MudMenu>
							</CustomContent>
							<SelectedTemplate />
						</MudFileUpload>
				</MudStack>
				<MudNumericField T="double" HideSpinButtons="true" @bind-Value="Details.LoanAmount" Label="Loan Amount" Variant="Variant.Text" Min="0" Max="999999999.99" FullWidth Format="###,###,##0.00"
						Validation="MortgageDetailsValidation.ValidateLoanAmount" Margin="Margin.Dense" />
				<MudNumericField T="double" HideSpinButtons="true" @bind-Value="Details.InterestRates.InitialRate" Label="Annual %" Variant="Variant.Text" Min="0" Max="99" FullWidth Format="0.##" Margin="Margin.Dense"
						 Adornment="@(isVariableRateMortgage ? Adornment.End : Adornment.None)" AdornmentIcon="@Icons.Material.Filled.Menu" AdornmentColor="@(hasAdditionalInterestRates ? Color.Primary : Color.Default)" OnAdornmentClick="OpenAdditionalInterestRatesDialogAsync" />
				<MudNumericField T="int" HideSpinButtons="true" @bind-Value="Details.AmortizationPeriodInYears" Label="Amortization Period" Variant="Variant.Text" Min="0" Max="99" FullWidth Margin="Margin.Dense" />
				<MudDatePicker Label="Advance Date" Editable="true" @bind-Date="Details.AdvanceDate" Mask="@(new DateMask("yyyy-MM-dd"))" DateFormat="yyyy-MM-dd" Placeholder="yyyy-mm-dd" Variant="Variant.Text" AdornmentColor="Color.Primary" Margin="Margin.Dense" />
				<MudSelect T="int" Label="Compound Period" @bind-Value="Details.CompoundPeriod" Variant="Variant.Text" Margin="Margin.Dense" AdornmentColor="Color.Primary">
					@foreach (var keyValuePair in Constants.CompoundPeriod)
					{
						<MudSelectItem T="int" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
					}
				</MudSelect>
				<MudSelect T="int" Label="Payment Frequency" @bind-Value="Details.PaymentFrequency" Variant="Variant.Text" Margin="Margin.Dense" AdornmentColor="Color.Primary">
					@foreach (var keyValuePair in Constants.PaymentFrequency)
					{
						<MudSelectItem T="int" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
					}
				</MudSelect>


				<MudSelect T="MortgageDetails.InterestRateTypes" Label="Rate Type" @bind-Value="Details.InterestRateType" @bind-Value:after="OnInterestRateTypeChange" Variant="Variant.Text" Margin="Margin.Dense" AdornmentColor="Color.Primary">
					@foreach (var keyValuePair in Constants.InterestRateType)
					{
						<MudSelectItem T="MortgageDetails.InterestRateTypes" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
					}
				</MudSelect>

				<MudSelect T="MortgageDetails.InterestRateAccrualMethods" Label="Rate Accrual Method" @bind-Value="Details.InterestRateAccrualMethod" @bind-Value:after="OnInterestRateTypeChange" Variant="Variant.Text" Margin="Margin.Dense" AdornmentColor="Color.Primary">
					@foreach (var keyValuePair in Constants.InterestRateAccrualMethod)
					{
						<MudSelectItem T="MortgageDetails.InterestRateAccrualMethods" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
					}
				</MudSelect>


				<MudProgressButton Variant="Variant.Filled" OnClick="CalculateButtonClick" Size="Size.Large" Color="Color.Primary">Calculate</MudProgressButton>

				


			</MudForm>
		</MudPaper>

	</MudItem>
	
	@if (payments.Count > 0)
	{
		<MudItem xs="12" sm="12" md="8">
				@* <MudPaper Class="pa-6 ma-2" Height="@mortgageInfoHeight"> *@
				<MudPaper Class="pa-6 ma-2">
					<MudStack Row="false" Breakpoint="Breakpoint.None" Spacing="4">
						<MudText Typo="Typo.h5" >Balance Over Time</MudText>
						<BalanceOverTime Payments="payments" />
					</MudStack>
				</MudPaper>
		</MudItem>
	}

</MudGrid>





<style>
	.dense-numeric-field .mud-input-control-input-container .mud-input .mud-input-root {
		padding: 4px !important;
	}
</style>



@if (payments.Count > 0)
{
	<MudGrid Spacing="0">
		<MudItem xs="12">
			<MudPaper Class="pa-6 ma-2">
				<MudStack Row="false" Breakpoint="Breakpoint.None" Spacing="4">
					<MudText Typo="Typo.h5">Statistics</MudText>
					<Statistics Payments="payments" />
				</MudStack>
			</MudPaper>
		</MudItem>

		<MudItem xs="12">
			<MudPaper Class="pa-6 ma-2">
				<MudStack Row="false" Breakpoint="Breakpoint.None" Spacing="4">
					<MudText Typo="Typo.h5">Amortization Schedule</MudText>
					<AmortizationSchedule Payments="payments"></AmortizationSchedule>
				</MudStack>
			</MudPaper>
		</MudItem>
	</MudGrid>
}

@code {

	MudForm form = null!;
	List<Payment> payments = [];
	MortgageDetails Details = new MortgageDetails();

	bool hasAdditionalInterestRates => Details.InterestRates.Count > 0;
	bool isVariableRateMortgage => Details.InterestRateType != MortgageDetails.InterestRateTypes.Fixed;


	async Task CalculateButtonClick()
	{
		await form.ValidateAsync();

		if (form.IsValid)
		{
			payments = Payments.Generate(Details);
		}
	}

	async Task OpenAdditionalInterestRatesDialogAsync()
	{
		var options = new DialogOptions()
		{
			MaxWidth = MaxWidth.ExtraSmall,
			BackdropClick = false,
			CloseOnEscapeKey = true
		};

		var parameters = new DialogParameters<VariableInterestRates>
		{
			{ x => x.Details, Details }
		};

		var dialogReference = await DialogService.ShowAsync<VariableInterestRates>(parameters, options);
		await dialogReference.Result;
		StateHasChanged();
	}

	async Task OnInterestRateTypeChange()
	{
		if (Details.InterestRateType == MortgageDetails.InterestRateTypes.Fixed)
		{
			Details.InterestRates.Clear();
			StateHasChanged();
		}
	}

	void MortgageDetailsSaveToFileClicked()
	{
		Console.WriteLine();
		Console.WriteLine();
		Console.WriteLine();
		Console.WriteLine(Details.ToJsonString());
	}


	async Task LoadClicked(IBrowserFile file)
	{
		Console.WriteLine(file.Name);

		// using var stream = new MemoryStream();
		// await file.OpenReadStream().CopyToAsync(stream);
		// stream.Position = 0;


		var reader = new StreamReader(file.OpenReadStream());
		string text = await reader.ReadToEndAsync();
		Details.FromJsonString(text);
	}

}
