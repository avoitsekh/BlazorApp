@page "/mortgage"

@using System.Diagnostics
@using System.Text

@implements IBrowserViewportObserver
@implements IAsyncDisposable

@inject IBrowserViewportService BrowserViewportService
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ISnackbar Snackbar


<PageTitle>Mortgage Calculator</PageTitle>


<MudContainer Gutters="false" Class="d-flex justify-center mud-width-full pt-4">
	<MudPaper id="main-container" MaxWidth="1000px" Width="1000px" Class="pa-0" Elevation="0" Style="@($"background:{Colors.Shades.Transparent};")">
		<MudStack id="main-stack">

			<MudGrid Spacing="3">
				<MudItem xs="12" sm="4">

					<MudPaper Class="pa-6" Height="100%">

						<MudForm @ref="form" Spacing="4">


							<MudStack Row Wrap="Wrap.NoWrap" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
								<MudText Typo="Typo.h5">Mortgage Details</MudText>
								<MudFileUpload T="IBrowserFile" Accept=".json,.*" OnFilesChanged="FileLoadClicked">
									<CustomContent>
										<MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Class="ma-n3" AnchorOrigin="Origin.TopLeft" TransformOrigin="Origin.TopRight">
											<MudMenu Label="Presets" StartIcon="@Icons.Material.Filled.Tune" IconColor="Color.Primary">
												<MudMenuItem Label="Fixed Rate with Extra Payments" Icon="@Icons.Material.Outlined.CheckCircle" IconColor="Color.Primary" />
												<MudMenuItem Label="Variable Rate with Extra Payments" Icon="@Icons.Material.Outlined.CheckCircle" IconColor="Color.Primary" />
											</MudMenu>
											<MudDivider />
											<MudMenuItem Label="Load" OnClick="@context.OpenFilePickerAsync" Icon="@Icons.Material.Filled.OpenInBrowser" IconColor="Color.Primary" />
											<MudMenuItem Label="Save" OnClick="FileSaveClicked" Icon="@Icons.Material.Filled.Save" IconColor="Color.Primary" />
										</MudMenu>
									</CustomContent>
									<SelectedTemplate />
								</MudFileUpload>
							</MudStack>


							<MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Stretch" StretchItems="StretchItems.All">
								<MudGrid Spacing="@adaptiveSpacing">
									<MudItem xs="6" sm="12" md="6">
										<MudNumericField T="double" HideSpinButtons="true" @bind-Value="details.LoanAmount" Label="Loan Amount" Variant="Variant.Text" Min="0" Max="1000000000" FullWidth Format="@(details.LoanAmount % 1D == 0D ? "N0" : "N2")"
										Validation="MortgageDetailsValidation.ValidateLoanAmount" Margin="Margin.Dense" />
									</MudItem>

									<MudItem xs="6" sm="12" md="6">
										<MudNumericField T="double" HideSpinButtons="true" @bind-Value="details.InterestRates.InitialRate" Label="Annual %" Variant="Variant.Text" Min="0" Max="100" FullWidth Format="0.##" Margin="Margin.Dense"
											Adornment="@(isVariableRateMortgage ? Adornment.End : Adornment.None)" AdornmentIcon="@Icons.Material.Filled.Percent" AdornmentColor="@(hasAdditionalInterestRates ? Color.Tertiary : Color.Primary)" OnAdornmentClick="OpenVariableInterestRatesDialogAsync" />
											@* @Icons.Material.Filled.Menu *@
									</MudItem>

									<MudItem xs="6" sm="12" md="6">
										<MudNumericField T="int" HideSpinButtons="true" @bind-Value="details.AmortizationPeriodInYears" Label="Amortization Period" Variant="Variant.Text" Min="0" Max="100" FullWidth Margin="Margin.Dense" />
									</MudItem>

									<MudItem xs="6" sm="12" md="6">
										<MudDatePicker Label="Advance Date" Editable="true" @bind-Date="AdvanceDateNullable" DateFormat="yyyy-MM-dd" Placeholder="yyyy-mm-dd" Variant="Variant.Text" OpenTo="OpenTo.Month" ShowToolbar="false"
											AdornmentColor="Color.Primary" Margin="Margin.Dense" />
									</MudItem>

									<MudItem xs="6" sm="12" md="6">
										<MudSelect T="int" Label="Compound Period" @bind-Value="details.CompoundPeriod" Variant="Variant.Text" Margin="Margin.Dense" AdornmentColor="Color.Primary">
											@foreach (var keyValuePair in Constants.CompoundPeriod)
											{
												<MudSelectItem T="int" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
											}
										</MudSelect>
									</MudItem>

									<MudItem xs="6" sm="12" md="6">
										<MudSelect T="int" Label="Payment Frequency" @bind-Value="details.PaymentFrequency" Variant="Variant.Text" Margin="Margin.Dense" AdornmentColor="Color.Primary">
											@foreach (var keyValuePair in Constants.PaymentFrequency)
											{
												<MudSelectItem T="int" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
											}
										</MudSelect>
									</MudItem>

									<MudItem xs="6" sm="12" md="6">
										<MudSelect T="MortgageDetails.InterestRateTypes" Label="Rate Type" @bind-Value="details.InterestRateType" @bind-Value:after="OnInterestRateTypeChange" Variant="Variant.Text" Margin="Margin.Dense" AdornmentColor="Color.Primary">
											@foreach (var keyValuePair in Constants.InterestRateType)
											{
												<MudSelectItem T="MortgageDetails.InterestRateTypes" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
											}
										</MudSelect>
									</MudItem>

									<MudItem xs="6" sm="12" md="6">
										<MudSelect T="MortgageDetails.InterestAccrualMethods" Label="Interest Accrual Method" @bind-Value="details.InterestAccrualMethod" @bind-Value:after="OnInterestRateTypeChange" Variant="Variant.Text" Margin="Margin.Dense" AdornmentColor="Color.Primary">
											@foreach (var keyValuePair in Constants.InterestRateAccrualMethod)
											{
												<MudSelectItem T="MortgageDetails.InterestAccrualMethods" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
											}
										</MudSelect>
									</MudItem>

								</MudGrid>
							</MudStack>


							<MudStack AlignItems="AlignItems.Center" Spacing="2">
								<MudButton OnClick="OpenExtraPaymentsDialogAsync" Size="Size.Large" Style="width: 200px">Extra Payments</MudButton>
								<MudButton Variant="Variant.Filled" OnClick="CalculateButtonClicked" Size="Size.Large" Color="Color.Primary" Style="width: 200px">Calculate</MudButton>
							</MudStack>

							Execute time: @___ms

						</MudForm>

					</MudPaper>
				</MudItem>

				<MudItem xs="12" sm="8">
					<MudPaper Class="pa-6" Height="100%">
						<MudStack Breakpoint="Breakpoint.None" Spacing="4">

							<MudStack Row Wrap="Wrap.NoWrap" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
								<MudText Typo="Typo.h5">Summary</MudText>
								<MudStack Row Wrap="Wrap.NoWrap" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="ma-n3">
									<MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowLeft" Disabled="@(summaryPage == 0)" OnClick="@(() => summaryPage--)" />
									<MudText Typo="Typo.body2">@(summaryPage + 1) / 2</MudText>
									<MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowRight" Disabled="@(summaryPage == 1)" OnClick="@(() => summaryPage++)" />
								</MudStack>
							</MudStack>

							<MudCarousel Class="mud-width-full" Style="height:400px;" @bind-SelectedIndex="summaryPage" ShowArrows="false" ShowBullets="false" EnableSwipeGesture="false" AutoCycle="false" TData="object">
								<MudCarouselItem Transition="Transition.Slide" Class="anim-duration">
									<MudGrid Spacing="0">
										<MudItem xs="6" sm="4">
											<DataField T="double" Label="Payment Amount" Value="@stats.PaymentAmount" Format="N2" />
										</MudItem>
										<MudItem xs="6" sm="4">
											<DataField T="double" Label="Interest Amount" Value="@stats.InterestAmount" Format="N2" />
										</MudItem>
										<MudItem xs="6" sm="4">
											<DataField T="double" Label="Ammortization Reduction" Value="@stats.AmmortizationOffset" Format="+#'%';-#'%';0'%'" />
										</MudItem>
										<MudItem xs="6" sm="4">
											<DataField T="double" Label="Effective Annual Rate" Value="@stats.EffectiveAnnualRate" Format="0.##'%'" />
										</MudItem>
										<MudItem xs="6" sm="4">
											<DataField T="double" Label="Principal Amount" Value="@stats.PrincipalAmount" Format="N2" />
										</MudItem>
										<MudItem xs="6" sm="4">
											<DataField T="double" Label="Years to pay-off" Value="@stats.YearsToPayOff" />
										</MudItem>
									</MudGrid>
									<BalanceLineChart Payments="payments" PaymentsNoExtras="paymentsNoExtras" />
								</MudCarouselItem>

								<MudCarouselItem Transition="Transition.Slide" Class="anim-duration">
									
									<MudStack Spacing="8">

										<MudGrid Spacing="0">
											<MudItem xs="6" sm="4" md="3">
												<DataField T="DateTime" Label="Last Payment Date" Value="@stats.LastPaymentDate" Format="yyyy-MM-dd" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="Interest Paid" Value="@stats.InterestPaid" Format="N2" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="Extra Paid" Value="@stats.ExtraPaid" Format="N2" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="Interest Savings" Value="@stats.InterestSavings" Format="N2" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="Number Of Payments" Value="@stats.NumberOfPayments" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="Principal Paid" Value="@stats.PrincipalPaid" Format="N2" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="Total Paid" Value="@stats.TotalPaid" Format="N2" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="Remaining Balance" Value="@stats.RemainingBalance" Format="N2" />
											</MudItem>
										</MudGrid>

										<MudStack Row Spacing="6" Justify="Justify.Center" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
											<div style="width: 45px">
												<MudNumericField FullWidth="false" T="int?" @bind-Value="balanceAtYear" @bind-Value:after="OnSummaryYearChanged" Immediate Label="Year" Variant="Variant.Text" Min="1" Max="@balanceMaxYear" />
											</div>
											<div>
												<BalanceDonutChart Statistics="@stats" />
											</div>
										</MudStack>

									</MudStack>

								</MudCarouselItem>
							</MudCarousel>

						</MudStack>
					</MudPaper>
				</MudItem>


			</MudGrid>


			@* <MudPaper Class="pa-6">
				<MudStack Breakpoint="Breakpoint.None" Spacing="4">
					<MudText Typo="Typo.h5">Summary 12345</MudText>
					<Statistics Payments="payments" PaymentsNoExtras="paymentsNoExtras" />
				</MudStack>
			</MudPaper> *@



			<MudPaper Class="pa-6">
				<MudStack Breakpoint="Breakpoint.None" Spacing="4">
					<MudText Typo="Typo.h5">Amortization Schedule</MudText>
					<PaymentsTable Payments="payments"></PaymentsTable>
				</MudStack>
			</MudPaper> 


		</MudStack>
	</MudPaper>

</MudContainer>

<style>
.anim-duration {
	animation-duration: .3s;
}
</style>
	


<script>

	window.downloadFile = (fileName, contentType, bytes) => {
	const blob = new Blob([bytes], { type: contentType });
	const url = URL.createObjectURL(blob);
	const anchor = document.createElement('a');
	anchor.href = url;
	anchor.download = fileName;
	anchor.click();
	URL.revokeObjectURL(url);
	};

</script>

@code {

	MudForm? form;
	PaymentCollection? payments;
	PaymentCollection? paymentsNoExtras;
	MortgageDetails details = new();
	PaymentStatistics stats = new();

	bool hasAdditionalInterestRates => details.InterestRates.Count > 1;
	bool isVariableRateMortgage => details.InterestRateType != MortgageDetails.InterestRateTypes.Fixed;

	const int maxUploadFileSize = 4 * 1024;  // 4 KB

	// Workaround for MudDatePicker
	DateTime? AdvanceDateNullable
	{
		get => details.AdvanceDate != DateTime.MinValue ? details.AdvanceDate : null;
		set => details.AdvanceDate = value.HasValue ? value.Value : DateTime.MinValue;
	}

	int summaryPage = 1;
	int adaptiveSpacing = 6;
	int balanceMaxYear;
	int? balanceAtYear = 5;

	double ___ms = 0;

	async Task CalculateButtonClicked()
	{
		await form.ValidateAsync();

		if (form.IsValid)
		{
			long startTime = Stopwatch.GetTimestamp();

			payments = PaymentCollection.Create(details);
			paymentsNoExtras = payments.HasExtraPayments ? PaymentCollection.Create(details, countExtraPayments: false) : null;

			stats.Payments = payments;
			stats.PaymentsNoExtras = paymentsNoExtras;
			stats.CalculateSummary();
			stats.CalculateForYear(5);
			balanceMaxYear = payments?.Max(x => x.Year) ?? 1;

			TimeSpan elapsedTime = Stopwatch.GetElapsedTime(startTime);
			___ms = elapsedTime.TotalMilliseconds;
		}
	}

	async Task OnInterestRateTypeChange()
	{
		if (details.InterestRateType == MortgageDetails.InterestRateTypes.Fixed)
		{
			details.InterestRates.Clear();
			StateHasChanged();
		}
	}

	async Task FileSaveClicked()
	{
		try
		{
			var jsonText = MortgageDetails.ToJsonString(details);
			await JS.InvokeVoidAsync("downloadFile", "mortgage-details.json", "text/plain", Encoding.UTF8.GetBytes(jsonText));
			Snackbar.Add("Saved to mortgage-details.json", Severity.Info);
		}
		catch (Exception ex)
		{
			Snackbar.Add($"Error saving to mortgage-details.json. {ex.GetBaseException().Message}", Severity.Error);
		}
	}

	async Task FileLoadClicked(InputFileChangeEventArgs arg)
	{
		var file = arg.File;

		if (file != null)
		{
			try
			{
				if (file.Size > maxUploadFileSize)
				{
					throw new Exception($"File exceeds the maximum allowed size of {maxUploadFileSize} bytes.");
				}

				using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: maxUploadFileSize));
				string jsonText = await reader.ReadToEndAsync();
				details = MortgageDetails.FromJsonString(jsonText);
				Snackbar.Add("Successfully loaded from mortgage-details.json", Severity.Success);
			}
			catch (Exception ex)
			{
				Snackbar.Add($"Error loading from {file.Name}. {ex.GetBaseException().Message}", Severity.Error);
			}
		}
	}

	async Task OpenVariableInterestRatesDialogAsync()
	{
		var options = new DialogOptions()
		{
			MaxWidth = MaxWidth.ExtraSmall,
			BackdropClick = false,
			CloseOnEscapeKey = true
		};

		var parameters = new DialogParameters<VariableInterestRatesDialog>
		{
			{ x => x.Details, details }
		};

		var dialogReference = await DialogService.ShowAsync<VariableInterestRatesDialog>(parameters, options);
		await dialogReference.Result;
		StateHasChanged();
	}

	async Task OpenExtraPaymentsDialogAsync()
	{
		var options = new DialogOptions()
		{
			MaxWidth = MaxWidth.Medium,
			BackdropClick = false,
			CloseOnEscapeKey = true
		};

		var parameters = new DialogParameters<ExtraPaymentsDialog>
		{
			{ x => x.Details, details }
		};

		var dialogReference = await DialogService.ShowAsync<ExtraPaymentsDialog>(parameters, options);
		await dialogReference.Result;
		StateHasChanged();
	}

	void OnSummaryYearChanged()
	{
		if (payments.HasData() && balanceAtYear.HasValue)
		{
			stats.CalculateForYear(balanceAtYear.Value);
			if (balanceAtYear > balanceMaxYear)
			{
				balanceAtYear = balanceMaxYear;
			}
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await BrowserViewportService.SubscribeAsync(this, fireImmediately: true);

			CalculateButtonClicked();	// todo remove
		}

		await base.OnAfterRenderAsync(firstRender);
	}

	Guid IBrowserViewportObserver.Id => Guid.NewGuid();

	Task IBrowserViewportObserver.NotifyBrowserViewportChangeAsync(BrowserViewportEventArgs browserViewportEventArgs)
	{
		bool isSmallScreen = browserViewportEventArgs.Breakpoint == Breakpoint.Sm;
		adaptiveSpacing = isSmallScreen ? 3 : 6;
		return InvokeAsync(StateHasChanged);
	}

	async ValueTask IAsyncDisposable.DisposeAsync()
	{
		await BrowserViewportService.UnsubscribeAsync(this);
	}
}
