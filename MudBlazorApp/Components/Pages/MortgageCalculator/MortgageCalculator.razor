@page "/mortgage"

@inject IDialogService DialogService

@* <MudThemeProvider @ref="themeProvider" /> *@

<PageHeader Title="Mortgage Calculator" />
 
<MudGrid Spacing="0">
	<MudItem xs="12" sm="12" md="4">
		@* <MudPaper Class="pa-6 ma-2" Height="@mortgageInfoHeight"> *@
		<MudPaper Class="pa-6 ma-2">
			<MudForm @ref="form" Spacing="2">
				<MudText Typo="Typo.h5">Mortgage Information</MudText>
				<MudNumericField T="double" HideSpinButtons="true" @bind-Value="mortgageSettings.LoanAmount" Label="Loan Amount" Variant="Variant.Text" Min="0" Max="999999999.99" FullWidth Format="###,###,##0.00"
						Validation="mortgageSettings.ValidateLoanAmount" Margin="Margin.Dense"
						Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.AttachMoney" AdornmentColor="Color.Primary" />
				<MudNumericField T="double" HideSpinButtons="true" @bind-Value="mortgageSettings.InterestRates.InitialRate" Label="Annual %" Variant="Variant.Text" Min="0" Max="99" FullWidth Format="0.##" Margin="Margin.Dense"
						Adornment="@(isVariableRateMortgage ? Adornment.End : Adornment.None)" AdornmentIcon="@Icons.Material.Filled.Percent" AdornmentColor="@(hasAdditionalInterestRates ? Color.Primary : Color.Default)" OnAdornmentClick="OpenAdditionalInterestRatesDialogAsync" />
				<MudNumericField T="int" HideSpinButtons="true" @bind-Value="mortgageSettings.AmortizationPeriodInYears" Label="Amortization Period" Variant="Variant.Text" Min="0" Max="99" FullWidth Margin="Margin.Dense" />
				<MudDatePicker Label="Advance Date" Editable="true" @bind-Date="mortgageSettings.AdvanceDate" Mask="@(new DateMask("yyyy-MM-dd"))" DateFormat="yyyy-MM-dd" Placeholder="yyyy-mm-dd" Variant="Variant.Text" AdornmentColor="Color.Primary" Margin="Margin.Dense" />
				<MudSelect T="int" Label="Compound Period" @bind-Value="mortgageSettings.CompoundPeriod" Variant="Variant.Text" Margin="Margin.Dense">
					@foreach (var keyValuePair in Constants.CompoundPeriod)
					{
						<MudSelectItem T="int" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
					}
				</MudSelect>
				<MudSelect T="int" Label="Payment Frequency" @bind-Value="mortgageSettings.PaymentFrequency" Variant="Variant.Text" Margin="Margin.Dense">
					@foreach (var keyValuePair in Constants.PaymentFrequency)
					{
						<MudSelectItem T="int" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
					}
				</MudSelect>


				<MudSelect T="MortgageSettings.InterestRateTypes" Label="Interest Rate Type" @bind-Value="mortgageSettings.InterestRateType" @bind-Value:after="OnInterestRateTypeChange" Variant="Variant.Text" Margin="Margin.Dense">
					@foreach (var keyValuePair in Constants.InterestRateType)
					{
						<MudSelectItem T="MortgageSettings.InterestRateTypes" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
					}
				</MudSelect>


				<MudProgressButton Variant="Variant.Filled" OnClick="CalculateButtonClick" Size="Size.Large" Color="Color.Primary">Calculate</MudProgressButton>

				<MudButton OnClick="OpenAdditionalInterestRatesDialogAsync" Variant="Variant.Filled" Color="Color.Primary">Options dialog</MudButton>



					<MudNumericField Class="dense-numeric-field" HideSpinButtons="true" @bind-Value="IntValue" Variant="Variant.Outlined" />
					<MudNumericField Class="dense-numeric-field" HideSpinButtons="true" @bind-Value="IntValue" Variant="Variant.Text" />
					<MudNumericField Class="dense-numeric-field" HideSpinButtons="true" @bind-Value="IntValue" Variant="Variant.Filled" />


			</MudForm>
		</MudPaper>

	</MudItem>
	
	@if (payments.Count > 0)
	{
		<MudItem xs="12" sm="12" md="8">
				@* <MudPaper Class="pa-6 ma-2" Height="@mortgageInfoHeight"> *@
				<MudPaper Class="pa-6 ma-2">
					<MudStack Row="false" Breakpoint="Breakpoint.None" Spacing="4">
						<MudText Typo="Typo.h6" >Balance Over Time</MudText>
						<BalanceOverTime Payments="payments" />
					</MudStack>
				</MudPaper>
		</MudItem>
	}

</MudGrid>





<style>
	.dense-numeric-field .mud-input-control-input-container .mud-input .mud-input-root {
		padding: 4px !important;
	}
</style>



@if (payments.Count > 0)
{
	<MudGrid Spacing="0">
		<MudItem xs="12">
			<MudPaper Class="pa-6 ma-2">
				<MudStack Row="false" Breakpoint="Breakpoint.None" Spacing="4">
					<MudText Typo="Typo.h6">Statistics</MudText>
					<Statistics Payments="payments" />
				</MudStack>
			</MudPaper>
		</MudItem>

		<MudItem xs="12">
			<MudPaper Class="pa-6 ma-2">
				<MudStack Row="false" Breakpoint="Breakpoint.None" Spacing="4">
					<MudText Typo="Typo.h6">Amortization Schedule</MudText>
					<AmortizationSchedule Payments="payments"></AmortizationSchedule>
				</MudStack>
			</MudPaper>
		</MudItem>
	</MudGrid>
}

@code {

	MudForm form = null!;
	List<Payment> payments = [];
	MortgageSettings mortgageSettings = new MortgageSettings();

	bool hasAdditionalInterestRates => mortgageSettings.InterestRates.Count > 0;
	bool isVariableRateMortgage => mortgageSettings.InterestRateType != MortgageSettings.InterestRateTypes.Fixed;


	public int IntValue { get; set; }
	//string mortgageInfoHeight = "480px";

	async Task CalculateButtonClick()
	{
		await form.ValidateAsync();

		if (form.IsValid)
		{
			payments = Payments.Generate(mortgageSettings);
		}
	}

	async Task OpenAdditionalInterestRatesDialogAsync()
	{
		var options = new DialogOptions()
		{
			MaxWidth = MaxWidth.ExtraSmall,
			BackdropClick = false,
			CloseOnEscapeKey = true
		};

		var parameters = new DialogParameters<AdditionalInterestRates>
		{
			{ x => x.Settings, mortgageSettings }
		};

		var dialogReference = await DialogService.ShowAsync<AdditionalInterestRates>(parameters, options);
		await dialogReference.Result;
		StateHasChanged();
	}

	async Task OnInterestRateTypeChange()
	{
		if (mortgageSettings.InterestRateType == MortgageSettings.InterestRateTypes.Fixed)
		{
			mortgageSettings.InterestRates.Clear();
			StateHasChanged();
		}
	}

}
