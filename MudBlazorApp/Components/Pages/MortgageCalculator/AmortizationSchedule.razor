<MudTable Items="Payments" Striped Dense Hover Bordered Outlined Elevation="0" CellClass="mud-table-small-cell" Virtualize="true" FixedHeader Height="400px">
	<HeaderContent>
		<MudTh>No.</MudTh>
		<MudTh>Payment Date</MudTh>
		<MudTh>Year</MudTh>
		<MudTh>Interest</MudTh>
		<MudTh>Interest Accrual Period</MudTh>
		<MudTh Style="text-align: right;">Interest Amount</MudTh>
		<MudTh Style="text-align: right;">Principal Amount</MudTh>
		<MudTh Style="text-align: right;">Extra Amount</MudTh>
		<MudTh Style="text-align: right;">Payment Amount</MudTh>
		<MudTh Style="text-align: right;">Remaining Balance</MudTh>
	</HeaderContent>
	<RowTemplate>
		<MudTd DataLabel="No.">@context.Number</MudTd>
		<MudTd DataLabel="Payment Date">@context.PaymentDate.ToString("yyyy-MM-dd")</MudTd>
		<MudTd DataLabel="Year">@context.Year</MudTd>
		<MudTd DataLabel="Interest">@context.IterestRate</MudTd>
		<MudTd DataLabel="Interest Accrual Period">@context.InterestAccrualPeriod</MudTd>
		<MudTd DataLabel="Interest Amount" Style="text-align: right;">@context.InterestAmount.ToString("N2")</MudTd>
		<MudTd DataLabel="Principal Amount" Style="text-align: right;">@context.PrincipalAmount.ToString("N2")</MudTd>
		<MudTd DataLabel="Extra Amount" Style="text-align: right;">@context.ExtraAmount.ToString("N2")</MudTd>
		<MudTd DataLabel="Payment Amount" Style="text-align: right;">@context.PaymentAmount.ToString("N2")</MudTd>
		<MudTd DataLabel="Remaining Balance" Style="text-align: right;">@context.Balance.ToString("N2")</MudTd>
	</RowTemplate>
</MudTable>

<style>
	.mud-table-small-cell {
		/* padding: 12px !important; */
		padding: 4px 12px 4px 12px !important
	}
</style>

