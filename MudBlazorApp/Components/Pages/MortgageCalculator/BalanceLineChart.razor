@using MudBlazor.Charts

<div style="position: relative;">
	<MudOverlay Visible="true" Absolute="true" />
	<MudChart id="balance-line-chart" ChartType="ChartType.Line" ChartSeries="@series" ChartLabels="@XAxisLabels" Class="adjust-this-line-chart pointer-events-none"
		ChartOptions="@options" Width="100%" Height="260px" MatchBoundsToSize Style="@adaptivePadding" />
</div>

@code {

	[CascadingParameter(Name = "payments")]
	PaymentCollection? Payments { get; set; }

	[CascadingParameter(Name = "paymentsNoExtras")]
	PaymentCollection? PaymentsNoExtras { get; set; }

	[CascadingParameter]
	Breakpoint? CurrentBreakpoint { get; set; }

	LineChartOptions options = new()
	{
		XAxisTitle = "Balance",
		YAxisTitle = "",
		YAxisFormat = "N0",
		XAxisLabelRotation = 45,
		ChartPalette = [Colors.Blue.Default, Colors.Cyan.Default],
		//ChartPalette = [themeProvider.Theme.PaletteLight.Primary.ToString()],
		ShowLegend = false,
		ShowToolTips = false,
	};

	List<ChartSeries<double>> series = [];
	string[] XAxisLabels = [];
	string adaptivePadding = "padding: 0px 20px 0px 20px;";

	protected override void OnParametersSet()
	{
		base.OnParametersSet();

		if (CurrentBreakpoint != null)
		{
			bool isSmallOrExtraSmallScreen = CurrentBreakpoint == Breakpoint.Sm || CurrentBreakpoint == Breakpoint.Xs;
			adaptivePadding = isSmallOrExtraSmallScreen ? "padding: 20px 0px 0px 0px;" : "padding: 10px 20px 0px 20px;";
		}

		if (Payments.HasData())
		{
			SetGraphValues();
			SetXAxisLabels();
			SetYAxisLabels();
		}
	}

	void SetGraphValues()
	{
		series = new();

		if (PaymentsNoExtras.HasData())
		{
			series.Add(new ChartSeries<double>()
			{
				Name = "Without extra payments",
				Data = PaymentsNoExtras!.Select(x => x.Balance).ToArray(),
				TooltipTitleFormat = "{{SERIES_NAME}}"
			});
		}

		series.Add(new ChartSeries<double>()
		{
			Name = "With extra payments",
			Data = Payments!.Select(x => x.Balance).ToArray(),
			TooltipTitleFormat = "{{SERIES_NAME}}" }
		);

		options.ShowLegend = series.Count > 1;
		options.SeriesDisplayOverrides = new Dictionary<IChartSeries, SeriesDisplayOverride>(series.Count);
		series.ForEach(x => options.SeriesDisplayOverrides.Add(x, new() { LineDisplayType = LineDisplayType.Area, FillOpacity = 0.15 }));
	}

	void SetXAxisLabels()
	{
		var payments = PaymentsNoExtras.HasData() ? PaymentsNoExtras : Payments;
		var amortizationPeriodInYears = payments!.Max(x => x.Year);
		var denominator = amortizationPeriodInYears switch
		{
			<= 5 => 1,
			<= 60 => 5,
			_ => 10
		};
		XAxisLabels = payments!.Select(x => x.Year.HasValue && x.Year % denominator == 0 ? x.PaymentDate.Year.ToString() : string.Empty).ToArray();
	}

	void SetYAxisLabels()
	{
		var loanAmount = Payments.Details.LoanAmount;
		options.YAxisTicks = loanAmount switch
		{
			<= 1000 => 100,
			<= 2000 => 250,
			<= 10000 => 1000,
			<= 50000 => 5000,
			<= 100000 => 10000,
			<= 500000 => 50000,
			<= 1000000 => 100000,
			_ => 250000
		};
	}
}
