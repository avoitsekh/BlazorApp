@using MudBlazor.Charts

@implements IBrowserViewportObserver
@implements IAsyncDisposable

@inject IBrowserViewportService BrowserViewportService

<div style="position: relative;">
	<MudOverlay Visible="true" Absolute="true" />
	<MudChart id="balance-line-chart" ChartType="ChartType.Line" ChartSeries="@series" ChartLabels="@XAxisLabels" Class="change-only-this"
		ChartOptions="@options" Width="100%" Height="260px" MatchBoundsToSize Style="@adaptivePadding" />
</div>

<style>
	.change-only-this .mud-chart-legend {
		height: 8px !important;
		margin-bottom: -10px;
	}

	.change-only-this .mud-chart-legend-item {
		position: relative !important;
		bottom: 26px !important;
	}

	.change-only-this .mud-chart-legend-marker {
		padding-left: 10px !important;
		position: relative !important;
		top: 2px !important;
		right: 2px !important;
	}
</style>

@code {

	[Parameter]
	public PaymentCollection? Payments { get; set; }

	[Parameter]
	public PaymentCollection? PaymentsNoExtras { get; set; }

	LineChartOptions options = new()
	{
		XAxisTitle = "Balance",
		YAxisTitle = "",
		YAxisFormat = "N0",
		XAxisLabelRotation = 45,
		// ChartPalette = [Colors.Blue.Default, Colors.Gray.Lighten1],
		// ChartPalette = [Colors.Blue.Default, Colors.Blue.Accent4],
		ChartPalette = [Colors.Blue.Default, Colors.Cyan.Default],
		//ChartPalette = [themeProvider.Theme.PaletteLight.Primary.ToString()],
		ShowLegend = false,
		ShowToolTips = false,
	};

	List<ChartSeries<double>> series = [];
	string[] XAxisLabels = [];
	string adaptivePadding = "padding: 0px 20px 0px 20px;";

	protected override void OnParametersSet()
	{
		base.OnParametersSet();

		if (Payments.HasData())
		{
			SetGraphValues();
			SetXAxisLabels();
			SetYAxisLabels();
		}
	}

	void SetGraphValues()
	{
		series = new();
		series.Add(new ChartSeries<double>()
		{
			Name = "With extra payments",
			Data = Payments!.Select(x => x.Balance).ToArray(),
			TooltipTitleFormat = "{{SERIES_NAME}}" }
		);

		if (PaymentsNoExtras.HasData())
		{
			series.Add(new ChartSeries<double>()
			{
				Name = "Without extra payments",
				Data = PaymentsNoExtras!.Select(x => x.Balance).ToArray(),
				TooltipTitleFormat = "{{SERIES_NAME}}"
			});
		}

		options.ShowLegend = series.Count > 1;
		options.SeriesDisplayOverrides = new Dictionary<IChartSeries, SeriesDisplayOverride>(series.Count);
		series.ForEach(x => options.SeriesDisplayOverrides.Add(x, new() { LineDisplayType = LineDisplayType.Area, FillOpacity = 0.15 }));
	}

	void SetXAxisLabels()
	{
		var payments = PaymentsNoExtras.HasData() ? PaymentsNoExtras : Payments;
		var amortizationPeriodInYears = payments!.Max(x => x.Year);
		var denominator = amortizationPeriodInYears switch
		{
			<= 5 => 1,
			<= 60 => 5,
			_ => 10
		};
		XAxisLabels = payments!.Select(x => x.Year.HasValue && x.Year % denominator == 0 ? x.PaymentDate.Year.ToString() : string.Empty).ToArray();
	}

	void SetYAxisLabels()
	{
		var loanAmount = Payments.Details.LoanAmount;
		options.YAxisTicks = loanAmount switch
		{
			<= 1000 => 100,
			<= 2000 => 250,
			<= 10000 => 1000,
			<= 50000 => 5000,
			<= 100000 => 10000,
			<= 500000 => 50000,
			<= 1000000 => 100000,
			_ => 250000
		};
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await BrowserViewportService.SubscribeAsync(this, fireImmediately: true);
		}

		await base.OnAfterRenderAsync(firstRender);
	}

	Guid IBrowserViewportObserver.Id => Guid.NewGuid();

	Task IBrowserViewportObserver.NotifyBrowserViewportChangeAsync(BrowserViewportEventArgs browserViewportEventArgs)
	{
		bool isSmallOrExtraSmallScreen = browserViewportEventArgs.Breakpoint == Breakpoint.Sm || browserViewportEventArgs.Breakpoint == Breakpoint.Xs;
		adaptivePadding = isSmallOrExtraSmallScreen ? "padding: 20px 0px 0px 0px;" : "padding: 10px 20px 0px 20px;";
		return InvokeAsync(StateHasChanged);
	}

	async ValueTask IAsyncDisposable.DisposeAsync()
	{
		await BrowserViewportService.UnsubscribeAsync(this);
	}
}
