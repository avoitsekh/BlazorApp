<MudGrid>
	<MudItem xs="12" sm="12" md="3">
		<MudStack Row="false" Breakpoint="Breakpoint.None" Spacing="2">

			<MudNumericField T="int?" @bind-Value="BalanceAtYear" Immediate Label="Year" Variant="Variant.Text" Min="1" Max="@maxYear" Style="margin-bottom: 15px;" />

			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Payment Date: </MudText>
				<MudText Align="Align.Right">@PaymentDate.ToString("yyyy-MM-dd")</MudText>
			</MudStack>
			
			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Principal Paid: </MudText>
				<MudText Align="Align.Right">@PrincipalPaid.ToString("C2")</MudText>
			</MudStack>

			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Interest Paid: </MudText>
				<MudText Align="Align.Right">@InterestPaid.ToString("C2")</MudText>
			</MudStack>

			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Total Paid: </MudText>
				<MudText Align="Align.Right">@TotalPaid.ToString("C2")</MudText>
			</MudStack>

			<MudStack Justify="Justify.SpaceBetween" Row >
				<MudText Align="Align.Left" Style="font-weight: 500;">Remaining Balance: </MudText>
				<MudText Align="Align.Right">@RemainingBalance.ToString("C2")</MudText>
			</MudStack>

		</MudStack>
	</MudItem>

	<MudItem xs="12" sm="12" md="2">
		<MudChart T="double" ChartType="ChartType.Donut" ChartSeries="@([data])" ChartLabels="@labels" LegendPosition="Position.Right" ChartOptions="@options" Width="200px" Height="100%" Style="margin: 0 auto;" />
	</MudItem>
</MudGrid>

@code {

	[Parameter]
	public List<Payment>? Payments { get; set; }

	public int? BalanceAtYear 
	{
		get;
		set { field = value; Calculate(); }
	} = 5;

	public DateTime PaymentDate { get; private set; }

	public double InterestPaid { get; private set; }

	public double PrincipalPaid { get; private set; }

	public double TotalPaid { get; private set; }

	public double RemainingBalance { get; private set; }

	public double EffectiveAnnualRate { get; private set; }

	int maxYear;
	string[] labels = { "Principal Paid", "Interest Paid", "Remaining Balance" };
	double[] data = { 0 };
	DonutChartOptions options = new()
	{
		FillOpacity = .75D,
		ChartPalette = [Colors.Blue.Default, Colors.DeepOrange.Default, Colors.Gray.Lighten1],
		ShowToolTips = false,
	};

	protected override void OnParametersSet()
	{
		base.OnParametersSet();
		Calculate();
	}

	void Calculate()
	{
		if (Payments != null && BalanceAtYear.HasValue)
		{
			var yearEndPayment = Payments.FirstOrDefault(x => x.Year == BalanceAtYear);
			if (yearEndPayment != null)
			{
				int paymentNumber = yearEndPayment.Number;
				PaymentDate = yearEndPayment.PaymentDate;

				var paymentsForPeriod = Payments.Where(x => x.Number <= paymentNumber);
                    InterestPaid = Pages.MortgageCalculator.PaymentCollection.RoundToCents(paymentsForPeriod.Sum(x => x.InterestAmount));
                    PrincipalPaid = Pages.MortgageCalculator.PaymentCollection.RoundToCents(paymentsForPeriod.Sum(x => x.PrincipalAmount));
                    TotalPaid = Pages.MortgageCalculator.PaymentCollection.RoundToCents(InterestPaid + PrincipalPaid);

				var firstPayment = Payments.FirstOrDefault(x => x.Number == 1);
				if (firstPayment != null)
				{
					var loanAmount = firstPayment.Balance + firstPayment.PrincipalAmount;
                        RemainingBalance = Pages.MortgageCalculator.PaymentCollection.RoundToCents(loanAmount - PrincipalPaid);
				}
			}

			data = [PrincipalPaid, InterestPaid, RemainingBalance];
			maxYear = Payments?.Max(x => x.Year) ?? 1;
			if (BalanceAtYear > maxYear)
			{
				BalanceAtYear = maxYear;
			}

			

		}
	}

}
