<MudGrid>
	<MudItem xs="12" sm="12" md="3">
		<MudStack Row="false" Breakpoint="Breakpoint.None" Spacing="2">

			<MudNumericField T="int?" @bind-Value="BalanceAtYear" @bind-Value:after="Calculate" Immediate Label="Year" Variant="Variant.Text" Min="1" Max="@maxYear" Style="margin-bottom: 15px;" />

			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Payment Date: </MudText>
				<MudText Align="Align.Right">@stats.LastPaymentDate?.ToString("yyyy-MM-dd")</MudText>
			</MudStack>
			


			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Interest Paid: </MudText>
				<MudText Align="Align.Right">@stats.InterestAmount.ToString("N2")</MudText>
			</MudStack>

			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Principal Paid: </MudText>
				<MudText Align="Align.Right">@stats.PrincipalAmount.ToString("N2")</MudText>
			</MudStack>

			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Extra Paid: </MudText>
				<MudText Align="Align.Right">@stats.ExtraAmount.ToString("N2")</MudText>
			</MudStack>

			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Total Paid: </MudText>
				<MudText Align="Align.Right">@stats.PaymentAmount.ToString("N2")</MudText>
			</MudStack>

			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Interest Savings: </MudText>
				<MudText Align="Align.Right">@InterestSavings.ToString("N2")</MudText>
			</MudStack>

			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Ammortization Offset: </MudText>
				<MudText Align="Align.Right">@AmmortizationEncreaseDecrease.ToString("+#'%';-#'%';0'%'")</MudText>
			</MudStack>

			<MudStack Justify="Justify.SpaceBetween" Row >
				<MudText Align="Align.Left" Style="font-weight: 500;">Remaining Balance: </MudText>
				<MudText Align="Align.Right">@stats.RemainingBalance.ToString("N2")</MudText>
			</MudStack>

		</MudStack>
	</MudItem>

	<MudItem xs="12" sm="12" md="2">
		<MudChart T="double" ChartType="ChartType.Donut" ChartSeries="@([data])" ChartLabels="@labels" LegendPosition="Position.Right" ChartOptions="@options" Width="200px" Height="100%" Style="margin: 0 auto;" />
	</MudItem>
</MudGrid>

@code {

	[Parameter]
	public PaymentCollection? Payments { get; set; }

	[Parameter]
	public PaymentCollection? PaymentsWithNoExtraPayments { get; set; }

	bool hasPaymentsWithNoExtraPayments => PaymentsWithNoExtraPayments != null && PaymentsWithNoExtraPayments.Count > 0;


	int? BalanceAtYear = 5;
	double InterestSavings = 0D;

	(double InterestAmount, double PrincipalAmount, double ExtraAmount, double PaymentAmount, double RemainingBalance, DateTime? LastPaymentDate, int Payments) stats = new();


	// DateTime PaymentDate;
	// double InterestPaid;
	// double PrincipalPaid;
	// double TotalPaid;
	// double RemainingBalance;
	double EffectiveAnnualRate;
	double AmmortizationEncreaseDecrease;

	int maxYear;
	string[] labels = { "Principal Paid", "Interest Paid", "Remaining Balance" };
	double[] data = { 0 };

	DonutChartOptions options = new()
	{
		FillOpacity = .75D,
		ChartPalette = [Colors.Blue.Default, Colors.DeepOrange.Default, Colors.Gray.Lighten1],
		ShowToolTips = false,
	};

	protected override void OnParametersSet()
	{
		base.OnParametersSet();
		Calculate();
	}

	void Calculate()
	{
		if (Payments != null && BalanceAtYear.HasValue)
		{
			stats = Payments.GetStatsForYear(BalanceAtYear.Value);

			if (hasPaymentsWithNoExtraPayments)
			{
				var statsWithNoExtraPayments = PaymentsWithNoExtraPayments.GetStatsForYear(BalanceAtYear.Value);
				InterestSavings = statsWithNoExtraPayments.InterestAmount - stats.InterestAmount;
				AmmortizationEncreaseDecrease = (((double)Payments.Count / PaymentsWithNoExtraPayments.Count) - 1) * 100;
			}
			else
			{
				InterestSavings = 0D;
				AmmortizationEncreaseDecrease = 0D;
			}

			data = [stats.PrincipalAmount, stats.InterestAmount, stats.RemainingBalance];
			maxYear = Payments?.Max(x => x.Year) ?? 1;
			if (BalanceAtYear > maxYear)
			{
				BalanceAtYear = maxYear;
			}

			

		}
	}

}
