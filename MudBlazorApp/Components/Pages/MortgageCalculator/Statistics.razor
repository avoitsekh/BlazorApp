<MudGrid>
	<MudItem xs="12" sm="12" md="3">
		<MudStack Row="false" Breakpoint="Breakpoint.None" Spacing="2">

			<MudNumericField T="int?" @bind-Value="BalanceAtYear" @bind-Value:after="Calculate" Immediate Label="Year" Variant="Variant.Text" Min="1" Max="@maxYear" Style="margin-bottom: 15px;" />

			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Last Payment Date</MudText>
				<MudText Align="Align.Right">@stats.LastPaymentDate?.ToString("yyyy-MM-dd")</MudText>
			</MudStack>

			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Number Of Payments</MudText>
				<MudText Align="Align.Right">@stats.NumberOfPayments</MudText>
			</MudStack>
			


			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Interest Paid</MudText>
				<MudText Align="Align.Right">@stats.InterestPaid.ToString("N2")</MudText>
			</MudStack>

			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Principal Paid</MudText>
				<MudText Align="Align.Right">@stats.PrincipalPaid.ToString("N2")</MudText>
			</MudStack>

			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Extra Paid</MudText>
				<MudText Align="Align.Right">@stats.ExtraPaid.ToString("N2")</MudText>
			</MudStack>

			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Total Paid</MudText>
				<MudText Align="Align.Right">@stats.TotalPaid.ToString("N2")</MudText>
			</MudStack>

			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Interest Savings</MudText>
				<MudText Align="Align.Right">@stats.InterestSavings.ToString("N2")</MudText>
			</MudStack>


			<MudStack Justify="Justify.SpaceBetween" Row >
				<MudText Align="Align.Left" Style="font-weight: 500;">Remaining Balance</MudText>
				<MudText Align="Align.Right">@stats.RemainingBalance.ToString("N2")</MudText>
			</MudStack>

			
			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Ammortization Reduction</MudText>
				<MudText Align="Align.Right">@stats.AmmortizationOffset.ToString("+#'%';-#'%';0'%'")</MudText>
			</MudStack>

			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Years to pay-off</MudText>
				<MudText Align="Align.Right">@stats.YearsToPayOff</MudText>
			</MudStack>

			<MudStack Justify="Justify.SpaceBetween" Row>
				<MudText Align="Align.Left">Effective Annual Rate</MudText>
				<MudText Align="Align.Right">@stats.EffectiveAnnualRate.ToString("0.##'%'")</MudText>
			</MudStack>

		</MudStack>
	</MudItem>

	<MudItem xs="12" sm="12" md="2">
		<MudChart T="double" ChartType="ChartType.Donut" ChartSeries="@([data])" ChartLabels="@labels" LegendPosition="Position.Right" ChartOptions="@options" Width="200px" Height="100%" Style="margin: 0 auto;" />
	</MudItem>
</MudGrid>

@code {

	[Parameter]
	public PaymentCollection? Payments { get; set; }

	[Parameter]
	public PaymentCollection? PaymentsNoExtras { get; set; }


	int? BalanceAtYear = 5;
	int maxYear;
	PaymentStatistics stats = new();
	string[] labels = { "Principal Paid", "Interest Paid", "Remaining Balance" };
	double[] data = { 0 };

	DonutChartOptions options = new()
	{
		FillOpacity = .75D,
		ChartPalette = [Colors.Blue.Default, Colors.DeepOrange.Default, Colors.Gray.Lighten1],
		ShowToolTips = false,
	};

	protected override void OnParametersSet()
	{
		base.OnParametersSet();
		stats.Payments = Payments;
		stats.PaymentsNoExtras = PaymentsNoExtras;
		Calculate();
	}

	void Calculate()
	{
		if (Payments.HasData())
		{
			stats.CalculateSummary();

			if (BalanceAtYear.HasValue)
			{
				stats.CalculateForYear(BalanceAtYear.Value);
				data = [stats.PrincipalPaid, stats.InterestPaid, stats.RemainingBalance];

				maxYear = Payments?.Max(x => x.Year) ?? 1;
				if (BalanceAtYear > maxYear)
				{
					BalanceAtYear = maxYear;
				}
			}
		}
	}

}
