@inject IJSRuntime JS

<script>
	function getBrowserTimeZone() {
		const options = Intl.DateTimeFormat().resolvedOptions();
		return options.timeZone;
	}
</script>

@code {

    [Parameter]
    public EventCallback<TimeZoneInfo> OnTimeZoneChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var timeZoneId = await JS.InvokeAsync<string>("getBrowserTimeZone");

            if (TimeZoneInfo.TryFindSystemTimeZoneById(timeZoneId, out var timeZoneInfo))
            {
                await OnTimeZoneChanged.InvokeAsync(timeZoneInfo);
            }
        }
    }
}
