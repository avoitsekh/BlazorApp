@using SkiaSharp
@using SkiaSharp.QrCode
@using SkiaSharp.QrCode.Image

@inject IJSRuntime JSR

<div>
	<img id="qrcode" height="@PreviewImageSize" width="@PreviewImageSize" class="checkered" />
</div>


<script>

	// Set QR Code image blob from byte array
	window.setPreviewImage = async (elementId, contentType, bytes) => {
		const blob = new Blob([bytes], { type: contentType });
		const url = URL.createObjectURL(blob);
		const element = document.getElementById(elementId);
		element.addEventListener('contextmenu', event => event.preventDefault());
		element.onload = () => {
			URL.revokeObjectURL(url);
		}
		element.src = url;
	}

</script>


@code {

	[Parameter]
	public QrCodeOptions? Options { get; set; }

	[Parameter]
	public EventCallback<Exception> OnError { get; set; }

	[Parameter]
	public int PreviewImageSize { get; set; } = 240;

	QRCodeData? qrCodeData;
	MicroQRCodeData? microQrCodeData;
	bool hasRendered;

	protected override Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			hasRendered = true;
			Options ??= new();
			Draw();
		}
		return base.OnAfterRenderAsync(firstRender);
	}

	public void RenderToStream(Stream stream, int imageSize, bool isSvg = false)
	{
		Action<Stream> saveTo;
		if (Options!.Symbology == SymbologyKind.QrCode)
		{
			var builder = new QRCodeImageBuilder(qrCodeData!)
				.WithSize(imageSize, imageSize)
				.WithFinderPatternShape(Options!.FinderPatternShape)
				.WithModuleShape(Options.ModuleShape is RoundedRectangleModuleShape ? new RoundedRectangleModuleShape(Options.ModuleShapeCornerRadius) : Options.ModuleShape, Math.Clamp(Options.ModuleSizePercent, 0.5f, 1.0f))
				.WithColors(ParseColor(Options.ModuleColor1), Options.TransparentBackground ? SKColors.Transparent : SKColors.White)
				.WithGradient(CreateGradient());
			saveTo = isSvg ? builder.SaveToSvg : builder.SaveTo;
		}
		else
		{
			var builder = new MicroQRCodeImageBuilder(microQrCodeData!)
				.WithSize(imageSize, imageSize)
				.WithModuleShape(Options!.ModuleShape is RoundedRectangleModuleShape ? new RoundedRectangleModuleShape(Options.ModuleShapeCornerRadius) : Options.ModuleShape, Math.Clamp(Options.ModuleSizePercent, 0.5f, 1.0f))
				.WithColors(ParseColor(Options.ModuleColor1), Options.TransparentBackground ? SKColors.Transparent : SKColors.White)
				.WithGradient(CreateGradient());
			saveTo = isSvg ? builder.SaveToSvg : builder.SaveTo;
		}
		saveTo(stream);

		SKColor ParseColor(string value)
			=> SKColor.TryParse(value, out var color) ? color : SKColors.Black;

		GradientOptions? CreateGradient()
			=> Options!.GradientDirection == GradientDirection.None ? null : new GradientOptions([ParseColor(Options.ModuleColor1), ParseColor(Options.ModuleColor2)], Options.GradientDirection);
	}

	public byte[] RenderToBytes(int imageSize, bool isSvg = false)
	{
		using var stream = new MemoryStream();
		RenderToStream(stream, imageSize, isSvg);
		return stream.ToArray();
	}

	public async void Draw()
	{
		try
		{
			if (Options != null && hasRendered)
			{
				var quietZoneSize = Math.Clamp(Options.QuietZone, 0, 10);
				if (Options.Symbology == SymbologyKind.QrCode)
				{
					qrCodeData = SkiaSharp.QrCode.QRCodeGenerator.CreateQrCode(Options.Content.AsSpan(), Options.Ecc,
						requestedVersion: Options.Version, quietZoneSize: Math.Clamp(Options.QuietZone, 0, 10));
				}
				else
				{
					microQrCodeData = SkiaSharp.QrCode.MicroQRCodeGenerator.CreateMicroQRCode(Options.Content.AsSpan(), Options.MicroEcc,
						Options.Version is >= 1 and <= 4 ? (MicroQRVersion)Options.Version : null, quietZoneSize);
				}
				await JSR.InvokeVoidAsync("setPreviewImage", "qrcode", "image/png", RenderToBytes(PreviewImageSize));
			}
		}
		catch (Exception ex)
		{
			await OnError.InvokeAsync(ex);
		}
	}

}
