@page "/qrcode"

@using MudBlazor.Utilities
@using SkiaSharp.QrCode
@using SkiaSharp.QrCode.Image

@inject ISnackbar Snackbar
@inject JSExtensionsService JS

<PageTitle>QR Code Generator</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Gutters="false">

	<MudGrid Spacing="4" Class="pa-6">

		<MudItem xs="12" md="6" Class="order-1 order-md-2" >
			<MudPaper MinHeight="200px" Width="100%" Class="pa-5" Style="position: sticky; top: 72px;">
				<MudStack Spacing="1">
					<div class="d-flex pa-n5">
						<MudIcon Icon="@Icons.Material.Filled.RemoveRedEye" Class="mr-2"></MudIcon>
						<MudText><b>Preview</b></MudText>
					</div>

					<MudStack AlignItems="AlignItems.Center">
						<QrCodeImage @ref="qrCodeImage" Options="@options" OnError="@OnGenerateError" />
					</MudStack>
					<MudStack Row Justify="Justify.Center">
						@if (errorMessage != null)
						{
							<MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@errorMessage</MudAlert>
						}
						else
						{
							<MudButtonGroup Color="Color.Inherit" Variant="Variant.Filled">
								<MudButton StartIcon="@Icons.Material.Filled.Download" OnClick="OnDownloadPngAsync">PNG</MudButton>
								<MudButton StartIcon="@Icons.Material.Filled.Download" OnClick="OnDownloadSvgAsync">SVG</MudButton>
								<MudButton StartIcon="@Icons.Material.Filled.ContentCopy" IconSize="Size.Small" OnClick="OnCopyToClipboardAsync">Copy</MudButton>
							</MudButtonGroup>
						}
					</MudStack>
				</MudStack>
			</MudPaper>
		</MudItem>

		<MudItem xs="12" md="6" Class="order-2 order-md-1">
			<MudExpansionPanels MultiExpansion="true">

				<MudExpansionPanel Expanded>
					<TitleContent>
						<div class="d-flex">
							<MudIcon Icon="@Icons.Material.Filled.TextSnippet" Class="mr-2"></MudIcon>
							<MudText><b>Content</b></MudText>
						</div>
					</TitleContent>
					<ChildContent>
						<MudTextField T="string" @bind-Value="options.Content" @bind-Value:after="Regenerate" Immediate DebounceInterval="350" Variant="Variant.Outlined" Lines="1" 
							MaxLines="1000" MaxLength="2000" Sizing="InputSizing.Auto" spellcheck="false" />
					</ChildContent>
				</MudExpansionPanel>

				<MudExpansionPanel>
					<TitleContent>
						<div class="d-flex">
							<MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2"></MudIcon>
							<MudText><b>Parameters</b></MudText>
						</div>
					</TitleContent>
					<ChildContent>
						<MudGrid Spacing="6">
							<MudItem xs="12" sm="6">
								<MudSelect Label="Symbology" @bind-Value="options.Symbology" @bind-Value:after="OnSymbologyChanged" Variant="Variant.Text" Dense>
									<MudSelectItem Value="SymbologyKind.QrCode">QR Code</MudSelectItem>
									<MudSelectItem Value="SymbologyKind.MicroQR">Micro QR</MudSelectItem>
								</MudSelect>
								</MudItem>
								<MudItem xs="12" sm="6">
									@if(options.Symbology == SymbologyKind.QrCode)
									{
									<MudSelect Label="Error Correction" @bind-Value="options.Ecc" @bind-Value:after="Regenerate" Variant="Variant.Text" Dense>
										<MudSelectItem Value="ECCLevel.L">L, 7%</MudSelectItem>
										<MudSelectItem Value="ECCLevel.M">M, 15%</MudSelectItem>
										<MudSelectItem Value="ECCLevel.Q">Q, 25%</MudSelectItem>
										<MudSelectItem Value="ECCLevel.H">H, 30%</MudSelectItem>
									</MudSelect>
									}
									else
									{
									<MudSelect Label="Error Correction" @bind-Value="options.MicroEcc" @bind-Value:after="Regenerate" Variant="Variant.Text" Dense>
										<MudSelectItem Value="MicroQREccLevel.ErrorDetectionOnly">Error Detection Only (M1)</MudSelectItem>
										<MudSelectItem Value="MicroQREccLevel.L">L, 7%</MudSelectItem>
										<MudSelectItem Value="MicroQREccLevel.M">M, 15%</MudSelectItem>
										<MudSelectItem Value="MicroQREccLevel.Q">Q, 25% (M4 only)</MudSelectItem>
									</MudSelect>
									}
								</MudItem>
								<MudItem xs="12" sm="6">
									<MudSlider T="int" @bind-Value="options.Size" Variant="Variant.Filled" Min="64" Max="2048">Image Size: @options.Size.ToString("0 'px'")</MudSlider>
								</MudItem>
								<MudItem xs="12" sm="6">
									<MudSlider T="int" @bind-Value="options.QuietZone" @bind-Value:after="debounceRegenerate" Variant="Variant.Filled" Min="0" Max="10">Quiet Zone: @options.QuietZone.ToString("0 'modules'")</MudSlider>
								</MudItem>
						</MudGrid>
					</ChildContent>
				</MudExpansionPanel>

				<MudExpansionPanel>
					<TitleContent>
						<div class="d-flex">
							<MudIcon Icon="@Icons.Material.Filled.Palette" Class="mr-2"></MudIcon>
							<MudText><b>Style</b></MudText>
						</div>
					</TitleContent>
					<ChildContent>
						<MudGrid Spacing="6">
							<MudItem xs="12">
								<MudSelect T="Preset" @bind-Value="options.Preset" @bind-Value:after="OnPresetChanged" Label="Preset" Variant="Variant.Text" Dense>
									@foreach (var keyValuePair in QrCodeOptions.Presets)
									{
										if (keyValuePair.Value != Preset.Custom)
										{
											<MudSelectItem Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
										}
									}
								</MudSelect>
							</MudItem>
							<MudItem xs="12" sm="6">
								<MudSelect Label="Finder Pattern" @bind-Value="options.FinderPatternShape" @bind-Value:after="OnStyleChanged" Variant="Variant.Text" Disabled="@(options.Symbology is not SymbologyKind.QrCode)" Dense>
									@foreach (var keyValuePair in QrCodeOptions.FinderPatternShapes)
									{
										<MudSelectItem T="FinderPatternShape" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
									}
								</MudSelect>
							</MudItem>
							<MudItem xs="12" sm="6">
								<MudSelect Label="Module Shape" @bind-Value="options.ModuleShape" @bind-Value:after="OnStyleChanged" Variant="Variant.Text" Dense>
									@foreach (var keyValuePair in QrCodeOptions.ModuleShapes)
									{
										<MudSelectItem T="ModuleShape" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
									}
								</MudSelect>
							</MudItem>
							<MudItem xs="12" sm="6">
							<MudSlider T="float" @bind-Value="options.ModuleShapeCornerRadius" @bind-Value:after="OnStyleChanged" Variant="@(options.ModuleShape is not RoundedRectangleModuleShape ? Variant.Outlined : Variant.Filled)" Min="0f" Max="0.5f" Step="0.01f" Disabled="@(options.ModuleShape is not RoundedRectangleModuleShape)">Corner Radius: @options.ModuleShapeCornerRadius.ToString("P0")</MudSlider>
								</MudItem>
							<MudItem xs="12" sm="6">
								<MudSlider T="float" @bind-Value="options.ModuleSizePercent" @bind-Value:after="OnStyleChanged" Variant="Variant.Filled" Color="@(OnMudSliderColorTreshold(options.ModuleSizePercent, 0.65f, 0.85f))" Min="0.5f" Max="1.0f" Step="0.01f">Module Size: @options.ModuleSizePercent.ToString("P0")</MudSlider>
							</MudItem>
							<MudItem xs="12" sm="6">
								<MudColorPicker Label="Module Color 1" @bind-Value="moduleColor1" @bind-Value:after="OnStyleChanged" AdornmentColor="Color.Primary" PickerVariant="PickerVariant.Inline" ShowToolbar="true" ShowAlpha="false" ThrottleInterval="150" />
							</MudItem>
							<MudItem xs="12" sm="6">
								<MudColorPicker Label="Module Color 2" @bind-Value="moduleColor2" @bind-Value:after="OnStyleChanged" AdornmentColor="Color.Primary" PickerVariant="PickerVariant.Inline" ShowToolbar="true" ShowAlpha="false" ThrottleInterval="150" Disabled="@(options.GradientDirection == GradientDirection.None)" />
							</MudItem>
							<MudItem xs="12" sm="6">
								<MudSelect Label="Gradient Options" @bind-Value="options.GradientDirection" @bind-Value:after="OnStyleChanged" Variant="Variant.Text" Dense>
									@foreach (var keyValuePair in QrCodeOptions.GradientOptions)
									{
										<MudSelectItem T="GradientDirection" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
									}
								</MudSelect>
							</MudItem>
							<MudItem xs="12" sm="6">
								<MudCheckBox @bind-Value="options.TransparentBackground" @bind-Value:after="OnStyleChanged" Color="Color.Primary" >Transparent Background</MudCheckBox>
							</MudItem>
						</MudGrid>
					</ChildContent>
				</MudExpansionPanel>

				<MudExpansionPanel>
					<TitleContent>
						<div class="d-flex">
							<MudIcon Icon="@Icons.Material.Filled.Image" Class="mr-2"></MudIcon>
							<MudText><b>Parse Image</b></MudText>
						</div>
					</TitleContent>
					<ChildContent>
						<QrCodeDecoder />
					</ChildContent>
				</MudExpansionPanel>

			</MudExpansionPanels>
		</MudItem>

	</MudGrid>
</MudContainer>

@code
{
	string? errorMessage;
	QrCodeImage? qrCodeImage;
	Action? debounceRegenerate;
	QrCodeOptions options = new();
	const int debounceInterval = 150;

	int ExportImageSize => Math.Clamp(options.Size, 64, 2048);

	MudColor moduleColor1
	{
		get => MudColor.Parse(options.ModuleColor1);
		set => options.ModuleColor1 = value.ToString(MudColorOutputFormats.Hex);
	}

	MudColor moduleColor2
	{
		get => MudColor.Parse(options.ModuleColor2);
		set => options.ModuleColor2 = value.ToString(MudColorOutputFormats.Hex);
	}

	protected override void OnAfterRender(bool firstRender)
	{
		if (firstRender)
		{
			debounceRegenerate = new Action(() => this.InvokeAsync(Regenerate)).Debounce(debounceInterval);
		}
	}

	void Regenerate()
	{
		errorMessage = null;
		qrCodeImage?.Draw();
	}

	Color OnMudSliderColorTreshold(float currentValue, float? errorTreshold, float? warningTreshold)
	{
		if (errorTreshold.HasValue && currentValue < errorTreshold)
		{
			return Color.Error;
		}
		else if (warningTreshold.HasValue && currentValue < warningTreshold)
		{
			return Color.Warning;
		}

		return Color.Primary;
	}

	void OnSymbologyChanged()
	{
		options.QuietZone = options.Symbology == SymbologyKind.MicroQR ? 2 : 4;
		options.FinderPatternShape = null;
		Regenerate();
	}

	void OnStyleChanged()
	{
		if (options.Preset != Preset.Custom)
		{
			options.Preset = Preset.Custom;
		}
		debounceRegenerate();
	}

	void OnPresetChanged()
	{
		if (options.Preset != Preset.Custom)
		{
			switch (options.Preset)
			{
				case Preset.ClassicBlackAndWhite:
					options.FinderPatternShape = null;
					options.ModuleShape = null;
					options.ModuleShapeCornerRadius = 0.0f;
					options.ModuleSizePercent = 1.0f;
					options.ModuleColor1 = "#000000";
					options.ModuleColor2 = "#000000";
					options.GradientDirection = GradientDirection.None;
					options.TransparentBackground = false;
					break;

				case Preset.Ocean:
					options.FinderPatternShape = RoundedRectangleCircleFinderPatternShape.Default;
					options.ModuleShape = CircleModuleShape.Default;
					options.ModuleShapeCornerRadius = 0.0f;
					options.ModuleSizePercent = 0.75f;
					options.ModuleColor1 = "#066efe";
					options.ModuleColor2 = "#06b8e0";
					options.GradientDirection = GradientDirection.TopLeftToBottomRight;
					options.TransparentBackground = false;
					break;

				case Preset.Tech:
					options.FinderPatternShape = CircleFinderPatternShape.Default;
					options.ModuleShape = RoundedRectangleModuleShape.Default;
					options.ModuleShapeCornerRadius = 0.3f;
					options.ModuleSizePercent = 0.85f;
					options.ModuleColor1 = "#cf0e0e";
					options.ModuleColor2 = "#24297a";
					options.GradientDirection = GradientDirection.TopToBottom;
					options.TransparentBackground = false;
					break;
			}
			Regenerate();
		}
	}

	void OnGenerateError(Exception ex)
	{
		errorMessage = ex.GetBaseException().Message.Replace("use Standard QR (QRCodeGenerator)", "switch Symbology to QR Code");
	}

	async Task OnDownloadPngAsync()
	{
		try
		{
			await JS.DownloadFileAsync("qrcode.png", "image/png", qrCodeImage!.RenderToBytes(ExportImageSize));
		}
		catch (Exception ex)
		{
			Snackbar.Add($"Error downloading PNG. {ex.Message}", Severity.Error);
		}
	}

	async Task OnDownloadSvgAsync()
	{
		try
		{
			await JS.DownloadFileAsync("qrcode.svg", "image/svg+xml", qrCodeImage!.RenderToBytes(ExportImageSize, isSvg: true));
		}
		catch (Exception ex)
		{
			Snackbar.Add($"Error downloading SVG. {ex.Message}", Severity.Error);
		}
	}

	async Task OnCopyToClipboardAsync()
	{
		try
		{
			await JS.CopyToClipboardAsync("image/png", qrCodeImage!.RenderToBytes(ExportImageSize));
			Snackbar.Add("QR Code copied to clipboard", Severity.Info);
		}
		catch (Exception ex)
		{
			Snackbar.Add($"Error copying to clipboard. {ex.Message}", Severity.Error);
		}
	}

}
