@if (Message.IsNotification)
{
	<MudText Typo="Typo.body2" Align="Align.Center">@Message.Body</MudText>
}
else
{
	<MudStack Spacing="0">
		@if (ShowUsername)
		{
			<div class="mt-1">
				<MudText Typo="Typo.body2" Class="@HelperTextClasses"><strong>@Username</strong></MudText>
			</div>
		}
		<MudStack Row Wrap="Wrap.NoWrap" Spacing="0" Class="@BubbleJustifyClasses" AlignItems="AlignItems.Center">
			<div class="@BubbleStyleClasses">
				<MudText Typo="Typo.body1">@Message.Body</MudText>
			</div>
			<MudText Typo="Typo.body2" Class="@HelperTextClasses">@MessageReceiveTimeFormatted</MudText>
		</MudStack>
	</MudStack>
}


@code {

	[Parameter, EditorRequired]
	public Message Message { get; set; }

	[Parameter]
	public Message? PreviousMessage { get; set; }

	[Parameter]
	public Message? NextMessage { get; set; }

	[Parameter]
	public bool Animate { get; set; } = false;

	
	string Username => Message.IsMine ? "You" : Message.Owner ?? "(unknown)";

	bool ShowUsername => PreviousMessage == null || Message.Owner != PreviousMessage.Owner;

	bool ShowBubbleTail => NextMessage == null || Message.Owner != NextMessage.Owner;

	string MessageReceiveTimeFormatted => string.Format("{0:HH:mm}", Message.ReceiveTime);

	bool ShouldAnimate => Animate && NextMessage == null;

	string HelperTextClasses => Message.IsMine ? "helper-text-mine" : "helper-text-theirs";

	string BubbleJustifyClasses => Message.IsMine ? "bubble-justify-mine" : "bubble-justify-theirs";

	string BubbleStyleClasses
	{
		get
		{
			var result = new List<string>(10);
			result.AddRange("px-4", "py-2", "rounded-xl");

			if (ShouldAnimate)
			{
				result.Add("bubble-animation");
			}

			if (Message.IsMine)
			{
				result.Add("order-2");
				result.Add("bubble-color-mine");
				if (ShowBubbleTail)
				{
					result.Add("bubble-tail-mine");
				}
			}
			else
			{
				result.Add("bubble-color-theirs");
				if (ShowBubbleTail)
				{
					result.Add("bubble-tail-theirs");
				}
			}

			return string.Join<string>(' ', result);
		}
	}

}
