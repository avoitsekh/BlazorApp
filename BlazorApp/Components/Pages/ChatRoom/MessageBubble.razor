@if (Message.IsNotification)
{
	<MudText Class="mt-1" Align="Align.Center" Typo="Typo.body2">@Message.Body</MudText>
}
else
{
	<MudStack Spacing="0">
		@if (ShowUsername)
		{
			<MudText Class="mt-2 mx-2" Typo="Typo.body2" Align="@HeaderAlign">
				<strong>@Username</strong>
			</MudText>
		}
		<MudStack Row Wrap="Wrap.NoWrap" Spacing="1" Class="@JustifyClasses" AlignItems="AlignItems.Center">
			<div class="@StylingClasses">
				<MudText>@Message.Body</MudText>
			</div>
			<MudText Typo="Typo.body2" Align="@HeaderAlign" Style="min-width: 32px;">@ReceivedTimeFormatted</MudText>
		</MudStack>
	</MudStack>
}


@code {

	[Parameter, EditorRequired]
	public Message Message { get; set; }

	[Parameter]
	public Message? PreviousMessage { get; set; }

	[Parameter]
	public Message? NextMessage { get; set; }

	[CascadingParameter(Name = "*AnimateNewMessages*")]
	bool ShouldAnimate { get; set; } = false;


	bool ShowUsername => PreviousMessage == null || Message.Owner != PreviousMessage.Owner;

	bool ShowTail => NextMessage == null || Message.Owner != NextMessage.Owner;

	string Username => Message.IsMine ? "You" : Message.Owner ?? "(unknown)";

	string ReceivedTimeFormatted => string.Format("{0:HH:mm}", Message.ReceivedTime);

	Align HeaderAlign => Message.IsMine ? Align.End : Align.Start;

	bool IsAnimated => ShouldAnimate && NextMessage == null;

	string JustifyClasses => Message.IsMine ? "justify-mine" : "justify-theirs";

	string StylingClasses
	{
		get
		{
			var result = new List<string>(10);
			result.AddRange("px-4", "py-2", "rounded-xl");

			if (IsAnimated)
			{
				result.Add("bubble-animation");
			}

			if (Message.IsMine)
			{
				result.Add("order-2");
				result.Add("color-mine");
				if (ShowTail)
				{
					result.Add("bubble-tail-mine");
				}
			}
			else
			{
				result.Add("color-theirs");
				if (ShowTail)
				{
					result.Add("bubble-tail-theirs");
				}
			}

			return string.Join<string>(' ', result);
		}
	}


}
