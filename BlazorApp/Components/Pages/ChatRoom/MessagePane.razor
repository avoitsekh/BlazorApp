<MudStack id="messagePane" Spacing="1" Style="word-wrap: anywhere;">
	@{
		var count = Messages.Count;
		Message? previousMessage = null;

		for (int i = 0; i < count; i++)
		{
			var currentMessage = Messages[i];
			var nextMessage = count != 0 && i + 1 < count ? Messages[i + 1] : null;
			<MessageBubble Message="currentMessage" NextMessage="nextMessage" PreviousMessage="previousMessage" />
			previousMessage = currentMessage;
		}
	}
</MudStack>


<style>

	.justify-mine {
		display: flex;
		justify-content: flex-end;
		margin-left: 10%;
	}

	.justify-theirs {
		display: flex;
		justify-content: flex-start;
		margin-right: 10%;
	}

	.color-mine {
		background-color: var(--mud-palette-primary);
		color: var(--mud-palette-primary-text);
	}

	.color-theirs {
		background-color: var(--mud-palette-dark);
		color: var(--mud-palette-dark-text);
	}

	.bubble-tail-mine {
		--b: 1em;		/* tail base */
		--h: .5em;		/* tail height */
		--p: 100%;		/* tail position (0%: left, 100%: right) */
		--r: 3.1em;		/* border radius */
		--c: var(--mud-palette-primary);
		clip-path: polygon(0 100%,0 0,100% 0,100% 100%, min(100%,var(--p) + var(--b)/2) 100%, var(--p) calc(100% + var(--h)), max(0%,var(--p) - var(--b)/2) 100%);
		border-image: conic-gradient(var(--c) 0 0) fill 0/ var(--r) calc(100% - var(--p) - var(--b)/2) 0 calc(var(--p) - var(--b)/2)/ 0 0 var(--h) 0;
		border-bottom-right-radius: 0 !important;
	}

	.bubble-tail-theirs {
		--b: 1em;		/* tail base */
		--h: .5em;		/* tail height */
		--p: 0%;		/* tail position (0%: left, 100%: right) */
		--r: 3.1em;		/* border radius */
		--c: var(--mud-palette-dark);
		clip-path: polygon(0 100%,0 0,100% 0,100% 100%, min(100%,var(--p) + var(--b)/2) 100%, var(--p) calc(100% + var(--h)), max(0%,var(--p) - var(--b)/2) 100%);
		border-image: conic-gradient(var(--c) 0 0) fill 0/ var(--r) calc(100% - var(--p) - var(--b)/2) 0 calc(var(--p) - var(--b)/2)/ 0 0 var(--h) 0;
		border-bottom-left-radius: 0 !important;
	}

	.bubble-animation {
		animation: bubble-pop .5s cubic-bezier(.16,1,.3,1) backwards;
	}
	
	@@keyframes bubble-pop {
		from {
			opacity: 0;
			transform: translateY(10px) scale(.94);
		}

		to {
			opacity: 1;
			transform: none;
		}
	}

</style>



@code {

	[Parameter, EditorRequired]
	public IReadOnlyList<Message> Messages { get; set; }

}
