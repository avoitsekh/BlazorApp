<div>
	@if (Message.IsNotification)
	{
		<MudText Class="@(IsSequentialMessage ? "" : "mt-3")" Align="Align.Center" Typo="Typo.body2">@Message.Body</MudText>
	}
	else
	{
		if (!IsSequentialMessage && Message.Owner != null)
		{
			<MudText Class="mt-2" Style="@BubbleJustification">
				<MudText Inline Typo="Typo.body2">@(Message.IsMine ? string.Empty : Message.Owner + " at")&nbsp;</MudText>
				<MudText Inline Typo="Typo.body2">@string.Format("{0:HH:mm}", Message.Received)</MudText>
			</MudText>
		}
		<div style="@BubbleJustification">
			<div class="@BubbleStyle" style="@BubbleColor">
				<MudText Style="word-wrap: anywhere;">@Message.Body</MudText>
			</div>
		</div>
	}
</div>




@code {

	[Parameter, EditorRequired]
	public Message Message { get; set; }

	[Parameter]
	public Message? PreviousMessage { get; set; }


	string BubbleJustification => Message.IsMine 
		? "display: flex; justify-content: flex-end;"
		: "display: flex; justify-content: flex-start;";

	// string BubbleStyle => Message.IsMine
	// 	? "px-6 py-2 mud-elevation-1 rounded-l-xl rounded-br-xl rounded-tr-sm ml-20"
	// 	: "px-6 py-2 mud-elevation-1 rounded-r-xl rounded-bl-xl rounded-tl-sm mr-20";

	string BubbleStyle
	{
		get
		{
			var result = "px-4 py-2 mud-elevation-1";
			if (Message.IsMine)
			{
				// result += " ml-20";
				result += IsSequentialMessage ? " rounded-xl" : " rounded-l-xl rounded-br-xl rounded-tr-sm";
			}
			else
			{
				// result += " mr-20";
				result += IsSequentialMessage ? " rounded-xl" : " rounded-r-xl rounded-bl-xl rounded-tl-sm";
			}
			return result;
		}
	}

	string BubbleColor => Message.IsMine
		? $"background-color: var(--mud-palette-info); color: var(--mud-palette-info-text); margin-left: 15%;"
		: $"background-color: var(--mud-palette-surface); color: var(--mud-palette-text-primary); margin-right: 15%;";

	bool IsSequentialMessage => PreviousMessage != null && PreviousMessage.Owner == Message.Owner;

	// string GetReceiveTimeFormatted(DateTime? date)
	// {
	// 	if (date.HasValue)
	// 	{
	// 		return string.Format("HH:mm", date);
	// 	}
	// }

	protected override void OnAfterRender(bool firstRender)
	{
		if (firstRender)
		{
			
		}
	}

}
