<MudStack id="messagePane" Spacing="1" Class="mt-1" Style="word-wrap: anywhere;">
	@if (Client != null)
	{
		var count = Client.Messages.Count;
		Message? previousMessage = null;

		for (int i = 0; i < count; i++)
		{
			var currentMessage = Client.Messages[i];
			var nextMessage = count != 0 && i + 1 < count ? Client.Messages[i + 1] : null;
			<MessageBubble Message="currentMessage" NextMessage="nextMessage" PreviousMessage="previousMessage" Animate="animateMessages" />
			previousMessage = currentMessage;
		}
	}
</MudStack>

<style>

	.helper-text-mine {
		text-align: right;
		padding-right: 6px;
		white-space: nowrap;
	}

	.helper-text-theirs {
		text-align: left;
		padding-left: 6px;
		white-space: nowrap;
	}

	.bubble-justify-mine {
		display: flex;
		justify-content: flex-end;
		margin-left: 8%;
	}

	.bubble-justify-theirs {
		display: flex;
		justify-content: flex-start;
		margin-right: 8%;
	}

	.bubble-color-mine {
		background-color: var(--mud-palette-primary);
		color: var(--mud-palette-primary-text);
	}

	.bubble-color-theirs {
		background-color: var(--mud-palette-text-primary);
		color: var(--mud-palette-background);
	}

	.bubble-tail-mine {
		--b: 1em;		/* tail base */
		--h: .5em;		/* tail height */
		--p: 100%;		/* tail position (0%: left, 100%: right) */
		--r: 2.6em;		/* border radius */
		--c: var(--mud-palette-primary);
		clip-path: polygon(0 100%,0 0,100% 0,100% 100%, min(100%,var(--p) + var(--b)/2) 100%, var(--p) calc(100% + var(--h)), max(0%,var(--p) - var(--b)/2) 100%);
		border-image: conic-gradient(var(--c) 0 0) fill 0/ var(--r) calc(100% - var(--p) - var(--b)/2) 0 calc(var(--p) - var(--b)/2)/ 0 0 var(--h) 0;
		border-bottom-right-radius: 0 !important;
	}

	.bubble-tail-theirs {
		--b: 1em;		/* tail base */
		--h: .5em;		/* tail height */
		--p: 0%;		/* tail position (0%: left, 100%: right) */
		--r: 2.6em;		/* border radius */
		--c: var(--mud-palette-text-primary);
		clip-path: polygon(0 100%,0 0,100% 0,100% 100%, min(100%,var(--p) + var(--b)/2) 100%, var(--p) calc(100% + var(--h)), max(0%,var(--p) - var(--b)/2) 100%);
		border-image: conic-gradient(var(--c) 0 0) fill 0/ var(--r) calc(100% - var(--p) - var(--b)/2) 0 calc(var(--p) - var(--b)/2)/ 0 0 var(--h) 0;
		border-bottom-left-radius: 0 !important;
	}

	.bubble-animation {
		animation: bubble-pop .5s cubic-bezier(.16,1,.3,1) backwards;
	}
	
	@@keyframes bubble-pop {
		from {
			opacity: 0;
			transform: translateY(10px) scale(.94);
		}

		to {
			opacity: 1;
			transform: none;
		}
	}

</style>



@code {

	[CascadingParameter]
	ChatClient? Client { get; set; }

	bool animateMessages;

	public override async Task SetParametersAsync(ParameterView parameters)
	{
		if (parameters.TryGetValue<ChatClient>(nameof(Client), out var _client))
		{
			if (Client != null && !animateMessages)
			{   // When clicking away from chat module and coming back to it, this logic ensures 
				// only new incoming message bubbles are animated and not all of them.
				animateMessages = true;
			}

			if (Client == null || Client.Messages.Count != _client.Messages.Count)
			{   // Some minor optimization
				Client = _client;
			}
		}

		await base.SetParametersAsync(ParameterView.Empty);
	}

}
