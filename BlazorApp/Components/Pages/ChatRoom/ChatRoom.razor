@page "/chat"

@inject NavigationManager NavManager
@inject AppBarOptions AppBar
@inject IJSRuntime JSR


@implements IAsyncDisposable



@if (!isDebug)
{
	<div style="position: relative; height: 90vh;">
		<MudOverlay Visible="true" Absolute="true" Style="background-color: var(--mud-palette-surface); transition: none;" >
			<MudStack AlignItems="AlignItems.Center">
				<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-wrench-adjustable" viewBox="0 0 16 16">
					<path d="M16 4.5a4.5 4.5 0 0 1-1.703 3.526L13 5l2.959-1.11q.04.3.041.61" />
					<path d="M11.5 9c.653 0 1.273-.139 1.833-.39L12 5.5 11 3l3.826-1.53A4.5 4.5 0 0 0 7.29 6.092l-6.116 5.096a2.583 2.583 0 1 0 3.638 3.638L9.908 8.71A4.5 4.5 0 0 0 11.5 9m-1.292-4.361-.596.893.809-.27a.25.25 0 0 1 .287.377l-.596.893.809-.27.158.475-1.5.5a.25.25 0 0 1-.287-.376l.596-.893-.809.27a.25.25 0 0 1-.287-.377l.596-.893-.809.27-.158-.475 1.5-.5a.25.25 0 0 1 .287.376M3 14a1 1 0 1 1 0-2 1 1 0 0 1 0 2" />
				</svg>
				<MudText Typo="Typo.h5">Work in progress...</MudText>
			</MudStack>
		</MudOverlay>
	</div>
}
else
{

	<script>

		window.registerTabCloseHandler = function(dotNetHelper) {
			window.addEventListener("beforeunload", tabClosing);
			_dotNetHelper = dotNetHelper;
		}

		window.unRegisterTabCloseHandler = function(dotNetHelper) {
			window.removeEventListener("beforeunload", tabClosing);
			_dotNetHelper = null;
		}

		var _dotNetHelper;

		window.tabClosing = function(event) {
			_dotNetHelper.invokeMethodAsync("OnBrowserTabClosing");
		}

		window.scrollToBottom = (elementId) => {
			const el = document.getElementById(elementId);
			if (el) el.scrollTop = el.scrollTop = el.scrollHeight;
		}

	</script>


	@* <MudExitPrompt /> *@


	@if (!(client?.IsConnected ?? false))
	{

		<MudForm OnEnterPressed="JoinChat" Class="d-flex justify-center align-center" Style="height: 90vh;">
			<MudPaper MaxWidth="280px" MinWidth="150px" Width="100%" Height="48px" Class="d-flex align-center gap-1 rounded-pill pa-1 pl-5" Elevation="1">
				<MudTextField T="string" Immediate Placeholder="Enter your name to start chatting" Underline="false" Class="d-flex" @bind-Value="newMessage.Owner"></MudTextField>
				<MudIconButton Icon="@personCheck" Size="Size.Medium" OnClick="JoinChat"></MudIconButton>
				@* <MudFab StartIcon="@personCheck" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" /> *@
			</MudPaper>
			<MudText Color="Color.Error" Align="Align.Center">@errorMessage</MudText>
		</MudForm>

		@*

		Style="background-color: greenyellow;"

		Style="background-color: lightyellow;"
		
		*@



	}
	else
	{



		<div class="chat-container">

			<!-- HEADER -->
			<div class="chat-header">
				<h3>Chat Room</h3>
				<span>5 users online</span>
			</div>

			<!-- MESSAGES (takes all remaining space) -->
			<div class="chat-messages" id="messageContainer">

				<MudStack Spacing="1" Class="pa-1">

					@{
						Message? previousMessage = null;

						foreach (var message in messages)
						{
							<ChatBubble Message="message" PreviousMessage="previousMessage" />
							previousMessage = message;
						}
					}

				</MudStack>


			</div>

			<!-- FOOTER / INPUT -->
			<div class="chat-footer">
				<MudForm OnEnterPressed="OnSendMessageClicked" Style="width: 100%;">
					<MudPaper Width="100%" Height="50px" Class="d-flex align-center gap-1 rounded-pill pa-1 pl-5" Elevation="1">
						<MudTextField T="string" Immediate Placeholder="Type your message..." Underline="false" Class="d-flex" @bind-Value="newMessage.Body"></MudTextField>
						<MudIconButton Icon="@Icons.Material.Filled.Send" Size="Size.Medium" OnClick="OnSendMessageClicked"></MudIconButton>
						@* <MudIconButton Icon="@Icons.Material.Filled.Send" Size="Size.Large" Color="Color.Primary" Variant="Variant.Filled" DropShadow="false" Class="rounded-circle pa-2" OnClick="OnSendMessageClicked"></MudIconButton> *@
					</MudPaper>
				</MudForm>
			</div>

		</div>


		<style>


			/* Makes the container fill the full viewport height */
			.chat-container {
				display: flex;
				flex-direction: column;
				height: 90vh;
				max-width: 400px;
				margin: 0 auto;
			}

			/* Fixed height header — stays at top */
			.chat-header {
				flex: 0 0 auto; /* does NOT grow or shrink */
				padding: 16px;
				background-color: #1F3864;
				color: white;
				display: flex;
				justify-content: space-between;
				align-items: center;
			}

			/* Middle section — takes ALL remaining space */
			.chat-messages {
				flex: 1; /* grows to fill all available space */
				overflow-y: auto; /* scrollable when messages overflow */
				/* padding: 10px; */
				display: flex;
				flex-direction: column;
				/* gap: 8px; */
				/* background-color: #f5f5f5; */
			}

			/* Fixed height footer — stays at bottom */
			.chat-footer {
				flex: 0 0 auto; /* does NOT grow or shrink */
				padding: 10px;
				/* background-color: #ffffff; */
				/* border-top: 1px solid #ddd; */
				display: flex;
				gap: 8px;
			}


		</style>


	}


}


@code {

	bool isDebug =
#if DEBUG
		true;
#else
		false;
#endif

	List<Message> messages = new(30);
	Message newMessage = new();

	ChatClient? client;
	string? errorMessage;
	DotNetObjectReference<ChatRoom> dotNetRef;
	bool hasRendered = false;



	const string personCheck =
@"<svg xmlns=""http://www.w3.org/2000/svg"" width=""24"" height=""24"" fill=""currentColor"" class=""bi bi-person-check-fill"" viewBox=""0 0 16 16"">
  <path fill-rule=""evenodd"" d=""M15.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 0 1 .708-.708L12.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0""/>
  <path d=""M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6""/>
</svg>
";




	public ChatRoom()
	{
		dotNetRef = DotNetObjectReference.Create(this);
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			hasRendered = true;
			AppBar.Title = "Chat Room";
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (isDebug && hasRendered)
		{
			await JSR.InvokeVoidAsync("unRegisterTabCloseHandler", dotNetRef);
		}
		await ExitChat();
	}

	[JSInvokable]
	public async Task OnBrowserTabClosing()
	{
		Console.WriteLine("Browser tab closed.");
		await ExitChat();
	}

	async Task JoinChat()
	{
		errorMessage = null;
		messages.Clear();

		var url = NavManager.ToAbsoluteUri(ChatHub.Path);
		client = new(url.AbsoluteUri);
		client.Error = OnError;
		client.MessageReceived = OnMessageReceived;
		await client.Join(newMessage.Owner);
		if (isDebug)
		{
			await JSR.InvokeVoidAsync("registerTabCloseHandler", dotNetRef);
		}
	}

	async Task ExitChat()
	{
		if (client != null)
		{
			client.Dispose();
			client = null;
		}
	}

	async Task OnSendMessageClicked()
	{
		if (client != null && !newMessage.IsEmpty)
		{
			await client.SendMessage(newMessage);
			newMessage.Clear();
		}
	}

	void OnMessageReceived(Message message)
	{
		message.Received = DateTime.Now;
		messages.Add(message);
		InvokeAsync(async () =>
		{
			StateHasChanged();

			if (isDebug)
			{
				// Scroll to bottom every time messages update
				await JSR.InvokeVoidAsync("scrollToBottom", "messageContainer");
			}
		});
	}

	void OnError(string message)
	{
		errorMessage = message;
	}



}
