@code {

	// flag to indicate chat status
	bool _isChatting = false;

	// name of the user who will be chatting
	string? _username;

	// on-screen message
	string? _message;

	// new message input
	string? _newMessage;

	// list of messages in chat
	List<ChatMessage> _messages = new();

	string? _hubUrl;
	HubConnection? _hubConnection;


	protected override void OnAfterRender(bool firstRender)
	{
		if (firstRender)
		{
			AppBar.Title = "Chat Room";
		}
	}

	public async ValueTask DisposeAsync()
	{
		await ExitChatAsync();
	}

	async Task EnterChatAsync()
	{
		if (string.IsNullOrWhiteSpace(_username))
		{
			_message = "Please enter a name";
			return;
		}

		try
		{
			_isChatting = true;

			_messages.Clear();

			string baseUrl = NavManager.BaseUri;
			_hubUrl = baseUrl.TrimEnd('/') + ChatHub.Path;

			_hubConnection = new HubConnectionBuilder()
				.WithUrl(_hubUrl)
				.Build();

			_hubConnection.On<string, string>(nameof(ChatHub.Broadcast), OnIncomingMessage);

			await _hubConnection.StartAsync();

			await SendMessageAsync($"[Notice] {_username} joined chat room.");
		}
		catch (Exception e)
		{
			_message = $"ERROR: Failed to start chat client: {e.Message}";
			_isChatting = false;
		}
	}

	async Task ExitChatAsync()
	{
		if (_isChatting)
		{
			await SendMessageAsync($"[Notice] {_username} left chat room.");

			await _hubConnection.StopAsync();
			await _hubConnection.DisposeAsync();

			_hubConnection = null;
			_isChatting = false;
		}
	}

	async Task SendMessageAsync(string message)
	{
		if (_isChatting && !string.IsNullOrWhiteSpace(message))
		{
			await _hubConnection.SendAsync(nameof(ChatHub.Broadcast), _username, message);
			_newMessage = string.Empty;
		}
	}

	void OnIncomingMessage(string name, string message)
	{
		bool isMine = name.Equals(_username, StringComparison.OrdinalIgnoreCase);
		_messages.Add(new ChatMessage(name, message, isMine));
		InvokeAsync(StateHasChanged);
	}


}
