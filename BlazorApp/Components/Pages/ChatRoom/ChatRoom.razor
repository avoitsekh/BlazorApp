@page "/chat"

@inject NavigationManager NavManager
@inject AppBarOptions AppBar
@inject IJSRuntime JSR

@implements IAsyncDisposable


@if (!isJoined)
{
	<MudForm OnEnterPressed="JoinChat" Class="d-flex justify-center align-center" Style="height: calc(100dvh - 70px);">
		<MudPaper MaxWidth="330px" MinWidth="150px" Width="100%" Class="d-flex align-center gap-1 rounded-pill pr-1 pl-5" Elevation="1">
			<MudTextField @ref="usernameTextBox" T="string" Immediate Placeholder="Enter your name to start chatting" Underline="false" Class="d-flex" @bind-Value="newMessage.Owner" Style="height: 49px;" />
			@if (isJoining)
			{
				<MudProgressCircular Size="Size.Small" Color="Color.Inherit" Indeterminate="true" Class="mr-2" />
			}
			else
			{
				<MudIconButton Icon="@personCheck" Size="Size.Medium" OnClick="JoinChat"></MudIconButton>
			}
		</MudPaper>
		<MudText Color="Color.Error" Align="Align.Center" Class="mt-1">@errorMessage</MudText>
	</MudForm>
}
else
{
	<div class="chat-container">

		<div class="chat-header">
			<MudPaper Width="100%" Class="rounded-pill pa-1 pr-4" Elevation="1">

				<MudStack Row Wrap="Wrap.NoWrap" AlignItems="AlignItems.Center">
					<Avatar Username="@client?.CurrentUsername" />
					<MudText Typo="Typo.h6" Class="chat-username">@client?.CurrentUsername</MudText>
					<MudSpacer />
					<MudText Align="Align.Center" Style="min-width: 46px;">@($"{chatMemberCount} {(chatMemberCount == 1 ? "user" : "users")} online")</MudText>
				</MudStack>

			</MudPaper>
		</div>

		<div class="chat-messages" id="messageContainer">
			<MudStack Spacing="1">
				@{
					Message? previousMessage = null;
					foreach (var message in messages)
					{
						<ChatBubble Message="message" PreviousMessage="previousMessage" />
						previousMessage = message;
					}
				}
			</MudStack>
		</div>

		<div class="chat-footer">
			<MudForm OnEnterPressed="OnSendMessageClicked" Style="width: 100%;">
				<MudPaper Width="100%" Class="d-flex align-center gap-1 rounded-pill pr-1 pl-5" Elevation="1">
					<MudTextField @ref="messageTextBox" T="string" Immediate Placeholder="Type your message..." Underline="false" Class="d-flex" @bind-Value="newMessage.Body" Style="height: 49px;" />
					<MudIconButton Icon="@Icons.Material.Filled.Send" Size="Size.Medium" OnClick="OnSendMessageClicked"></MudIconButton>
				</MudPaper>
			</MudForm>
		</div>

	</div>
}


<script>

	window.registerTabCloseHandler = function(dotNetHelper) {
		window.addEventListener("beforeunload", tabClosing);
		_dotNetHelper = dotNetHelper;
	}

	window.unRegisterTabCloseHandler = function(dotNetHelper) {
		window.removeEventListener("beforeunload", tabClosing);
		_dotNetHelper = null;
	}

	var _dotNetHelper;

	window.tabClosing = function(event) {
		_dotNetHelper.invokeMethodAsync("OnBrowserTabClosing");
	}

	window.scrollToBottom = (elementId) => {
		const el = document.getElementById(elementId);
		if (el) el.scrollTop = el.scrollTop = el.scrollHeight;
	}

</script>


<style>

	.chat-container {
		display: flex;
		flex-direction: column;
		height: calc(100svh - 70px);
		max-width: 406px;
		margin: 0 auto;
	}

	.chat-header {
		flex: 0 0 auto;		/* does NOT grow or shrink */
		padding: 8px;
	}

	.chat-messages {
		flex: 1;			/* grows to fill all available space */
		overflow-y: auto;	/* scrollable when messages overflow */
		display: flex;
		flex-direction: column;
		padding: 8px;
		min-height: 100px;
	}

	.chat-footer {
		flex: 0 0 auto;		/* does NOT grow or shrink */
		display: flex;
		padding: 8px;
	}

	.chat-username {
		white-space: nowrap;
		text-overflow: ellipsis;
		min-width: 40px;
		overflow: hidden;
	}

</style>



@code {

	List<Message> messages = new(30);
	Message newMessage = new();

	string? errorMessage;
	int chatMemberCount;
	bool hasRendered = false;
	bool isJoined = false;
	bool isJoining = false;
	ChatClient? client;
	DotNetObjectReference<ChatRoom> dotNetRef;

	MudTextField<string>? usernameTextBox;
	MudTextField<string>? messageTextBox;

	const string personCheck =
@"<svg xmlns=""http://www.w3.org/2000/svg"" width=""24"" height=""24"" fill=""currentColor"" class=""bi bi-person-check-fill"" viewBox=""0 0 16 16"">
  <path fill-rule=""evenodd"" d=""M15.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 0 1 .708-.708L12.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0""/>
  <path d=""M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6""/>
</svg>
";


	public ChatRoom()
	{
		dotNetRef = DotNetObjectReference.Create(this);
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			hasRendered = true;
			AppBar.Title = "Chat Room";
			await usernameTextBox!.FocusAsync();
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (hasRendered)
		{
			await JSR.InvokeVoidAsync("unRegisterTabCloseHandler", dotNetRef);
		}
		await ExitChat();
	}

	[JSInvokable]
	public async Task OnBrowserTabClosing()
	{
		Console.WriteLine("Browser tab closed.");
		await ExitChat();
	}

	async Task JoinChat()
	{
		errorMessage = null;
		messages.Clear();

		if (!isJoining && !isJoined)
		{
			var url = NavManager.ToAbsoluteUri(ChatHub.Path);
			client = new(url.AbsoluteUri);

			client.Error += OnError;
			client.Joining += OnJoining;
			client.Joined += OnJoined;
			client.MessageReceived += OnMessageReceived;
			client.MembersChanged += OnMembersChanged;

			await client.Join(newMessage.Owner!);
			await JSR.InvokeVoidAsync("registerTabCloseHandler", dotNetRef);
		}
	}

	async Task ExitChat()
	{
		isJoining = isJoined = false;

		if (client != null)
		{
			client.Dispose();
			client = null;
		}
	}

	async Task OnSendMessageClicked()
	{
		if (client != null && isJoined && !newMessage.IsEmpty)
		{
			await client.SendMessage(newMessage);
			newMessage.Clear();
		}
	}

	void OnMessageReceived(object? sender, Message message)
	{
		message.Received = DateTime.Now;
		messages.Add(message);
		InvokeAsync(async () =>
		{
			StateHasChanged();

			// Scroll to bottom every time messages update
			await JSR.InvokeVoidAsync("scrollToBottom", "messageContainer");
		});
	}

	void OnMembersChanged(object? sender, List<string> list)
	{
		chatMemberCount = list.Count;
		InvokeAsync(StateHasChanged);
	}

	void OnJoining(object? sender, EventArgs e)
	{
		isJoining = true;
	}

	void OnJoined(object? sender, EventArgs e)
	{
		isJoined = true;
		InvokeAsync(StateHasChanged);
		messageTextBox!.FocusAsync();
	}

	void OnError(object? sender, string message)
	{
		ExitChat();
		errorMessage = message;
		InvokeAsync(StateHasChanged);
	}
}
