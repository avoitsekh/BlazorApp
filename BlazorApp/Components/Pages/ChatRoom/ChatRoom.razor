@page "/chat"

@inject NavigationManager NavManager
@inject AppBarOptions AppBar

@implements IAsyncDisposable

@if (!isDebug)
{
	<div style="position: relative; height: 90vh;">
		<MudOverlay Visible="true" Absolute="true" Style="background-color: var(--mud-palette-surface); transition: none;" >
			<MudStack AlignItems="AlignItems.Center">
				<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-wrench-adjustable" viewBox="0 0 16 16">
					<path d="M16 4.5a4.5 4.5 0 0 1-1.703 3.526L13 5l2.959-1.11q.04.3.041.61" />
					<path d="M11.5 9c.653 0 1.273-.139 1.833-.39L12 5.5 11 3l3.826-1.53A4.5 4.5 0 0 0 7.29 6.092l-6.116 5.096a2.583 2.583 0 1 0 3.638 3.638L9.908 8.71A4.5 4.5 0 0 0 11.5 9m-1.292-4.361-.596.893.809-.27a.25.25 0 0 1 .287.377l-.596.893.809-.27.158.475-1.5.5a.25.25 0 0 1-.287-.376l.596-.893-.809.27a.25.25 0 0 1-.287-.377l.596-.893-.809.27-.158-.475 1.5-.5a.25.25 0 0 1 .287.376M3 14a1 1 0 1 1 0-2 1 1 0 0 1 0 2" />
				</svg>
				<MudText Typo="Typo.h5">Work in progress...</MudText>
			</MudStack>
		</MudOverlay>
	</div>
}
else
{



	@* <MudExitPrompt /> *@

	@* <MudContainer Gutters="false" Class="d-flex justify-center mud-width-full" Style="height: 90vh;"> *@
	<div class="d-flex justify-center mud-width-full" style="height: 40vh; position: relative;">

		<MudPaper id="main-container" MaxWidth="800px" Width="800px" Class="pa-0" Elevation="2" Style="@($"background: {Colors.Shades.Transparent};")">
			@if (!(client?.IsConnected ?? false))
			{
				<MudStack>
					<MudTextField T="string" Label="Enter your name to start chatting" @bind-Value="newMessage.Username"></MudTextField>
					<MudButton OnClick="@EnterChat">Join</MudButton>
				</MudStack>
			}
			else
			{
				foreach (var message in messages)
				{
					if (message.IsNotification)
					{
						<MudText>@message.Body</MudText>
					}
					else
					{
						<MudText>@message.Username: @message.Body</MudText>
					}
				}

				<MudStack Style="position: absolute; bottom: 0;">
					<MudTextField T="string" Label="Type your message here" Immediate @bind-Value="newMessage.Body"></MudTextField>
					<MudButton OnClick="OnMessageSend">Send</MudButton>
					@* <MudButton OnClick="@(() => SendMessageAsync(_newMessage))">Send</MudButton> *@
				</MudStack>
			}

			<MudText Color="Color.Error">@errorMessage</MudText>

			@* 	<br />
	<br />

	<div class="mud-theme-info py-4 px-6 ml-20 rounded-l-xl mud-elevation-2">
		<MudText Align="Align.Center">This is a test message...<br />ddddddddddddddddd</MudText>
	</div> *@

		</MudPaper>

	</div>

	@* </MudContainer> *@




}


@code {

	bool isDebug =
#if DEBUG
		true;
#else
		false;
#endif

	List<ChatMessage> messages = new(30);
	ChatMessage newMessage = new();
	ChatClient? client;
	string? errorMessage;

	protected override void OnAfterRender(bool firstRender)
	{
		if (firstRender)
		{
			AppBar.Title = "Chat Room";
		}
	}

	public async ValueTask DisposeAsync()
	{
		await ExitChat();
	}

	async Task EnterChat()
	{
		errorMessage = null;

		var url = NavManager.ToAbsoluteUri(ChatHub.Path);
		client = new(url.AbsoluteUri);
		client.Error = OnError;
		client.MessageReceived = OnMessageReceived;
		await client.Join(newMessage.Username);
	}

	async Task ExitChat()
	{
		if (client != null)
		{
			await client.Exit();
			client = null;
		}
	}

	async Task OnMessageSend()
	{
		if (client != null)
		{
			await client.SendMessage(newMessage);
			newMessage.Clear();
		}
	}

	void OnMessageReceived(ChatMessage message)
	{
		messages.Add(message);
		InvokeAsync(StateHasChanged);
	}

	void OnError(string message)
	{
		errorMessage = message;
	}

}
