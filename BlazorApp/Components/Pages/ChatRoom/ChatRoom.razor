@page "/chat"

@inject NavigationManager NavManager
@inject AppBarOptions AppBar
@inject IJSRuntime JSR
@inject JSExtensionsService JS
@inject ChatClient Client

@implements IAsyncDisposable


<PageTitle>Chat Room</PageTitle>

@if (!Client.IsJoined)
{
	<MudForm OnEnterPressed="JoinChat" Class="d-flex justify-center align-center" Style="height: calc(100dvh - 70px);">
		<MudPaper MaxWidth="330px" MinWidth="150px" Width="100%" Class="d-flex align-center gap-1 rounded-pill pa-1 pl-5" Elevation="1">
			<MudTextField @ref="usernameToJoinTextBox" T="string" Immediate Placeholder="Enter your name to start chatting" Underline="false" @bind-Value="usernameToJoin" />
			@if (Client.IsJoining)
			{
				<MudProgressCircular Size="Size.Small" Color="Color.Inherit" Indeterminate="true" Style="margin: 9px;" />
			}
			else
			{
				<MudIconButton Icon="@personCheck" Size="Size.Medium" OnClick="JoinChat" />
			}
		</MudPaper>
		<MudText Color="Color.Error" Align="Align.Center" Class="mt-1">@errorMessage</MudText>
	</MudForm>
}
else
{
	<div class="chat-container">
		<CascadingValue Value="Client">

			<div class="chat-header mb-n6 z-10">
				<ChatHeader />
			</div>

			<div class="chat-messages py-7 z-1" id="messageContainer">
				<ChatMessages />
			</div>

			<div class="chat-footer mt-n6 z-10">
				<ChatFooter @ref="chatFooter" />
			</div>

		</CascadingValue>
	</div>
}


<script>

	window.registerTabCloseHandler = function(dotNetHelper) {
		window.addEventListener("beforeunload", tabClosing);
		_dotNetHelper = dotNetHelper;
	}

	window.unRegisterTabCloseHandler = function(dotNetHelper) {
		window.removeEventListener("beforeunload", tabClosing);
		_dotNetHelper = null;
	}

	var _dotNetHelper;

	window.tabClosing = function(event) {
		_dotNetHelper.invokeMethodAsync("OnBrowserTabClosing");
	}

	window.scrollToBottom = (elementId) => {
		const el = document.getElementById(elementId);
		if (el) el.scrollTop = el.scrollTop = el.scrollHeight;
	}

</script>


<style>

	.chat-container {
		display: flex;
		flex-direction: column;
		height: calc(100dvh - 70px);
		max-width: 406px;
		margin: 0 auto;
	}

	.chat-header {
		flex: 0 0 auto;		/* does NOT grow or shrink */
		padding: 0px 8px 0px 8px;
		margin: -2px -10px 0px -10px;
	}

	.chat-messages {
		flex: 1;			/* grows to fill all available space */
		overflow-y: auto;	/* scrollable when messages overflow */
		flex-direction: column;
		min-height: 100px;
		padding: 4px 8px 4px 8px;
		margin: 0px -10px 0px -10px;
	}

	.chat-footer {
		flex: 0 0 auto;		/* does NOT grow or shrink */
		padding: 0px 8px 0px 8px;
		margin: 0px -10px 0px -10px;
	}

</style>



@code {

	string? errorMessage;
	string? usernameToJoin;
	bool hasRendered;

	DotNetObjectReference<ChatRoom> dotNetRef;
	TimeZoneInfo? timeZone;

	MudTextField<string>? usernameToJoinTextBox;
	ChatFooter? chatFooter;

	const string personCheck =
@"<svg xmlns=""http://www.w3.org/2000/svg"" width=""24"" height=""24"" fill=""currentColor"" class=""bi bi-person-check-fill"" viewBox=""0 0 16 16"">
  <path fill-rule=""evenodd"" d=""M15.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 0 1 .708-.708L12.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0""/>
  <path d=""M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6""/>
</svg>
";


	public ChatRoom()
	{
		dotNetRef = DotNetObjectReference.Create(this);
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			hasRendered = true;
			AppBar.Title = "Chat Room";
			timeZone = await JS.GetBrowserTimeZoneAsync();
			await JSR.InvokeVoidAsync("scrollToBottom", "messageContainer");

			HookEvents();

			if (usernameToJoinTextBox != null)
			{
				await usernameToJoinTextBox.FocusAsync();
			}
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (hasRendered)
		{
			UnHookEvents();
		}
	}

	void HookEvents()
	{
		Client.Error += OnError;
		Client.Joined += OnJoined;
		Client.Exited += OnExited;
		Client.MessageReceived += OnMessageReceived;
		Client.MembersChanged += OnMembersChanged;
		Client.Reconnecting += OnReconnecting;
	}

	void UnHookEvents()
	{
		Client.Error -= OnError;
		Client.Joined -= OnJoined;
		Client.Exited -= OnExited;
		Client.MessageReceived -= OnMessageReceived;
		Client.MembersChanged -= OnMembersChanged;
		Client.Reconnecting -= OnReconnecting;
	}

	[JSInvokable]
	public async Task OnBrowserTabClosing()
	{
		Console.WriteLine("Browser tab closed.");
		await Client.Exit();
	}

	async Task JoinChat()
	{
		errorMessage = null;

		if (!Client.IsJoining && !Client.IsJoined)
		{
			var url = NavManager.ToAbsoluteUri(ChatHub.Path);
			await Client.Join(usernameToJoin!, url.AbsoluteUri, timeZone);
		}
	}

	void OnMessageReceived(object? sender, Message message)
	{
		InvokeAsync(StateHasChanged);
		InvokeAsync(async () =>
		{
			await JSR.InvokeVoidAsync("scrollToBottom", "messageContainer");
		});
	}

	void OnMembersChanged(object? sender, List<string> list)
	{
		InvokeAsync(StateHasChanged);
	}

	void OnJoined(object? sender, EventArgs e)
	{
		if (hasRendered)
		{
			_ = JSR.InvokeVoidAsync("registerTabCloseHandler", dotNetRef);
		}
		InvokeAsync(StateHasChanged);
		chatFooter?.SetFocus();
	}

	void OnExited(object? sender, EventArgs e)
	{
		if (hasRendered)
		{
			_ = JSR.InvokeVoidAsync("unRegisterTabCloseHandler", dotNetRef);
		}
		InvokeAsync(StateHasChanged);
	}

	void OnReconnecting(object? sender, EventArgs e)
	{
		InvokeAsync(StateHasChanged);
	}

	void OnError(object? sender, string error)
	{
		_ = Client.Exit();
		errorMessage = error;
		InvokeAsync(StateHasChanged);
	}

}
