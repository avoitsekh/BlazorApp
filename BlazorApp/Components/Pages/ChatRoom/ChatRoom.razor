@page "/chat"

@inject NavigationManager NavManager
@inject AppBarOptions AppBar

@implements IAsyncDisposable

@using Microsoft.AspNetCore.SignalR.Client




@* <MudExitPrompt /> *@

<MudContainer Gutters="false" Class="d-flex justify-center mud-width-full" Style="left: 0; top:0; bottom: auto; width: 100%; height: auto">

	<MudPaper id="main-container" MaxWidth="1000px" Width="1000px" Class="pa-0" Elevation="2" Style="@($"background:{Colors.Shades.Transparent};")">
		@if (!_isChatting)
		{
			<MudStack>
				<MudTextField T="string" Label="Enter your name to start chatting" @bind-Value="_username"></MudTextField>
				<MudButton OnClick="@EnterChatAsync">Join</MudButton>
			</MudStack>
		}
		else
		{
			foreach (var message in _messages)
			{
				<MudText>@message.Username: @message.Body</MudText>
			}

			<MudStack>
				<MudTextField T="string" Label="Type your message here" Immediate @bind-Value="_newMessage"></MudTextField>
				<MudButton OnClick="@(() => SendMessageAsync(_newMessage))">Send</MudButton>
			</MudStack>
		}


@* 	<br />
	<br />

	<div class="mud-theme-info py-4 px-6 ml-20 rounded-l-xl mud-elevation-2">
		<MudText Align="Align.Center">This is a test message...<br />ddddddddddddddddd</MudText>
	</div> *@

	</MudPaper>

</MudContainer>



