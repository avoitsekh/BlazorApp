@page "/chat"

@inject NavigationManager NavManager
@inject AppBarOptions AppBar
@inject IJSRuntime JSR

@implements IAsyncDisposable


<PageTitle>Chat Room</PageTitle>

@if (!isJoined)
{
	<MudForm OnEnterPressed="JoinChat" Class="d-flex justify-center align-center" Style="height: calc(100dvh - 70px);">
		<MudPaper MaxWidth="330px" MinWidth="150px" Width="100%" Class="d-flex align-center gap-1 rounded-pill pa-1 pl-5" Elevation="1">
			<MudTextField @ref="usernameTextBox" T="string" Immediate Placeholder="Enter your name to start chatting" Underline="false" @bind-Value="newMessage.Owner" />
			@if (isJoining)
			{
				<MudProgressCircular Size="Size.Small" Color="Color.Inherit" Indeterminate="true" Class="ma-2" />
			}
			else
			{
				<MudIconButton Icon="@personCheck" Size="Size.Medium" OnClick="JoinChat"></MudIconButton>
			}
		</MudPaper>
		<MudText Color="Color.Error" Align="Align.Center" Class="mt-1">@errorMessage</MudText>
	</MudForm>
}
else
{
	<div class="chat-container">

		<div class="chat-header">
			<MudPaper Width="100%" Class="rounded-pill pa-1 pr-4" Elevation="1">

				<MudStack Row Wrap="Wrap.NoWrap" AlignItems="AlignItems.Center">
					<Avatar Username="@client?.CurrentUsername" />
					<MudText Typo="Typo.h6" Class="chat-username">@client?.CurrentUsername</MudText>
					<MudSpacer />
					<MudTooltip Arrow Color="Color.Transparent" ShowOnFocus="true" ShowOnHover="false" ShowOnClick="false" Style="font-style: italic; font-weight: normal !important;">
						<ChildContent>
							<MudText tabindex="0" Class="cursor-pointer" Align="Align.Center" Style="min-width: 46px;">@($"{chatMembers.Length} {(chatMembers.Length == 1 ? "user" : "users")} online")</MudText>
						</ChildContent>
						<TooltipContent>
							<MudPaper Class="pa-2" Style="background-color: var(--mud-palette-text-primary); color: var(--mud-palette-background);">
								<MudText>@string.Join(", ", chatMembers)</MudText>
							</MudPaper>
						</TooltipContent>
					</MudTooltip>
				</MudStack>

			</MudPaper>
		</div>

		<div class="chat-messages" id="messageContainer">
			<MudStack Spacing="1">
				@{
					Message? previousMessage = null;
					foreach (var message in messages)
					{
						<MessageBubble Message="message" PreviousMessage="previousMessage" />
						previousMessage = message;
					}
				}
			</MudStack>
		</div>

		<div class="chat-footer">
			<MudForm OnEnterPressed="OnSendMessageClicked" Style="width: 100%;">
				<MudPaper Width="100%" Class="d-flex align-center gap-1 rounded-pill pa-1 pl-5" Elevation="1">
					<MudTextField @ref="messageTextBox" T="string" Immediate Placeholder="Type your message here..." Underline="false" @bind-Value="newMessage.Body" MaxLength="2000" />
					<MudIconButton Icon="@sendMessage" Size="Size.Medium" OnClick="OnSendMessageClicked"></MudIconButton>
				</MudPaper>
			</MudForm>
		</div>

	</div>
}


<script>

	window.registerTabCloseHandler = function(dotNetHelper) {
		window.addEventListener("beforeunload", tabClosing);
		_dotNetHelper = dotNetHelper;
	}

	window.unRegisterTabCloseHandler = function(dotNetHelper) {
		window.removeEventListener("beforeunload", tabClosing);
		_dotNetHelper = null;
	}

	var _dotNetHelper;

	window.tabClosing = function(event) {
		_dotNetHelper.invokeMethodAsync("OnBrowserTabClosing");
	}

	window.scrollToBottom = (elementId) => {
		const el = document.getElementById(elementId);
		if (el) el.scrollTop = el.scrollTop = el.scrollHeight;
	}

</script>


<style>

	.chat-container {
		display: flex;
		flex-direction: column;
		height: calc(100dvh - 70px);
		max-width: 406px;
		margin: 0 auto;
	}

	.chat-header {
		flex: 0 0 auto;		/* does NOT grow or shrink */
		padding: 0px 8px 0px 8px;
		margin: -2px -10px 0px -10px;
	}

	.chat-messages {
		flex: 1;			/* grows to fill all available space */
		overflow-y: auto;	/* scrollable when messages overflow */
		flex-direction: column;
		min-height: 100px;
		padding: 4px 8px 4px 8px;
		margin: 0px -10px 0px -10px;
	}

	.chat-footer {
		flex: 0 0 auto;		/* does NOT grow or shrink */
		padding: 0px 8px 0px 8px;
		margin: 0px -10px 0px -10px;
	}

	.chat-username {
		white-space: nowrap;
		text-overflow: ellipsis;
		min-width: 40px;
		overflow: hidden;
	}

</style>



@code {

	List<Message> messages = new(30);
	Message newMessage = new();

	string? errorMessage;
	string[] chatMembers = [];
	bool hasRendered = false;
	bool isJoined = false;
	bool isJoining = false;
	ChatClient? client;
	DotNetObjectReference<ChatRoom> dotNetRef;

	MudTextField<string>? usernameTextBox;
	MudTextField<string>? messageTextBox;

	const string personCheck =
@"<svg xmlns=""http://www.w3.org/2000/svg"" width=""24"" height=""24"" fill=""currentColor"" class=""bi bi-person-check-fill"" viewBox=""0 0 16 16"">
  <path fill-rule=""evenodd"" d=""M15.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 0 1 .708-.708L12.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0""/>
  <path d=""M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6""/>
</svg>
";

	const string sendMessage =
@"<svg version=""1.1"" fill=""currentColor"" xmlns=""http://www.w3.org/2000/svg"" xmlns:xlink=""http://www.w3.org/1999/xlink"" 
	 width=""26"" height=""26"" viewBox=""3 -1 32 32"" xml:space=""preserve"">
<path class=""puchipuchi_een"" d=""M30.291,2.87l-9.581,25.26c-0.39,1.029-1.346,1.234-2.123,0.456c0,0-6.036-6.036-6.586-6.586
	s-0.359-1.631,0.425-2.403l13.316-13.11c0.784-0.772,0.711-0.856-0.163-0.187L10.588,17.784c-0.873,0.669-2.224,0.58-3.002-0.198
	l-4.172-4.172c-0.778-0.778-0.573-1.733,0.456-2.124l25.26-9.581C30.159,1.319,30.681,1.841,30.291,2.87z M8.707,20.121
	C8.318,19.732,8,19.864,8,20.414V25c0,0.55,0.386,0.768,0.857,0.485l2.401-1.441c0.472-0.283,0.539-0.833,0.15-1.222L8.707,20.121z""
	/>
</svg>
";


	public ChatRoom()
	{
		dotNetRef = DotNetObjectReference.Create(this);
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			hasRendered = true;
			AppBar.Title = "Chat Room";
			await usernameTextBox!.FocusAsync();
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (hasRendered)
		{
			await JSR.InvokeVoidAsync("unRegisterTabCloseHandler", dotNetRef);
		}
		await ExitChat();
	}

	[JSInvokable]
	public async Task OnBrowserTabClosing()
	{
		Console.WriteLine("Browser tab closed.");
		await ExitChat();
	}

	async Task JoinChat()
	{
		errorMessage = null;
		messages.Clear();

		if (!isJoining && !isJoined)
		{
			var url = NavManager.ToAbsoluteUri(ChatHub.Path);
			client = new(url.AbsoluteUri);

			client.Error += OnError;
			client.Joining += OnJoining;
			client.Joined += OnJoined;
			client.MessageReceived += OnMessageReceived;
			client.MembersChanged += OnMembersChanged;

			await client.Join(newMessage.Owner!);
			await JSR.InvokeVoidAsync("registerTabCloseHandler", dotNetRef);
		}
	}

	async Task ExitChat()
	{
		isJoining = isJoined = false;

		if (client != null)
		{
			client.Dispose();
			client = null;
		}
	}

	async Task OnSendMessageClicked()
	{
		if (client != null && isJoined && !newMessage.IsEmpty)
		{
			await client.SendMessage(newMessage);
			newMessage.Clear();
		}
	}

	void OnMessageReceived(object? sender, Message message)
	{
		message.Received = DateTime.Now;
		messages.Add(message);
		InvokeAsync(async () =>
		{
			StateHasChanged();

			// Scroll to bottom every time messages update
			await JSR.InvokeVoidAsync("scrollToBottom", "messageContainer");
		});
	}

	void OnMembersChanged(object? sender, List<string> list)
	{
		chatMembers = list.ToArray();
		InvokeAsync(StateHasChanged);
	}

	void OnJoining(object? sender, EventArgs e)
	{
		isJoining = true;
		isJoined = false;
	}

	void OnJoined(object? sender, EventArgs e)
	{
		isJoining = false;
		isJoined = true;

		InvokeAsync(StateHasChanged);
		messageTextBox!.FocusAsync();
	}

	void OnError(object? sender, string message)
	{
		_ = ExitChat();
		errorMessage = message;
		InvokeAsync(StateHasChanged);
	}
}
