<MudDialog>
	<TitleContent>
		<InfoLabel Title="Extra Payments" Class="pt-3">
			<MessageContent>
				<MudStack>
					<MudText>During the mortgage term it's possible to make extra payments (e.g. pre-payments, additional payments, lump sum payments) towards the principal balance. The extra payments can only be made on set mortgage payment dates or payment numbers. In this dialog box, add extra payments to be made during the mortgage term. See amortization schedule for dates and payment numbers.</MudText>
					<MudText><b>@Constants.Amount:</b><br />Amount to be paid.</MudText>
					<MudText><b>@Constants.BeginAtPaymentNo:</b><br />Indicate when you want extra payment(s) to begin. The extra payment(s) will start on this payment number.</MudText>
					<MudText><b>@Constants.EndAtPaymentNo:</b><br />Indicate when you want extra payment(s) to end. The extra payment(s) will end on this payment number. For single lump sum payments, make this value the same as '@Constants.BeginAtPaymentNo'. For recurring payments, make this value greater than '@Constants.BeginAtPaymentNo' or leave blank to make recurring payments made until the end of the mortgage term.</MudText>
				</MudStack>
			</MessageContent>
		</InfoLabel>
	</TitleContent>
	<DialogContent>

		<MudTable Items="Details.ExtraPayments" FixedHeader Height="230px" Dense Hover Elevation="0" Breakpoint="Breakpoint.None">
			<HeaderContent>
				<MudTh>@Constants.Amount</MudTh>
				<MudTh>@Constants.BeginAtPaymentNo</MudTh>
				<MudTh>@Constants.EndAtPaymentNo</MudTh>
				<MudTh Style="width: 60px" />
			</HeaderContent>
			<RowTemplate>
				<MudTd><MudText>@context.Amount</MudText></MudTd>
				<MudTd><MudText>@context.FromPayment</MudText></MudTd>
				<MudTd><MudText>@context.ToPayment</MudText></MudTd>
				<MudTd Style="text-align: right;">
					<MudIcon Icon="@Icons.Material.Outlined.RemoveCircleOutline" Color="Color.Primary" Class="cursor-pointer" @onclick="@(() => DeleteClicked(context))" Style="position: relative; top: 2px" />
				</MudTd>
			</RowTemplate>
		</MudTable>

		<MudButton Variant="Variant.Text" StartIcon="@(addNewExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Color="Color.Primary" Class="mt-3" OnClick="AddLumpSumClicked">Add New</MudButton>

		<MudCollapse Expanded="addNewExpanded">
			<MudForm @ref="form" Style="padding: 20px 20px 5px 20px">
				<MudStack Row>
					<MudNumericField T="double" HideSpinButtons="true" Immediate @bind-Value="payment.Amount" Label="@Constants.Amount" Variant="Variant.Text" Min="0" Max="100000000" Margin="Margin.Dense" ShrinkLabel Validation="ValidateAmount" />
					<MudNumericField T="int?" HideSpinButtons="true" Immediate @bind-Value="payment.FromPayment" Label="@Constants.BeginAtPaymentNo" Variant="Variant.Text" Min="1" Max="9999" Margin="Margin.Dense" ShrinkLabel Validation="ValidateFromPayment" />
					<MudNumericField T="int?" HideSpinButtons="true" Immediate @bind-Value="payment.ToPayment" Label="@Constants.EndAtPaymentNo" Variant="Variant.Text" Min="1" Max="9999" Margin="Margin.Dense" ShrinkLabel Validation="ValidateToPayment" />
					<MudIcon Icon="@Icons.Material.Outlined.AddCircleOutline" Color="Color.Primary" Class="cursor-pointer" @onclick="AddClicked" Style="position: relative; top: 20px" />
				</MudStack>
			</MudForm>
		</MudCollapse>

	</DialogContent>
	<DialogActions>
		<MudButton Color="Color.Primary" OnClick="CloseClicked">Close</MudButton>
	</DialogActions>
</MudDialog>



@code {

	[Parameter]
	public MortgageDetails Details { get; set; }

	[CascadingParameter]
	IMudDialogInstance MudDialog { get; set; }

	DateTime MinDate => Details.AdvanceDate.AddDays(1);

	MudForm form;
	ExtraPayment payment;
	bool addNewExpanded;

	protected async override Task OnInitializedAsync()
	{
		payment = new() { FromPayment = 1 };
	}

	void AddLumpSumClicked()
	{
		addNewExpanded = !addNewExpanded;
	}

	async Task AddClicked()
	{
		await form.ValidateAsync();

		if (form.IsValid)
		{
			Details.ExtraPayments.Add(payment.FromPayment, payment.ToPayment, payment.Amount);
		}
	}

	void DeleteClicked(ExtraPayment payment)
	{
		Details.ExtraPayments.Remove(payment);
		form.ResetValidationAsync();
	}

	void CloseClicked()
	{
		MudDialog.Close();
	}

	string ValidateFromPayment(int? fromPayment)
	{
		var result = string.Empty;
		if (!fromPayment.HasValue)
		{
			result = "Value cannot be empty";
		}
		else if (fromPayment <= 0)
		{
			result = "Value cannot be 0";
		}
		return result;
	}

	string ValidateToPayment(int? toPayment)
	{
		var result = string.Empty;
		if (toPayment <= 0)
		{
			result = "Value cannot be 0";
		}
		else if (toPayment < payment.FromPayment)
		{
			result = $"Value cannot be less than '{Constants.BeginAtPaymentNo}'";
		}
		return result;
	}

	string ValidateAmount(double amount)
	{
		var result = string.Empty;
		if (amount <= 0)
		{
			result = "Value cannot be 0";
		}
		return result;
	}

}
