@inject JSExtensionsService JS
@inject ISnackbar Snackbar


<Panel OverlayTimeout="150">
	<TitleContent>
		<InfoLabel Title="Amortization Schedule">
			<MessageContent>
				<MudStack Spacing="4">
					<MudText>Displays payment schedule for the entire mortgage term.</MudText>
					<MudText><b>@Constants.No:</b><br />Payment number.</MudText>
					<MudText><b>@Constants.PaymentDate:</b><br />The date a payment to be made.</MudText>
					<MudText><b>@Constants.Year:</b><br />Displays year for the last payment in a given year.</MudText>
					<MudText><b>@Constants.Interest:</b><br />Current annual interest rate for the payment period. For variable-rate mortgages it can show 3.5% → 3.7% signifying that the annual interest rate has changed within the payment period.</MudText>
					<MudText><b>@Constants.PaymentPeriod:</b><br />Displays date range for the current payment. The interest is accrued during this period if <i>Interest Accrual Method</i> is set to <i>Per Day</i>.</MudText>
					<MudText><b>@Constants.InterestAmount:</b><br />Interest amount portion of the '@Constants.PaymentAmount'.</MudText>
					<MudText><b>@Constants.PrincipalAmount:</b><br />Principal amount portion of the '@Constants.PaymentAmount'.</MudText>
					<MudText><b>@Constants.ExtraAmount:</b><br />Additional payment towards the principal balance.</MudText>
					<MudText><b>@Constants.PaymentAmount:</b><br />Amount to be paid to the lender. Includes interest, principal and extra payment amounts.</MudText>
					<MudText><b>@Constants.RemainingBalance:</b><br />Remaining mortgage amount to be paid off after this payment is made.</MudText>
				</MudStack>
			</MessageContent>
		</InfoLabel>
	</TitleContent>
	<HeaderContent>
		<MudStack Row Spacing="0">
			<MudIconButton Icon="@Icons.Material.Filled.ArrowDropUp" Color="Color.Inherit" OnClick="OnScrollToTopClicked" Disabled="@(!Payments.HasData())" />
			<MudIconButton Icon="@Icons.Material.Filled.ArrowDropDown" Color="Color.Inherit" OnClick="OnScrollToBottomClicked" Disabled="@(!Payments.HasData())" />
			<MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" AnchorOrigin="Origin.CenterCenter" TransformOrigin="Origin.TopRight" Disabled="@(!Payments.HasData())">
				<MudMenuItem Label="@(paymentsTableExpanded ? "Contract" : "Expand")" OnClick="OnExpandOrContractClicked" Icon="@(paymentsTableExpanded ? Icons.Material.Filled.Compress : Icons.Material.Filled.Expand)" Class="pe-6" />
				<MudDivider />
				<MudMenuItem Label="Download as Excel" OnClick="OnDownloadAsExcelClicked" Icon="@Icons.Custom.FileFormats.FileExcel" Class="pe-6" />
			</MudMenu>
		</MudStack>
	</HeaderContent>
	<MainContent>
		<MudTable @ref="table" Items="Payments" Striped Dense Hover Bordered Outlined Elevation="0" CellClass="small-cell" Virtualize="@(!paymentsTableExpanded)" 
			FixedHeader="@(!paymentsTableExpanded)" Height="@(!paymentsTableExpanded ? "500px" : null)" OverscanCount="32" ItemSize="30">
			<HeaderContent>
				<MudTh>@Constants.No</MudTh>
				<MudTh>@Constants.PaymentDate</MudTh>
				<MudTh>@Constants.Year</MudTh>
				<MudTh>@Constants.Interest</MudTh>
				<MudTh>@Constants.PaymentPeriod</MudTh>
				<MudTh Class="text-right">@Constants.InterestAmount</MudTh>
				<MudTh Class="text-right">@Constants.PrincipalAmount</MudTh>
				<MudTh Class="text-right">@Constants.ExtraAmount</MudTh>
				<MudTh Class="text-right">@Constants.PaymentAmount</MudTh>
				<MudTh Class="text-right">@Constants.RemainingBalance</MudTh>
			</HeaderContent>
			<RowTemplate>
				<MudTd DataLabel="@Constants.No">@context.Number</MudTd>
				<MudTd DataLabel="@Constants.PaymentDate">@context.PaymentDate.ToString("yyyy-MM-dd")</MudTd>
				<MudTd DataLabel="@Constants.Year">@context.Year</MudTd>
				<MudTd DataLabel="@Constants.Interest">@context.Interest</MudTd>
				<MudTd DataLabel="@Constants.PaymentPeriod">@context.PaymentPeriod</MudTd>
				<MudTd DataLabel="@Constants.InterestAmount" Class="text-right">@context.InterestAmount.ToString("N2")</MudTd>
				<MudTd DataLabel="@Constants.PrincipalAmount" Class="text-right">@context.PrincipalAmount.ToString("N2")</MudTd>
				<MudTd DataLabel="@Constants.ExtraAmount" Class="text-right">@context.ExtraAmount.ToString("N2")</MudTd>
				<MudTd DataLabel="@Constants.PaymentAmount" Class="text-right">@context.PaymentAmount.ToString("N2")</MudTd>
				<MudTd DataLabel="@Constants.RemainingBalance" Class="text-right">@context.Balance.ToString("N2")</MudTd>
			</RowTemplate>
		</MudTable>
	</MainContent>
</Panel>

<style>

	.small-cell {
		padding: 4px 12px 4px 12px !important
	}

	.text-right {
		text-align: right;
	}

</style>

@code {

	[Parameter, EditorRequired]
	public PaymentCollection Payments { get; set; }

	MudTable<Payment>? table;
	bool paymentsTableExpanded = false;


	public override Task SetParametersAsync(ParameterView parameters)
	{
		if (parameters.TryGetValue<PaymentCollection>(nameof(Payments), out var _payments) && Payments != _payments)
		{
			paymentsTableExpanded = false;
			Payments = _payments;
		}

		return base.SetParametersAsync(ParameterView.Empty);
	}

	async Task OnDownloadAsExcelClicked()
	{
		var filename = Constants.AmortizationScheduleExcelFilename;

		try
		{
			var bytes = ExportToExcel.GetByteArray(Payments);
			await JS.DownloadFileAsync(filename, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", bytes);
		}
		catch (Exception ex)
		{
			await OnDownloadError((ex, filename));
		}
	}

	async Task OnDownloadError((Exception Exception, string Filename) args)
	{
		Snackbar.Add($"Error saving to '{args.Filename}'. {args.Exception.GetBaseException().Message}", Severity.Error);
	}

	async Task OnExpandOrContractClicked()
	{
		paymentsTableExpanded = !paymentsTableExpanded;
	}

	async Task OnScrollToTopClicked()
	{
		var payment = Payments?.FirstOrDefault();
		if (payment != null)
		{
			await table!.ScrollToItemAsync(payment);
		}
	}

	async Task OnScrollToBottomClicked()
	{
		var payment = Payments?.LastOrDefault();
		if (payment != null)
		{
			await table!.ScrollToItemAsync(payment);
		}
	}

}
