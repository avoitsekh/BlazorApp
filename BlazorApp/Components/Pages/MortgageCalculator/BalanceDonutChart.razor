<MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged" />

<div style="position: relative;">
	<MudOverlay Visible="true" Absolute="true" />
	<MudChart T="double" ChartType="ChartType.Donut" ChartSeries="@([data])" ChartLabels="@labels" LegendPosition="@legendPosition" ChartOptions="@options" Width="100%" Height="180px" Class="apply-to-this-donut-chart-only pointer-events-none" />
</div>


@code {

	[Parameter, EditorRequired]
	public double? PrincipalPaid { get; set; }

	[Parameter, EditorRequired]
	public double? ExtraPaid { get; set; }

	[Parameter, EditorRequired]
	public double? InterestPaid { get; set; }

	[Parameter, EditorRequired]
	public double? RemainingBalance { get; set; }

	[CascadingParameter(Name = "*IsDarkMode*")]
	bool IsDarkMode { get; set; }

	Position legendPosition = Position.Right;

	static readonly double[] data = [0D, 0D, 0D, 0D];
	static readonly string[] labels = [Constants.PrincipalPaid, Constants.ExtraPaid, Constants.InterestPaid, Constants.RemainingBalance];
	static readonly string[] palette = [Colors.Blue.Default, Colors.Cyan.Default, Colors.Red.Lighten1, Colors.Gray.Lighten2];
	static readonly DonutChartOptions options = new()
	{
		ShowToolTips = false,
		ChartPalette = palette
	};


	protected override void OnParametersSet()
	{
		data[0] = PrincipalPaid ?? 0D;
		data[1] = ExtraPaid ?? 0D;
		data[2] = InterestPaid ?? 0D;
		data[3] = RemainingBalance ?? 0D;
		palette[3] = IsDarkMode ? Colors.Gray.Darken3 : Colors.Gray.Lighten2;
	}

	void OnBreakpointChanged(Breakpoint breakpoint)
	{
		legendPosition = breakpoint == Breakpoint.Xs ? Position.Bottom : Position.Right;
	}

}
