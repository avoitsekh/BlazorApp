<MudPaper Class="pa-6" Height="100%">
	<MudStack Breakpoint="Breakpoint.None" Spacing="4">
		<MudStack Row Wrap="Wrap.NoWrap" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="me-n3">
			<MudText Typo="Typo.h5">@Title</MudText>
			@HeaderContent
		</MudStack>
		@MainContent
	</MudStack>
</MudPaper>

@code {

	[Parameter]
	public string? Title { get; set; }

	[Parameter]
	public RenderFragment? HeaderContent { get; set; }

	[Parameter]
	public RenderFragment? MainContent { get; set; }

}
