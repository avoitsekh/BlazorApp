<MudPaper Class="pa-6" Height="100%">
	<MudStack Breakpoint="Breakpoint.None" Spacing="4">
		<MudStack Row Wrap="Wrap.NoWrap" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="me-n3">
			@if (TitleContent != null)
			{
				@TitleContent
			}
			else
			{
				<MudText Typo="Typo.h5">@Title</MudText>
			}
			@HeaderContent
		</MudStack>
		<div style="position: relative;">
			<MudOverlay Visible="@showOverlay" Absolute="true" Style="background-color: var(--mud-palette-surface); transition: none;">
				@OverlayContent
			</MudOverlay>
			@MainContent
		</div>
	</MudStack>
</MudPaper>

@code {

	[Parameter]
	public RenderFragment? HeaderContent { get; set; }

	[Parameter]
	public RenderFragment? TitleContent { get; set; }

	[Parameter]
	public RenderFragment? MainContent { get; set; }

	[Parameter]
	public RenderFragment? OverlayContent { get; set; }

	[Parameter]
	public string? Title { get; set; }

	[Parameter]
	public int OverlayTimeout { get; set; } = 0;

	bool showOverlay = false;
	Action? debounceHideOverlay = null;

	protected override void OnInitialized()
	{
		if (OverlayTimeout > 0)
		{
			showOverlay = true;
			debounceHideOverlay = new Action(HideOverlay).Debounce(OverlayTimeout);
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			debounceHideOverlay?.Invoke();
		}
	}

	void HideOverlay()
	{
		showOverlay = false;
		InvokeAsync(StateHasChanged);
	}

}
