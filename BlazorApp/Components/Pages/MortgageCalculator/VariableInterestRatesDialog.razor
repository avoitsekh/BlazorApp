<MudDialog>
	<TitleContent>
		<InfoLabel Title="Variable Interest Rates" Class="pt-3">
			<MessageContent>
				<MudStack>
					<MudText>For variable rate mortgages (ARM and VRM), interest rate changes during the mortgage term. In this dialog box, add interest rates that differ from the initial @Constants.AnnualPercent.</MudText>
					<MudText><b>@Constants.EffectiveDate:</b><br />The date the new interest rate takes effect. The value cannot be equal or less than the @Constants.AdvanceDate.</MudText>
					<MudText><b>@Constants.AnnualPercent:</b><br />The new interest rate.</MudText>
				</MudStack>
			</MessageContent>
		</InfoLabel>
	</TitleContent>
	<DialogContent>

		<MudTable Items="Details.InterestRates.Skip(1)" FixedHeader Height="230px" Dense Hover Elevation="0" Breakpoint="Breakpoint.None">
			<HeaderContent>
				<MudTh>@Constants.EffectiveDate</MudTh>
				<MudTh>@Constants.AnnualPercent</MudTh>
				<MudTh Style="width: 60px" />
			</HeaderContent>
			<RowTemplate>
				<MudTd><MudText>@(context.EffectiveDate.HasValue ? context.EffectiveDate.Value.ToString("yyyy-MM-dd") : "")</MudText></MudTd>
				<MudTd><MudText>@context.Rate.ToString("0.##'%'")</MudText></MudTd>
				<MudTd Style="text-align: right;">
					<MudIcon Icon="@Icons.Material.Outlined.RemoveCircleOutline" Color="Color.Primary" Class="cursor-pointer" @onclick="@(() => DeleteClicked(context.EffectiveDate))" Style="position: relative; top: 2px" />
				</MudTd>
			</RowTemplate>
		</MudTable>

		<MudButton Variant="Variant.Text" StartIcon="@(addNewExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Color="Color.Primary" Class="mt-3" OnClick="AddNewClicked">Add New</MudButton>

		<MudCollapse Expanded="addNewExpanded">
			<MudForm @ref="form" Style="padding: 20px 20px 5px 20px">
				<MudStack Row>
					<MudDatePicker Label="@Constants.EffectiveDate" @bind-Date="interest.EffectiveDate" Editable="true" DateFormat="yyyy-MM-dd" Placeholder="yyyy-mm-dd" Variant="Variant.Text"
						Margin="Margin.Dense" Validation="ValidateEffectiveDate" MinDate="MinDate" OpenTo="OpenTo.Month" ShowToolbar="false" />
					<MudNumericField T="double" HideSpinButtons="true" Immediate @bind-Value="interest.Rate" Label="@Constants.AnnualPercent" Variant="Variant.Text" Min="0" Max="100" Format="0.##" Margin="Margin.Dense"
						Validation="ValidateRate" />
					<MudIcon Icon="@Icons.Material.Outlined.AddCircleOutline" Color="Color.Primary" Class="cursor-pointer" @onclick="AddClicked" Style="position: relative; top: 20px" />
				</MudStack>
			</MudForm>
		</MudCollapse>

	</DialogContent>
	<DialogActions>
		<MudButton Color="Color.Primary" OnClick="CloseClicked">Close</MudButton>
	</DialogActions>
</MudDialog>



@code {

	[Parameter]
	public MortgageDetails? Details { get; set; }

	[CascadingParameter]
	IMudDialogInstance? MudDialog { get; set; }

	DateTime MinDate => Details?.AdvanceDate.AddDays(1) ?? DateTime.MinValue;

	MudForm? form;
	Interest? interest;
	bool addNewExpanded;

	protected async override Task OnInitializedAsync()
	{
		interest = new();

		var lastDateAdded = Details.InterestRates.Last().EffectiveDate;
		interest.EffectiveDate = lastDateAdded.HasValue ? lastDateAdded.Value.AddDays(1) : MinDate;
		interest.Rate = 0D;
	}

	void AddNewClicked()
	{
		addNewExpanded = !addNewExpanded;
	}

	async Task AddClicked()
	{
		await form.ValidateAsync();

		if (form.IsValid)
		{
			Details.InterestRates.Add(interest.EffectiveDate, interest.Rate);
		}
	}

	void DeleteClicked(DateTime? effectiveDate)
	{
		Details.InterestRates.RemoveAt(effectiveDate);
		form.ResetValidationAsync();
	}

	void CloseClicked()
	{
		MudDialog.Close(DialogResult.Ok(Details.InterestRates.Count));
	}

	string ValidateRate(double rate)
	{
		var result = Details.ValidateInterestRate(rate);
		if (string.IsNullOrEmpty(result))
		{
			if (Details.InterestRates.GetRate(interest.EffectiveDate.Value) == rate)
			{
				result = $"There is already a rate of {rate}% in the list that is effective on (or before) {interest.EffectiveDate:yyyy-MM-dd}";
			}
		}
		return result;
	}

	string ValidateEffectiveDate(DateTime? effectiveDate)
	{
		var result = string.Empty;
		if (!effectiveDate.HasValue)
		{
			result = "Value cannot be empty";
		}
		else if (effectiveDate < MinDate)
		{
			result = "Value cannot be less (or equal to) Advance Date";
		}
		else if (Details.InterestRates.Any(x => x.EffectiveDate == effectiveDate))
		{
			result = "Interest rate with such date already exists in the list";
		}
		return result;
	}


}
