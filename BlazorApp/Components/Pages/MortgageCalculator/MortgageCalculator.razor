@page "/mortgage"

@using System.Text
@using System.Text.Json

@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject JSExtensionsService JS

<PageTitle>Mortgage Calculator</PageTitle>
<MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged" />

<MudContainer Gutters="false" Class="d-flex justify-center mud-width-full pt-4">
	<MudPaper id="main-container" MaxWidth="1000px" Width="1000px" Class="pa-0" Elevation="0" Style="@($"background:{Colors.Shades.Transparent};")">
		<MudStack id="main-stack">

			<CascadingValue Value="@payments" Name="&Payments">
			<CascadingValue Value="@paymentsNoExtras" Name="&PaymentsNoExtras">
			<CascadingValue Value="@stats">

			<MudGrid Spacing="3"> <!-- Grid for Mortgage Details and Summary panels -->
				<MudItem xs="12" md="4">
					<Panel>
						<TitleContent>
							<InfoLabel Title="Mortgage Details">
								<MessageContent>
									<MudStack Spacing="4">
										<MudText>This mortgage calculator helps evaluate how adding extra payments can save on interest and shorten the mortgage term. It supports many options, fixed and variable interest rates and projects payment (amortization) schedule.</MudText>
										<MudText><b>@Constants.LoanAmount:</b><br />The amount that is borrowed, not the sale price of the home.</MudText>
										<MudText><b>@Constants.AnnualPercent:</b><br />The annual interest rate quoted by the lender. For variable-rate mortgages click on the <MudIcon Icon="@Icons.Material.Filled.Percent" Class="text-icon" /> icon to add variable interest rates.</MudText>
										<MudText><b>@Constants.AmortizationPeriod:</b><br />The total number of years it will take to pay off the mortgage. Typical values: 30, 25, 20, 15.</MudText>
										<MudText><b>@Constants.AdvanceDate:</b><br />The date mortgage funds are released by the lender. In other words, mortgage start date.</MudText>
										<MudText><b>@Constants.CompoundPeriod:</b><br />The number of times per year that the quoted annual interest rate is compounded.
											<ul>
												<li>Semi-Annually: 2 times per year (mostly applies to Canadian Mortgages)</li>
												<li>Monthly: 12 times per year (mostly applies to US Mortgages)</li>
												<li>Annually: 1 time per year</li>
											</ul>
										</MudText>
										<MudText><b>@Constants.PaymentFrequency:</b><br />Determines the number of payments per year.
											<ul>
												<li>Monthly: 12 times per year</li>
												<li>Semi-Monthly: 24 times per year (2 times per month)</li>
												<li>Weekly: 52 times per year (once a week)</li>
												<li>Bi-Weekly: 26 times per year (once every two weeks)</li>
												@* <li>Acc Weekly: 52 times per year, including a predefined extra payment. An Accelerated Weekly payment is 1/4 the normal Monthly payment.</li>
												<li>Acc Bi-Weekly: 26 times per year, including a predefined extra payment. An Accelerated Bi-Weekly payment is 1/2 the normal Monthly payment.</li> *@
											</ul>
										</MudText>
										<MudText><b>@Constants.InterestAccrualMethod:</b><br />Determines whether interest rate is calculated on a daily basis or per payment. If per payment option is chosen, the @Constants.AnnualPercent is divided by the number of payments per year (@Constants.PaymentFrequency).</MudText>
										<MudText><b>@Constants.FinancialYear:</b><br />Determines how many days in a given year there is to calculate daily interest. Some lenders do not bother with normal and leap years and calculate interest based on 360 days.</MudText>
										<MudText><b>@Constants.RateType:</b><br />Determines whether mortgage interest changes during the mortgage term or not.
											<ul>
												<li>Fixed: Interest rate does not change throughout the mortgage term.</li>
												<li>ARM: Adjustable Rate Mortgage, a type of variable-rate mortgage with payment amounts adjusting based on fluctuations in the lender's prime rate.</li>
												<li>VRM: Variable Rate Mortgage, a type of variable-rate mortgage with fixed payment amounts throughout the term. When the lender's prime rate changes, the mortgage payment amount stays the same, but the interest portion of that payment can go up or down depending on 
													the prime rate fluctuations. If the prime rate has risen significantly, it might be required to make extra payments or refinance to avoid negative amortization.</li>
											</ul>
										</MudText>
										<MudText><b>@Constants.ExtraPayments:</b><br />Option to add additional payments to the mortgage principal balance in a form of lump sum or recurring payments. Click on the <MudIcon Icon="@Icons.Material.Outlined.AttachMoney" Class="text-icon" /> icon to add extra payments.</MudText>
									</MudStack>
								</MessageContent>
							</InfoLabel>
						</TitleContent>
						<HeaderContent>
							<MudFileUpload T="IBrowserFile" Accept=".json,.*" OnFilesChanged="OnDetailsLoadClicked">
								<CustomContent>
									<MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" AnchorOrigin="Origin.TopLeft" TransformOrigin="Origin.TopRight">
										<MudMenu Label="Presets" StartIcon="@Icons.Material.Filled.Tune">
											@foreach (var keyValuePair in presets)
											{
												<MudMenuItem Label="@keyValuePair.Key" Icon="@Icons.Material.Outlined.CheckCircle" IconColor="Color.Info" OnClick="@(() => OnPresetChanged(keyValuePair.Key, keyValuePair.Value))" />
											}
										</MudMenu>
										<MudDivider />
										<MudMenuItem Label="Load..." OnClick="@context.OpenFilePickerAsync" Icon="@Icons.Material.Filled.OpenInBrowser" />
										<MudMenuItem Label="Save..." OnClick="OnDetailsSaveClicked" Icon="@Icons.Material.Filled.Save" />
									</MudMenu>
								</CustomContent>
								<SelectedTemplate />
							</MudFileUpload>
						</HeaderContent>
						<MainContent>
							<MudForm @ref="form" Spacing="4">
								<MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Stretch" StretchItems="StretchItems.All">
									<MudGrid Spacing="6">

										<MudItem xs="6" sm="3" md="6">
											<MudNumericField T="double" HideSpinButtons="true" @bind-Value="details.LoanAmount" Label="@Constants.LoanAmount" Variant="Variant.Text" Min="0" Max="1000000000" FullWidth Format="@MortgageDetails.ConditionalFormat(details.LoanAmount)"
												Validation="ValidateLoanAmount" Margin="Margin.Dense" />
										</MudItem>

										<MudItem xs="6" sm="3" md="6">
											<MudNumericField T="double" HideSpinButtons="true" @bind-Value="details.InterestRates.InitialRate" Label="@Constants.AnnualPercent" Variant="Variant.Text" Min="0" Max="100" FullWidth Format="0.##" Margin="Margin.Dense"
												Adornment="@(details.IsVariableRateMortgage ? Adornment.End : Adornment.None)" AdornmentIcon="@Icons.Material.Filled.Percent" AdornmentColor="@(details.InterestRates.HasAdditionalInterestRates ? Color.Error : Color.Default)" OnAdornmentClick="OpenVariableInterestRatesDialogAsync"
												Validation="ValidateInterestRate" />
										</MudItem>

										<MudItem xs="6" sm="3" md="6">
											<MudNumericField T="int" HideSpinButtons="true" @bind-Value="details.AmortizationPeriod" Label="@Constants.AmortizationPeriod" Variant="Variant.Text" Min="0" Max="100" FullWidth Margin="Margin.Dense" Validation="ValidateAmortizationPeriod" />
										</MudItem>

										<MudItem xs="6" sm="3" md="6">
											<MudDatePicker Label="@Constants.AdvanceDate" Editable="true" @bind-Date="AdvanceDateNullable" DateFormat="yyyy-MM-dd" Placeholder="yyyy-mm-dd" Variant="Variant.Text" OpenTo="OpenTo.Month" ShowToolbar="false" MinDate="new DateTime(1900, 01, 01)" Margin="Margin.Dense"
												Validation="ValidateAdvanceDate" />
										</MudItem>

										<MudItem xs="6" sm="3" md="6">
											<MudSelect T="int" Label="@Constants.CompoundPeriod" @bind-Value="details.CompoundPeriod" Variant="Variant.Text" Margin="Margin.Dense" AdornmentColor="Color.Inherit">
												@foreach (var keyValuePair in Constants.CompoundPeriodValues)
												{
													<MudSelectItem T="int" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
												}
											</MudSelect>
										</MudItem>

										<MudItem xs="6" sm="3" md="6">
											<MudSelect T="int" Label="@Constants.PaymentFrequency" @bind-Value="details.PaymentFrequency" Variant="Variant.Text" Margin="Margin.Dense" AdornmentColor="Color.Inherit">
												@foreach (var keyValuePair in Constants.PaymentFrequencyValues)
												{
													<MudSelectItem T="int" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
												}
											</MudSelect>
										</MudItem>

										<MudItem xs="6" sm="3" md="6">
											<MudSelect T="MortgageDetails.InterestAccrualMethods" Label="@Constants.InterestAccrualMethod" @bind-Value="details.InterestAccrualMethod" Variant="Variant.Text" Margin="Margin.Dense" AdornmentColor="Color.Inherit">
												@foreach (var keyValuePair in Constants.InterestAccrualMethodValues)
												{
													<MudSelectItem T="MortgageDetails.InterestAccrualMethods" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
												}
											</MudSelect>
										</MudItem>

										<MudItem xs="6" sm="3" md="6">
											<MudSelect T="MortgageDetails.FinancialYears" Label="@Constants.FinancialYear" @bind-Value="details.FinancialYear" Variant="Variant.Text" Margin="Margin.Dense" AdornmentColor="Color.Inherit"
												Disabled="@(details.InterestAccrualMethod != MortgageDetails.InterestAccrualMethods.PerDay)">
												@foreach (var keyValuePair in Constants.FinancialYearValues)
												{
													<MudSelectItem T="MortgageDetails.FinancialYears" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
												}
											</MudSelect>
										</MudItem>

										<MudItem xs="6" sm="3" md="6">
											<MudSelect T="MortgageDetails.InterestRateTypes" Label="@Constants.RateType" @bind-Value="details.InterestRateType" @bind-Value:after="OnInterestRateTypeChanged" Variant="Variant.Text" Margin="Margin.Dense"  AdornmentColor="Color.Inherit">
												@foreach (var keyValuePair in Constants.InterestRateTypeValues)
												{
													<MudSelectItem T="MortgageDetails.InterestRateTypes" Value="@keyValuePair.Value">@keyValuePair.Key</MudSelectItem>
												}
											</MudSelect>
										</MudItem>

										<MudItem xs="6" sm="3" md="6">
											<MudTextField T="string" Label="@Constants.ExtraPayments" Variant="Variant.Text" Margin="Margin.Dense" ReadOnly Value="@ExtraPaymentsFieldDescription" ShrinkLabel
												AdornmentIcon="@Icons.Material.Outlined.AttachMoney" AdornmentColor="@(details.ExtraPayments.HasExtraPayments ? Color.Error : Color.Default)" Adornment="Adornment.End" OnAdornmentClick="OpenExtraPaymentsDialogAsync" />
										</MudItem>

									</MudGrid>
								</MudStack>
								<MudButton Variant="Variant.Filled" OnClick="Calculate" Size="Size.Large" Color="Color.Dark">Calculate</MudButton>
							</MudForm>
						</MainContent>
					</Panel>
				</MudItem>

				<MudItem xs="12" md="8">
					<Panel>
						<TitleContent>
							<InfoLabel Title="@(currentPage == 0 ? "Summary" : "Statistics")">
								<MessageContent>
									<MudStack Spacing="4">
										<MudText>Page 1 displays an overall summary about the mortgage and page 2 displays various statistics for a given year.</MudText>
										@if (currentPage == 0)
										{
											<MudText><b>@Constants.PaymentAmount:</b><br />Initial payment to be made when mortgage starts.</MudText>
											<MudText><b>@Constants.InterestAmount:</b><br />Interest portion of the initial payment amount.</MudText>
											<MudText><b>@Constants.PrincipalAmount:</b><br />Principal portion of the initial payment amount.</MudText>
											<MudText><b>@Constants.EffectiveAnnualRate:</b><br />Or EAR, is the interest rate that is adjusted for compounding over a given period. This is the real interest rate on the mortgage which differs from the nominal rate quoted by the lender. 
												Other names might be effective interest rate (EIR), effective annual interest rate (EAIR), annual equivalent rate (AER) or simply effective rate.</MudText>
											<MudText><b>@Constants.AmortizationReduction:</b><br />Displays reduction in percentage value on overall mortgage term implying on how much faster the mortgage can be paid off. Typically equals to 0% if no extra payments are made.</MudText>
											<MudText><b>@Constants.YearsToPayoff:</b><br />Displays number of years until the mortgage is fully paid off. Typically equals to an amortization period if no extra payments are made.</MudText>
										}
										else
										{
											<MudText><b>@Constants.LastPaymentDate:</b><br />The date of the last payment of the given year.</MudText>
											<MudText><b>@Constants.NumberOfPayments:</b><br />The number of payments made since the mortgage start date and the end of the given year.</MudText>
											<MudText><b>@Constants.PrincipalPaid:</b><br />Total principal amount paid since the mortgage start date until the end of the given year.</MudText>
											<MudText><b>@Constants.InterestPaid:</b><br />Total interest amount paid since the mortgage start date until the end of the given year.</MudText>
											<MudText><b>@Constants.ExtraPaid:</b><br />Total amount of all extra payments made since the mortgage start date until the end of the given year.</MudText>
											<MudText><b>@Constants.TotalPaid:</b><br />Total amount paid since the mortgage start date until the end of the given year. The amount includes interest amount, principal amount and all the extra payments made.</MudText>
											<MudText><b>@Constants.InterestSavings:</b><br />Total amount saved in interest since the mortgage start date until the end of the given year. This amount will be 0 if there are no extra payments.</MudText>
											<MudText><b>@Constants.RemainingBalance:</b><br />Remaining mortgage amount to be paid off since the given year.</MudText>
										}
									</MudStack>
								</MessageContent>
							</InfoLabel>
						</TitleContent>
						<HeaderContent>
							<MudStack Row Wrap="Wrap.NoWrap" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
								<MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowLeft" Disabled="@(currentPage == 0)" OnClick="@(() => currentPage--)" />
								<MudText Typo="Typo.body2">@(currentPage + 1) / 2</MudText>
								<MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowRight" Disabled="@(currentPage == 1)" OnClick="@(() => currentPage++)" />
							</MudStack>
						</HeaderContent>
						<MainContent>
							<MudCarousel Style="@($"min-height: {summaryPageHeight};")" @bind-SelectedIndex="currentPage" ShowArrows="false" ShowBullets="false" AutoCycle="false" TData="object">
								<MudCarouselItem Transition="Transition.Slide" Class="animation-duration">
									<MudGrid Spacing="0">
										<MudItem xs="6" sm="4" Class="order-1 order-sm-1">
											<DataField T="double" Label="@Constants.PaymentAmount" Value="@stats.PaymentAmount" Format="N2" />
										</MudItem>
										<MudItem xs="6" sm="4" Class="order-3 order-sm-2">
											<DataField T="double" Label="@Constants.InterestAmount" Value="@stats.InterestAmount" Format="N2" />
										</MudItem>
										<MudItem xs="6" sm="4" Class="order-4 order-sm-3">
											<DataField T="double" Label="@Constants.AmortizationReduction" Value="@stats.AmortizationOffset" Format="+#'%';-#'%';0'%'" />
										</MudItem>
										<MudItem xs="6" sm="4" Class="order-2 order-sm-4">
											<DataField T="double" Label="@Constants.EffectiveAnnualRate" Value="@stats.EffectiveAnnualRate" Format="0.##'%'" />
										</MudItem>
										<MudItem xs="6" sm="4" Class="order-5 order-sm-5">
											<DataField T="double" Label="@Constants.PrincipalAmount" Value="@stats.PrincipalAmount" Format="N2" />
										</MudItem>
										<MudItem xs="6" sm="4" Class="order-6 order-sm-6">
											<DataField T="double" Label="@Constants.YearsToPayoff" Value="@stats.YearsToPayOff" />
										</MudItem>
									</MudGrid>
									<BalanceLineChart DebounceInterval="60" />
								</MudCarouselItem>
								<MudCarouselItem Transition="Transition.Slide" Class="animation-duration">
									<MudStack Spacing="8">
										<MudGrid Spacing="0">
											<MudItem xs="6" sm="4" md="3">
												<DataField T="DateTime" Label="@Constants.LastPaymentDate" Value="@stats.LastPaymentDate" Format="yyyy-MM-dd" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="@Constants.PrincipalPaid" Value="@stats.PrincipalPaid" Format="N2" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="@Constants.InterestPaid" Value="@stats.InterestPaid" Format="N2" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="@Constants.InterestSavings" Value="@stats.InterestSavings" Format="N2" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="@Constants.NumberOfPayments" Value="@stats.NumberOfPayments" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="@Constants.ExtraPaid" Value="@stats.ExtraPaid" Format="N2" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="@Constants.TotalPaid" Value="@stats.TotalPaid" Format="N2" />
											</MudItem>
											<MudItem xs="6" sm="4" md="3">
												<DataField T="double" Label="@Constants.RemainingBalance" Value="@stats.RemainingBalance" Format="N2" />
											</MudItem>
										</MudGrid>
										<MudStack Row Spacing="1" Justify="Justify.Center" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Breakpoint="Breakpoint.Xs">
											<YearField @ref="yearField" MaxYear="BalanceMaxYear" YearChanged="OnYearChanged" />
											<BalanceDonutChart />
										</MudStack>
									</MudStack>
								</MudCarouselItem>
							</MudCarousel>
						</MainContent>
					</Panel>
				</MudItem>
			</MudGrid>

			<Panel>
				<TitleContent>
					<InfoLabel Title="Amortization Schedule">
						<MessageContent>
							<MudStack Spacing="4">
								<MudText>Displays payment schedule for the entire mortgage term.</MudText>
								<MudText><b>@Constants.No:</b><br />Payment number.</MudText>
								<MudText><b>@Constants.PaymentDate:</b><br />The date a payment to be made.</MudText>
								<MudText><b>@Constants.Year:</b><br />Displays year for the last payment in a given year.</MudText>
								<MudText><b>@Constants.Interest:</b><br />Current annual interest rate for the payment period. For variable-rate mortgages it can show 3.5% → 3.7% signifying that the annual interest rate has changed within the payment period.</MudText>
								<MudText><b>@Constants.InterestAccrualPeriod:</b><br />For 'Per Day' interest accrual method, displays date range during which interest rate is accrued, otherwise displays annual interest rate divided by a number of payments in a given year.</MudText>
								<MudText><b>@Constants.InterestAmount:</b><br />Interest amount portion of the '@Constants.PaymentAmount'.</MudText>
								<MudText><b>@Constants.PrincipalAmount:</b><br />Principal amount portion of the '@Constants.PaymentAmount'.</MudText>
								<MudText><b>@Constants.ExtraAmount:</b><br />Additional payment towards the principal balance.</MudText>
								<MudText><b>@Constants.PaymentAmount:</b><br />Amount to be paid to the lender. Includes interest, principal and extra payment amounts.</MudText>
								<MudText><b>@Constants.RemainingBalance:</b><br />Remaining mortgage amount to be paid off after this payment is made.</MudText>
							</MudStack>
						</MessageContent>
					</InfoLabel>
				</TitleContent>
				<HeaderContent>
					<MudStack Row Spacing="0">
						<MudIconButton Icon="@Icons.Material.Filled.ArrowDropUp" Color="Color.Inherit" OnClick="OnScrollToTopClicked" Disabled="@(!payments.HasData())" />
						<MudIconButton Icon="@Icons.Material.Filled.ArrowDropDown" Color="Color.Inherit" OnClick="OnScrollToBottomClicked" Disabled="@(!payments.HasData())" />
						<MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" AnchorOrigin="Origin.TopLeft" TransformOrigin="Origin.TopRight" Disabled="@(!payments.HasData())">
							<MudMenuItem Label="@(paymentsTableExpanded ? "Contract" : "Expand")" OnClick="OnExpandOrContractClicked" Icon="@(paymentsTableExpanded ? Icons.Material.Filled.Compress : Icons.Material.Filled.Expand)" Class="pe-6" />
							<MudDivider />
							<MudMenuItem Label="Download as Excel" OnClick="OnDownloadAsExcelClicked" Icon="@Icons.Custom.FileFormats.FileExcel" Class="pe-6" />
						</MudMenu>
					</MudStack>
				</HeaderContent>
				<MainContent>
					<PaymentsTable @ref="paymentsTable" Expanded="paymentsTableExpanded" />
				</MainContent>
			</Panel>

			</CascadingValue>
			</CascadingValue>
			</CascadingValue>

		</MudStack>
	</MudPaper>

</MudContainer>

<style>
	.animation-duration {
		animation-duration: .3s;
	}

	.mud-swipearea {
		touch-action: pan-y;
	}

	.text-icon {
		margin-top: -8px;
		position: relative;
		top: 4px;
	}

	ul {
		padding-left: 26px;
	}
</style>
	


@code {

	MudForm? form = null;
	YearField? yearField = null;
	PaymentsTable? paymentsTable = null;

	MortgageDetails details = new();
	PresetCollection presets = new();
	PaymentStatistics stats = new();
	PaymentCollection? payments;
	PaymentCollection? paymentsNoExtras;

	int currentPage = 0;
	bool paymentsTableExpanded = false;
	string summaryPageHeight = summaryPageHeightForSmAndUp;

	const string summaryPageHeightForSmAndUp = "400px";
	const string summaryPageHeightForXs = "580px";
	const string extraPaymentsNoDescription = "None";
	const int maxUploadFileSize = 4 * 1024;  // 4 KB

	int BalanceMaxYear => payments?.Max(x => x.Year) ?? 1;

	DateTime? AdvanceDateNullable
	{   // Workaround for MudDatePicker requiring DateTime? instead of DateTime
		get => details.AdvanceDate != DateTime.MinValue ? details.AdvanceDate : null;
		set => details.AdvanceDate = value.HasValue ? value.Value : DateTime.MinValue;
	}

	string ExtraPaymentsFieldDescription
	{
		get
		{
			if (details.ExtraPayments.Count == 0)
			{
				return extraPaymentsNoDescription;
			}

			var list = new List<string>(10);
			list.AddRange(details.ExtraPayments.LumpSums.Select(x => Format(x.Amount)));
			list.AddRange(details.ExtraPayments.Recurring.Select(x => Format(x.Amount, "+")));
			return string.Join(" ", list);

			string Format(double value, string suffix = default)
			{
				return string.Format("({0:" + MortgageDetails.ConditionalFormat(value) + "}" + suffix + ")", value);
			}
		}
	}


	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await Calculate();
		}
	}

	async Task Calculate()
	{
		await form!.ValidateAsync();

		if (form.IsValid)
		{
			paymentsTableExpanded = false;

			payments = PaymentCollection.Create(details);
			paymentsNoExtras = payments.HasExtraPayments ? PaymentCollection.Create(details, countExtraPayments: false) : null;

			stats = new(payments, paymentsNoExtras);
			stats.CalculateSummary();
			stats.CalculateForYear(yearField?.Value ?? 0);
		}
	}

	#region Events

	async Task OnInterestRateTypeChanged()
	{
		if (details.InterestRateType == MortgageDetails.InterestRateTypes.Fixed)
		{
			details.InterestRates.Clear();
			StateHasChanged();
		}
	}

	async Task OnDetailsLoadClicked(InputFileChangeEventArgs arg)
	{
		var file = arg.File;
		var error = string.Empty;

		if (file != null)
		{
			try
			{
				if (file.Size > maxUploadFileSize)
				{
					throw new Exception($"File exceeds maximum allowed size of {maxUploadFileSize} bytes.");
				}

				using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: maxUploadFileSize));
				string jsonText = await reader.ReadToEndAsync();
				details = JsonSerializer.Deserialize<MortgageDetails>(jsonText, new JsonSerializerOptions { IncludeFields = true, WriteIndented = true });

				await Calculate();
			}
			catch (JsonException)
			{
				error = "File appears to be corrupted or invalid.";
			}
			catch (Exception ex)
			{
				error = ex.GetBaseException().Message;
			}
			finally
			{
				if (error != string.Empty)
				{
					Snackbar.Add($"Error loading from '{file.Name}'. {error}", Severity.Error);
				}
				else
				{
					Snackbar.Add($"Successfully loaded from '{file.Name}'", Severity.Success);
				}
			}
		}
	}

	async Task OnDetailsSaveClicked()
	{
		var filename = Constants.MortgageDetailsSettingsFilename;

		try
		{
			var jsonText = JsonSerializer.Serialize(details, new JsonSerializerOptions { IncludeFields = true, WriteIndented = true });
			await JS.DownloadFileAsync(filename, "text/json", Encoding.UTF8.GetBytes(jsonText));
		}
		catch (Exception ex)
		{
			await OnDownloadError((ex, filename));
		}
	}

	async Task OnDownloadAsExcelClicked()
	{
		var filename = Constants.AmortizationScheduleExcelFilename;

		try
		{
			var bytes = ExportToExcel.GetByteArray(payments);
			await JS.DownloadFileAsync(filename, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", bytes);
		}
		catch (Exception ex)
		{
			await OnDownloadError((ex, filename));
		}
	}

	async Task OnDownloadError((Exception Exception, string Filename) args)
	{
		Snackbar.Add($"Error saving to '{args.Filename}'. {args.Exception.GetBaseException().Message}", Severity.Error);
	}

	async Task OnExpandOrContractClicked()
	{
		paymentsTableExpanded = !paymentsTableExpanded;
	}

	async Task OnScrollToBottomClicked()
	{
		paymentsTable?.ScrollToBottom();
	}

	async Task OnScrollToTopClicked()
	{
		paymentsTable?.ScrollToTop();
	}

	async Task OpenVariableInterestRatesDialogAsync()
	{
		var options = new DialogOptions()
		{
			MaxWidth = MaxWidth.ExtraSmall,
			BackdropClick = false,
			CloseOnEscapeKey = true
		};

		var parameters = new DialogParameters<VariableInterestRatesDialog>
		{
			{ x => x.Details, details }
		};

		var dialogReference = await DialogService.ShowAsync<VariableInterestRatesDialog>(parameters, options);
		await dialogReference.Result;

		StateHasChanged();
	}

	async Task OpenExtraPaymentsDialogAsync()
	{
		var options = new DialogOptions()
		{
			MaxWidth = MaxWidth.Medium,
			BackdropClick = false,
			CloseOnEscapeKey = true
		};

		var parameters = new DialogParameters<ExtraPaymentsDialog>
		{
			{ x => x.Details, details }
		};

		var dialogReference = await DialogService.ShowAsync<ExtraPaymentsDialog>(parameters, options);
		await dialogReference.Result;

		StateHasChanged();
	}

	async Task OnPresetChanged(string presetName, Func<MortgageDetails> preset)
	{
		details = preset();
		Snackbar.Add($"Loaded preset '{presetName}'", Severity.Success);

		await Calculate();
	}

	void OnYearChanged(int? year)
	{
		if (year.HasValue && payments.HasData())
		{
			stats.CalculateForYear(year.Value);
		}
	}

	void OnBreakpointChanged(Breakpoint breakpoint)
	{
		summaryPageHeight = breakpoint == Breakpoint.Xs ? summaryPageHeightForXs : summaryPageHeightForSmAndUp;
	}

	#endregion

	#region Validations

	Func<double, string> ValidateLoanAmount => amount => amount switch
	{
		< 1000D => "Value cannot be less than 1,000",
		_ => string.Empty
	};

	Func<double, string> ValidateInterestRate => rate => rate switch
	{
		0D => "Value cannot be 0",
		_ => string.Empty
	};

	Func<int, string> ValidateAmortizationPeriod => years => years switch
	{
		0 => "Value cannot be 0",
		_ => string.Empty
	};

	Func<DateTime?, string> ValidateAdvanceDate => date =>
		!date.HasValue || date == DateTime.MinValue ? "Value cannot be empty" : string.Empty;

	#endregion
}
