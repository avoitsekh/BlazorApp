@page "/mortgage"

@inject AppBarOptions AppBar


<PageTitle>Mortgage Calculator</PageTitle>

<MudContainer Gutters="false" Class="d-flex justify-center mud-width-full">
	<MudStack Spacing="3" Style="width: 1000px; max-width: 1000px;">
		<MudGrid Spacing="3">
			<MudItem xs="12" md="4">
				<!-- Mortgage Details Panel -->
				<MortgageDetailsPanel OnCalculated="OnCalculated" />
			</MudItem>
			<MudItem xs="12" md="8">
				<!-- Summary/Statistics Panel -->
				<SummaryPanel Payments="payments" />
			</MudItem>
		</MudGrid>
		<!-- Amortization Schedule Panel -->
		<AmortizationSchedulePanel Payments="payments" />
	</MudStack>
</MudContainer>


<style>

	.text-icon {
		margin-top: -8px;
		position: relative;
		top: 4px;
	}

	ul {
		padding-left: 26px;
	}

</style>
	


@code {

	PaymentCollection? payments;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			AppBar.Title = "Mortgage Calculator";
		}
	}

	void OnCalculated(PaymentCollection args)
	{
		payments = args;
	}

}
