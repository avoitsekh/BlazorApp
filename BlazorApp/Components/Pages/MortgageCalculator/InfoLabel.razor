
<MudStack Row Breakpoint="Breakpoint.None" Wrap="Wrap.NoWrap" Spacing="2" AlignItems="AlignItems.Center" Class="@Class">
	<MudText Typo="Typo.h5">@Title</MudText>
	<MudIcon Icon="@Icons.Material.Outlined.Info" Color="Color.Primary" Size="Size.Medium" Class="cursor-pointer" @onclick="OnInformationClicked" />
</MudStack>

<MudMessageBox @ref="messageBox" YesText="OK">
	<TitleContent>
		<MudStack Row Breakpoint="Breakpoint.None" Wrap="Wrap.NoWrap" Spacing="2" AlignItems="AlignItems.Center">
			<MudIcon Icon="@Icons.Material.Outlined.Info" Color="Color.Primary" Size="Size.Medium" />
			<MudText Typo="Typo.h6">Information</MudText>
		</MudStack>
	</TitleContent>
	<MessageContent>
		@MessageContent
	</MessageContent>
</MudMessageBox>

@code {

	[Parameter]
	public string? Title { get; set; }

	[Parameter]
	public string? Class { get; set; }

	[Parameter]
	public RenderFragment? MessageContent { get; set; }

	MudMessageBox? messageBox = null;

	async Task OnInformationClicked()
	{
		var options = new DialogOptions
		{
			Position = DialogPosition.TopCenter,
			CloseOnEscapeKey = true
		};
		await messageBox!.ShowAsync(options);
	}
}
