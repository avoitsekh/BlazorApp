@using MudBlazor.Charts

<MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged" />
<div style="position: relative;">
	<MudOverlay Visible="true" Absolute="true" Style="@overlayStyle" />
	<MudChart id="balance-line-chart" ChartType="ChartType.Line" ChartSeries="@series" ChartLabels="@XAxisLabels" Class="apply-to-this-line-chart-only pointer-events-none"
		ChartOptions="@options" Width="100%" Height="260px" MatchBoundsToSize Style="@chartStyle"  />
</div>

@code {

	[Parameter, EditorRequired]
	public PaymentCollection? Payments { get; set; }

	PaymentCollection? PaymentsNoExtras => Payments?.WithNoExtraPayments;

	const string chartStyleForXs = "padding: 40px 0px 0px 0px;";
	const string chartStyleForSmAndUp = "padding: 10px 20px 0px 20px;";
	static readonly LineChartOptions options = new ()
	{
		XAxisTitle = "Balance",
		YAxisTitle = "",
		YAxisFormat = "N0",
		XAxisLabelRotation = 45,
		ChartPalette = [Colors.Blue.Default, Colors.Cyan.Default],
		ShowLegend = false,
		ShowToolTips = false,
	};


	List<ChartSeries<double>> series = [];
	string[] XAxisLabels = [];
	string chartStyle = chartStyleForSmAndUp;
	string overlayStyle = "background-color: var(--mud-palette-surface); transition: none; height: 120%;";


	protected override bool ShouldRender()
	{
		return Payments.HasData() && base.ShouldRender();
	}

	protected override void OnAfterRender(bool firstRender)
	{
		if (firstRender)
		{
			new Action(() => InvokeAsync(HideOverlay)).Debounce(800).Invoke();
		}
	}

	public override async Task SetParametersAsync(ParameterView parameters)
	{
		if (parameters.TryGetValue<PaymentCollection>(nameof(Payments), out var _payments) && Payments != _payments)
		{
			Payments = _payments;
			Draw();
		}
	}

	void HideOverlay()
	{
		overlayStyle = string.Empty;
		StateHasChanged();
	}

	void Draw()
	{
		SetGraphValues();
		SetXAxisLabels();
		SetYAxisLabels();
		StateHasChanged();
	}

	void SetGraphValues()
	{
		series = new();

		if (PaymentsNoExtras.HasData())
		{
			series.Add(new()
			{
				Name = "Without extra payments",
				Data = PaymentsNoExtras!.Select(x => x.Balance).ToArray(),
			});
		}

		series.Add(new()
		{
			Name = "With extra payments",
			Data = Payments!.Select(x => x.Balance).ToArray(),
		});

		options.ShowLegend = series.Count > 1;
		options.SeriesDisplayOverrides = new Dictionary<IChartSeries, SeriesDisplayOverride>(series.Count);
		series.ForEach(x => options.SeriesDisplayOverrides.Add(x, new() { LineDisplayType = LineDisplayType.Area, FillOpacity = 0.15 }));
	}

	void SetXAxisLabels()
	{
		var payments = PaymentsNoExtras.HasData() ? PaymentsNoExtras : Payments;
		var amortizationPeriodInYears = payments!.Max(x => x.Year);
		var denominator = amortizationPeriodInYears switch
		{
			<= 5 => 1,
			<= 60 => 5,
			_ => 10
		};
		XAxisLabels = payments!.Select(x => x.Year.HasValue && x.Year % denominator == 0 ? x.PaymentDate.Year.ToString() : string.Empty).ToArray();
	}

	void SetYAxisLabels()
	{
		var loanAmount = Payments!.Details.LoanAmount;
		options.YAxisTicks = loanAmount switch
		{
			<= 1000 => 100,
			<= 2000 => 250,
			<= 10000 => 1000,
			<= 50000 => 5000,
			<= 100000 => 10000,
			<= 500000 => 50000,
			<= 1000000 => 100000,
			_ => 250000
		};
	}

	void OnBreakpointChanged(Breakpoint breakpoint)
	{
		chartStyle = breakpoint == Breakpoint.Xs ? chartStyleForXs : chartStyleForSmAndUp;
	}
}
