@page "/"

@inject NavigationManager NavManager
@inject JSExtensionsService JS
@inject AppBarOptions AppBar


<PageTitle>About</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="pa-2">
	<MudStack Wrap="Wrap.Wrap">

		<MudText Typo="Typo.h4">@greetings</MudText>

		<MudText>
			This portfolio web app is built with ASP.NET Core and Blazor Server, demonstrating my experience with .NET development, 
			real-time features, and modern web application design. Use the navigation menu on the left to explore various projects and tools — the 
			<MudTooltip Arrow Color="Color.Transparent" Delay="60">
				<ChildContent>
					<MudLink Href="/mortgage">Mortgage Calculator</MudLink>
				</ChildContent>
				<TooltipContent>
					<MudImage Src="images/mortgage.png" Class="rounded-lg" />
				</TooltipContent>
			</MudTooltip>
			is a great place to start.
		</MudText>

		<MudText>
			Tech stack used:
		</MudText>

		<MudText>
			<ul class="pl-3">
				<li>.NET Core 10</li>
				<li>Blazor w/ MudBlazor component library</li>
			</ul>
		</MudText>

		<MudText>
			Source code is available on GitHub and can be accessed via the links menu at the top.
		</MudText>
		<MudDivider Class="mt-2" />
		<MudText>
			Copyright &copy; 2026 Alexandre Voitsekh
		</MudText>

	</MudStack>
</MudContainer>
