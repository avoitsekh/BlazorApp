@inherits LayoutComponentBase

<MudThemeProvider @ref="_mudThemeProvider" Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged" />

<MudLayout>
	<MudAppBar Dense Elevation="2">
		@if (_showMenuButton)
		{
			<MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
		}
		else
		{
			<MudIcon Icon="@blazorIcon" Size="Size.Medium" Class="me-3" />
		}
		<MudText Typo="Typo.h5" Class="ml-1">Blazor Portfolio App</MudText>
		<MudSpacer />
		<MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle" />
		<MudFabMenu StartIcon="@Icons.Material.Outlined.Link" Color="Color.Default" DropShadow="false" Direction="Direction.Bottom" DampenItemsBackgroundColor="false" Size="Size.Small" OpenOnMouseHover="true" ButtonClass="fab-button-links">
			<MudFabMenuItem EndIcon="@Icons.Custom.Brands.LinkedIn" Color="Color.Info" Href="https://www.linkedin.com/in/voitsekh" Target="_blank" Size="Size.Small" />
			<MudFabMenuItem EndIcon="@Icons.Custom.Brands.GitHub" Color="Color.Success" Href="https://github.com/avoitsekh/BlazorApp" Target="_blank" Size="Size.Small" />
			<MudFabMenuItem EndIcon="@Icons.Material.Outlined.Email" Color="Color.Warning" Href="mailto:voitsekh@hotmail.com" Size="Size.Small" />
		</MudFabMenu>
	</MudAppBar>
	<MudDrawer id="nav-drawer" @bind-Open="@_drawerOpen" ClipMode="@_drawerClipMode" Elevation="1" Variant="DrawerVariant.Mini" OpenMiniOnHover="true" Breakpoint="Breakpoint.Sm">
		<NavMenu MenuColor="@_navMenuColor" />
	</MudDrawer>
	<MudMainContent Class="pt-12 pa-4">
		<CascadingValue Value="@_isDarkMode" Name="&IsDarkMode">
			@Body
		</CascadingValue>
	</MudMainContent>
</MudLayout>


<div id="blazor-error-ui" data-nosnippet>
	An unhandled error has occurred.
	<a href="." class="reload">Reload</a>
	<span class="dismiss">🗙</span>
</div>

<style>
	.fab-button-links {
		background-color: transparent;
	}

	.fab-button-links:hover {
		background-color: var(--mud-palette-action-default-hover);
	}

	.mud-appbar {
		background: rgba(255, 255, 255, 0);
		background-image: linear-gradient( 109.6deg, #7575751a 11%, #ffffff08 91% );
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);

		/* background: rgba(255, 255, 255, 0);
		background-image: linear-gradient( 109.6deg, rgba(0,182,255,.1) 11.2%, rgba(102,51,153,.1) 91.1% );
		backdrop-filter: blur(8px); */
	}
</style>

@code {

	DrawerVariant variant = DrawerVariant.Mini;

	bool _drawerOpen = false;
	bool _isDarkMode = true;
	bool _showMenuButton = false;
	bool _isDarkModeSystemPreference = false;

	MudTheme? _theme = null;
	MudThemeProvider? _mudThemeProvider = null;

	DrawerClipMode _drawerClipMode = DrawerClipMode.Docked;
	Color _navMenuColor => _isDarkMode ? Color.Tertiary : Color.Info;


	protected override void OnInitialized()
	{
		base.OnInitialized();

		_theme = new()
		{
			PaletteLight = _lightPalette,
			PaletteDark = _darkPalette,
			LayoutProperties = new LayoutProperties()
		};
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			_isDarkMode = _isDarkModeSystemPreference = await _mudThemeProvider.GetSystemDarkModeAsync();
			StateHasChanged();
		}
	}

	void DrawerClose()
	{
		if (_drawerOpen)
		{
			_drawerOpen = false;
		}
	}

	void DrawerToggle()
	{
		_drawerOpen = !_drawerOpen;
	}

	void DarkModeToggle()
	{
		_isDarkMode = !_isDarkMode;
	}

	readonly PaletteLight _lightPalette = new()
	{
		Background = "#fafafa",
		Black = "#110e2d",
		AppbarText = "#424242",
		AppbarBackground = "rgba(255,255,255,0.8)",
		DrawerBackground = "#ffffff",
		GrayLight = "#e8e8e8",
		GrayLighter = "#f9f9f9",
		ActionDefault = "#424242",
	};

	readonly PaletteDark _darkPalette = new()
	{
		Primary = "#7e6fff",
		Surface = "#1e1e2d",
		Background = "#1a1a27",
		BackgroundGray = "#151521",
		AppbarText = "#92929f",
		AppbarBackground = "rgba(26,26,39,0.8)",
		DrawerBackground = "#1a1a27",
		// ActionDefault = "#74718e",
		ActionDefault = "#b2b0bfff",
		ActionDisabled = "#9999994d",
		ActionDisabledBackground = "#605f6d4d",
		TextPrimary = "#b2b0bf",
		TextSecondary = "#92929f",
		TextDisabled = "#ffffff33",
		DrawerIcon = "#92929f",
		DrawerText = "#92929f",
		GrayLight = "#2a2833",
		GrayLighter = "#1e1e2d",
		Info = "#4a86ff",
		Success = "#3dcb6c",
		Warning = "#ffb545",
		Error = "#ff3f5f",
		LinesDefault = "#33323e",
		TableLines = "#33323e",
		Divider = "#292838",
		OverlayLight = "#1e1e2d80",
		Dark = "#22222e",
		DarkDarken = "#232332",
	};

	string DarkLightModeButtonIcon
	{
		get
		{
			if (_isDarkModeSystemPreference)
			{
				return _isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Rounded.AutoMode;
			}
			else
			{
				return _isDarkMode ? Icons.Material.Rounded.AutoMode : Icons.Material.Outlined.DarkMode;
			}
		}
	}

	void OnBreakpointChanged(Breakpoint breakpoint)
	{
		_showMenuButton = breakpoint == Breakpoint.Sm || breakpoint == Breakpoint.Xs;
		_drawerClipMode = breakpoint == Breakpoint.Xs ? DrawerClipMode.Never : DrawerClipMode.Docked;
		DrawerClose();
	}

	string blazorIcon = @"
